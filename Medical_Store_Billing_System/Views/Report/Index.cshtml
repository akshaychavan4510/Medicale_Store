@* Views/Report/Index.cshtml *@
@{
    ViewData["Title"] = "Reports";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.5">
    <title>@ViewData["Title"]</title>
    <!-- Bootstrap 5 + Icons + Google Font -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@@14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet">
    <style>
            /* ── Reset & Base ── */
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
                background: linear-gradient(145deg, #f0f5fc 0%, #e3eaf5 100%);
                min-height: 100vh;
                padding: 1.5rem;
                margin: 0;
            }

            /* ── Main Container ── */
            .page-wrapper {
                max-width: 1200px;
                margin: 0 auto;
                animation: fadeSlideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1);
            }

            @@keyframes fadeSlideUp {
                0% {
                    opacity: 0;
                    transform: translateY(30px) scale(0.97);
                }

                100% {
                    opacity: 1;
                    transform: translateY(0) scale(1);
                }
            }

            /* ── Header ── */
            .header-icon {
                background: #e3f2fd;
                padding: 0.6rem;
                border-radius: 14px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
            }

                .header-icon i {
                    font-size: 1.6rem;
                    color: #0d47a1;
                }

            /* ── Report Cards ── */
            .report-card {
                background: #ffffff;
                border: none;
                border-radius: 24px;
                box-shadow: 0 20px 60px rgba(0, 0, 0, 0.06), 0 8px 28px rgba(0, 0, 0, 0.03), 0 0 0 1px rgba(0, 0, 0, 0.02);
                transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
                height: 100%;
                overflow: hidden;
                position: relative;
            }

                .report-card::before {
                    content: '';
                    position: absolute;
                    top: 0;
                    left: 0;
                    right: 0;
                    height: 4px;
                    background: linear-gradient(90deg, #0d47a1, #42a5f5);
                    opacity: 0;
                    transition: opacity 0.3s ease;
                }

                .report-card:hover {
                    box-shadow: 0 32px 80px rgba(0, 0, 0, 0.10), 0 12px 36px rgba(0, 0, 0, 0.06), 0 0 0 1px rgba(0, 0, 0, 0.02);
                    transform: translateY(-6px);
                }

                    .report-card:hover::before {
                        opacity: 1;
                    }

                /* Color-specific card accents */
                .report-card.success::before {
                    background: linear-gradient(90deg, #15803d, #4ade80);
                }

                .report-card.primary::before {
                    background: linear-gradient(90deg, #0d47a1, #42a5f5);
                }

                .report-card.info::before {
                    background: linear-gradient(90deg, #0891b2, #22d3ee);
                }

                .report-card.warning::before {
                    background: linear-gradient(90deg, #d97706, #fbbf24);
                }

                .report-card.secondary::before {
                    background: linear-gradient(90deg, #4b5563, #9ca3af);
                }

            .report-card-body {
                padding: 2rem 1.5rem;
                text-align: center;
            }

            /* ── Icon containers ── */
            .icon-wrapper {
                width: 72px;
                height: 72px;
                border-radius: 50%;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                margin-bottom: 1rem;
                transition: transform 0.3s ease;
            }

            .report-card:hover .icon-wrapper {
                transform: scale(1.08) rotate(-5deg);
            }

            .icon-wrapper.success {
                background: #dcfce7;
                color: #15803d;
            }

            .icon-wrapper.primary {
                background: #e3f2fd;
                color: #0d47a1;
            }

            .icon-wrapper.info {
                background: #cffafe;
                color: #0891b2;
            }

            .icon-wrapper.warning {
                background: #fef3c7;
                color: #d97706;
            }

            .icon-wrapper.secondary {
                background: #f3f4f6;
                color: #4b5563;
            }

            .icon-wrapper i {
                font-size: 2.2rem;
            }

            /* ── Card content ── */
            .report-card h5 {
                font-weight: 700;
                font-size: 1.1rem;
                color: #0b2a4a;
                margin-bottom: 0.5rem;
            }

            .report-card p {
                font-size: 0.85rem;
                color: #6b7f94;
                margin-bottom: 1.5rem;
                line-height: 1.5;
            }

            /* ── Buttons ── */
            .btn-report {
                border-radius: 60px;
                padding: 0.6rem 1.5rem;
                font-weight: 600;
                font-size: 0.9rem;
                transition: all 0.3s ease;
                border: none;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 0.5rem;
                width: 100%;
            }

                .btn-report:hover {
                    transform: translateX(4px);
                }

            .btn-report-success {
                background: #15803d;
                color: #ffffff;
                box-shadow: 0 4px 12px rgba(21, 128, 61, 0.30);
            }

                .btn-report-success:hover {
                    background: #166534;
                    box-shadow: 0 8px 20px rgba(21, 128, 61, 0.40);
                    color: #ffffff;
                }

            .btn-report-primary {
                background: #0d47a1;
                color: #ffffff;
                box-shadow: 0 4px 12px rgba(13, 71, 161, 0.30);
            }

                .btn-report-primary:hover {
                    background: #0a3a8a;
                    box-shadow: 0 8px 20px rgba(13, 71, 161, 0.40);
                    color: #ffffff;
                }

            .btn-report-info {
                background: #0891b2;
                color: #ffffff;
                box-shadow: 0 4px 12px rgba(8, 145, 178, 0.30);
            }

                .btn-report-info:hover {
                    background: #0e7490;
                    box-shadow: 0 8px 20px rgba(8, 145, 178, 0.40);
                    color: #ffffff;
                }

            .btn-report-warning {
                background: #d97706;
                color: #ffffff;
                box-shadow: 0 4px 12px rgba(217, 119, 6, 0.30);
            }

                .btn-report-warning:hover {
                    background: #b45309;
                    box-shadow: 0 8px 20px rgba(217, 119, 6, 0.40);
                    color: #ffffff;
                }

            .btn-report-secondary {
                background: #4b5563;
                color: #ffffff;
                box-shadow: 0 4px 12px rgba(75, 85, 99, 0.30);
            }

                .btn-report-secondary:hover {
                    background: #374151;
                    box-shadow: 0 8px 20px rgba(75, 85, 99, 0.40);
                    color: #ffffff;
                }

            .btn-report i {
                font-size: 1.1rem;
            }

            /* ── Responsive ── */
            @@media (max-width: 768px) {
                body {
                    padding: 1rem;
                }

                .report-card-body {
                    padding: 1.5rem 1rem;
                }

                .icon-wrapper {
                    width: 60px;
                    height: 60px;
                }

                    .icon-wrapper i {
                        font-size: 1.8rem;
                    }

                .report-card h5 {
                    font-size: 1rem;
                }

                .report-card p {
                    font-size: 0.8rem;
                }

                .btn-report {
                    font-size: 0.85rem;
                    padding: 0.5rem 1.2rem;
                }

                .header-icon i {
                    font-size: 1.2rem;
                }

                h5 {
                    font-size: 1.1rem;
                }
            }

            @@media (max-width: 576px) {
                .report-card-body {
                    padding: 1.2rem 0.8rem;
                }

                .icon-wrapper {
                    width: 50px;
                    height: 50px;
                }

                    .icon-wrapper i {
                        font-size: 1.5rem;
                    }

                .row.g-4 {
                    gap: 1rem;
                }
            }

            /* ── Reduced Motion ── */
            @@media (prefers-reduced-motion: reduce) {
                * {
                    animation-duration: 0.01ms !important;
                    transition-duration: 0.01ms !important;
                }
            }

            /* ── Custom Scroll ── */
            ::-webkit-scrollbar {
                width: 6px;
                height: 6px;
            }

            ::-webkit-scrollbar-track {
                background: #f1f5f9;
                border-radius: 10px;
            }

            ::-webkit-scrollbar-thumb {
                background: #d1dbe8;
                border-radius: 10px;
            }

                ::-webkit-scrollbar-thumb:hover {
                    background: #b8c6d6;
                }
    </style>
</head>
<body>

    <div class="page-wrapper">

        <!-- ── Header ── -->
        <div class="d-flex align-items-center gap-3 mb-4">
            <div class="header-icon">
                <i class="bi bi-bar-chart-line"></i>
            </div>
            <div>
                <h5 class="mb-0 fw-bold">Reports</h5>
                <small class="text-muted">View analytics and insights</small>
            </div>
        </div>

        <!-- ── Report Cards Grid ── -->
        <div class="row g-4">

            <!-- Daily Sale Report -->
            <div class="col-md-6 col-lg-4">
                <div class="report-card success">
                    <div class="report-card-body">
                        <div class="icon-wrapper success">
                            <i class="bi bi-bar-chart"></i>
                        </div>
                        <h5>Daily Sale Report</h5>
                        <p>View sales by date range. See invoice-wise customer totals and item counts.</p>
                        <a asp-action="DailySale" class="btn-report btn-report-success">
                            <i class="bi bi-arrow-right-circle"></i> View Report
                        </a>
                    </div>
                </div>
            </div>

            <!-- Purchase Report -->
            <div class="col-md-6 col-lg-4">
                <div class="report-card primary">
                    <div class="report-card-body">
                        <div class="icon-wrapper primary">
                            <i class="bi bi-graph-up"></i>
                        </div>
                        <h5>Purchase Report</h5>
                        <p>View purchases by date range. See supplier-wise purchase totals and item counts.</p>
                        <a asp-action="PurchaseReport" class="btn-report btn-report-primary">
                            <i class="bi bi-arrow-right-circle"></i> View Report
                        </a>
                    </div>
                </div>
            </div>

            <!-- Stock Report -->
            <div class="col-md-6 col-lg-4">
                <div class="report-card info">
                    <div class="report-card-body">
                        <div class="icon-wrapper info">
                            <i class="bi bi-clipboard-data"></i>
                        </div>
                        <h5>Stock Report</h5>
                        <p>Current stock levels for all medicines. Highlights low stock and out-of-stock items.</p>
                        <a asp-action="StockReport" class="btn-report btn-report-info">
                            <i class="bi bi-arrow-right-circle"></i> View Report
                        </a>
                    </div>
                </div>
            </div>

            <!-- Customer Ledger -->
            <div class="col-md-6 col-lg-4">
                <div class="report-card warning">
                    <div class="report-card-body">
                        <div class="icon-wrapper warning">
                            <i class="bi bi-person-lines-fill"></i>
                        </div>
                        <h5>Customer Ledger</h5>
                        <p>Track sales and receipts for a customer. View running balance and closing balance.</p>
                        <a asp-action="CustomerLedger" class="btn-report btn-report-warning">
                            <i class="bi bi-arrow-right-circle"></i> View Ledger
                        </a>
                    </div>
                </div>
            </div>

            <!-- Supplier Ledger -->
            <div class="col-md-6 col-lg-4">
                <div class="report-card secondary">
                    <div class="report-card-body">
                        <div class="icon-wrapper secondary">
                            <i class="bi bi-journal-text"></i>
                        </div>
                        <h5>Supplier Ledger</h5>
                        <p>Track purchases and payments for a supplier. View outstanding payable balance.</p>
                        <a asp-action="SupplierLedger" class="btn-report btn-report-secondary">
                            <i class="bi bi-arrow-right-circle"></i> View Ledger
                        </a>
                    </div>
                </div>
            </div>

        </div>

       

    </div>

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

</body>
</html>