@model MedicalStore.Business.ViewModels.CustomerLedgerVM
@{
    ViewData["Title"] = "Customer Ledger";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.5">
    <title>@ViewData["Title"]</title>
    <!-- Bootstrap 5 + Icons + Google Font -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@@14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet">
    <style>
            /* ── Reset & Base ── */
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
                background: linear-gradient(145deg, #fffbeb 0%, #fef3c7 100%);
                min-height: 100vh;
                padding: 1.5rem;
                margin: 0;
            }

            /* ── Main Container ── */
            .page-wrapper {
                max-width: 1200px;
                margin: 0 auto;
                animation: fadeSlideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1);
            }

            @@keyframes fadeSlideUp {
                0% {
                    opacity: 0;
                    transform: translateY(30px) scale(0.97);
                }

                100% {
                    opacity: 1;
                    transform: translateY(0) scale(1);
                }
            }

            /* ── Card ── */
            .ledger-card {
                background: #ffffff;
                border: none;
                border-radius: 24px;
                box-shadow: 0 20px 60px rgba(0, 0, 0, 0.06), 0 8px 28px rgba(0, 0, 0, 0.03), 0 0 0 1px rgba(0, 0, 0, 0.02);
                transition: box-shadow 0.3s ease, transform 0.2s ease;
                overflow: hidden;
            }

                .ledger-card:hover {
                    box-shadow: 0 32px 80px rgba(0, 0, 0, 0.08), 0 12px 36px rgba(0, 0, 0, 0.04), 0 0 0 1px rgba(0, 0, 0, 0.02);
                    transform: translateY(-2px);
                }

            /* ── Card Header ── */
            .card-header-custom {
                background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%);
                border-bottom: 2px solid rgba(217, 119, 6, 0.15);
                padding: 1.35rem 2rem;
                border-radius: 24px 24px 0 0 !important;
                position: relative;
            }

                .card-header-custom::after {
                    content: '';
                    position: absolute;
                    bottom: 0;
                    left: 2rem;
                    right: 2rem;
                    height: 3px;
                    background: linear-gradient(90deg, #d97706, #fbbf24);
                    border-radius: 3px;
                }

                .card-header-custom h5 {
                    font-weight: 700;
                    font-size: 1.3rem;
                    letter-spacing: -0.02em;
                    color: #78350f;
                    display: flex;
                    align-items: center;
                    gap: 0.6rem;
                    margin: 0;
                }

                    .card-header-custom h5 i {
                        color: #d97706;
                        font-size: 1.6rem;
                        filter: drop-shadow(0 2px 6px rgba(217, 119, 6, 0.30));
                    }

            .record-count-badge {
                background: #ffffff;
                padding: 0.2rem 0.9rem;
                border-radius: 60px;
                font-size: 0.75rem;
                font-weight: 600;
                color: #78350f;
                border: 1px solid #fbbf24;
                box-shadow: 0 2px 8px rgba(217, 119, 6, 0.10);
                display: inline-flex;
                align-items: center;
                gap: 0.4rem;
            }

            /* ── Card Body ── */
            .card-body-custom {
                padding: 2rem;
            }

            /* ── Filter Form ── */
            .filter-form {
                background: #f8fafc;
                border-radius: 16px;
                padding: 1.2rem 1.5rem;
                margin-bottom: 1.5rem;
                border: 1px solid #e8edf5;
            }

                .filter-form .form-label {
                    font-weight: 600;
                    font-size: 0.8rem;
                    color: #1f3a5f;
                    margin-bottom: 0.3rem;
                }

                .filter-form .form-control,
                .filter-form .form-select {
                    border: 1px solid #e2e9f3;
                    border-radius: 12px;
                    padding: 0.6rem 1rem;
                    font-size: 0.9rem;
                    background: #ffffff;
                    transition: border 0.2s, box-shadow 0.2s;
                }

                    .filter-form .form-control:focus,
                    .filter-form .form-select:focus {
                        border-color: #d97706;
                        box-shadow: 0 0 0 4px rgba(217, 119, 6, 0.12);
                    }

            .btn-search {
                background: #d97706;
                border: none;
                border-radius: 12px;
                padding: 0.6rem 1.8rem;
                font-weight: 600;
                font-size: 0.9rem;
                color: #ffffff;
                transition: all 0.25s ease;
                box-shadow: 0 4px 12px rgba(217, 119, 6, 0.25);
                display: inline-flex;
                align-items: center;
                gap: 0.4rem;
            }

                .btn-search:hover {
                    background: #b45309;
                    transform: translateY(-2px);
                    box-shadow: 0 8px 20px rgba(217, 119, 6, 0.30);
                    color: #ffffff;
                }

                .btn-search i {
                    font-size: 1.1rem;
                }

            /* ── Customer Name Header ── */
            .customer-name-header {
                background: #fef3c7;
                border-radius: 12px;
                padding: 0.6rem 1.2rem;
                margin-bottom: 1.2rem;
                border-left: 4px solid #d97706;
            }

                .customer-name-header strong {
                    color: #78350f;
                }

            /* ── Table ── */
            .table-wrapper {
                overflow-x: auto;
                -webkit-overflow-scrolling: touch;
            }

            .table-custom {
                width: 100%;
                min-width: 700px;
                font-size: 0.9rem;
                border-collapse: separate;
                border-spacing: 0;
                margin-bottom: 0;
            }

                .table-custom thead th {
                    background: #f8faff;
                    border-bottom: 2px solid #e2e8f0;
                    font-weight: 600;
                    font-size: 0.75rem;
                    text-transform: uppercase;
                    letter-spacing: 0.04em;
                    color: #4a5d7a;
                    padding: 0.75rem 0.75rem;
                    white-space: nowrap;
                    position: sticky;
                    top: 0;
                    z-index: 5;
                }

                .table-custom tbody td {
                    padding: 0.7rem 0.75rem;
                    vertical-align: middle;
                    border-bottom: 1px solid #f0f3f9;
                }

                .table-custom tbody tr {
                    background: #ffffff;
                    transition: background 0.15s;
                }

                    .table-custom tbody tr:hover {
                        background: #fffbeb;
                    }

                .table-custom tfoot td {
                    padding: 0.7rem 0.75rem;
                    border-top: 2px solid #e2e8f0;
                    font-weight: 600;
                    background: #fef3c7;
                }

            /* ── Badge Styles ── */
            .badge-type {
                padding: 0.25rem 0.8rem;
                border-radius: 40px;
                font-size: 0.75rem;
                font-weight: 600;
            }

                .badge-type.sale {
                    background: #fee2e2;
                    color: #dc2626;
                }

                .badge-type.receipt {
                    background: #dcfce7;
                    color: #15803d;
                }

            .text-debit {
                color: #dc2626;
                font-weight: 600;
            }

            .text-credit {
                color: #15803d;
                font-weight: 600;
            }

            .text-balance-debit {
                color: #dc2626;
                font-weight: 700;
            }

            .text-balance-credit {
                color: #15803d;
                font-weight: 700;
            }

            /* ── Empty State ── */
            .empty-state {
                color: #9aabbe;
                padding: 2.5rem 0;
            }

                .empty-state i {
                    font-size: 3rem;
                    display: block;
                    margin-bottom: 0.5rem;
                    opacity: 0.6;
                }

            /* ── Alert Info ── */
            .alert-info-custom {
                border-radius: 16px;
                border: none;
                padding: 1rem 1.2rem;
                background: #eff6ff;
                color: #1e3a5f;
                display: flex;
                align-items: center;
                gap: 0.8rem;
            }

                .alert-info-custom i {
                    color: #2563eb;
                    font-size: 1.4rem;
                }

            /* ── Print Button ── */
            .btn-print {
                background: #eef2f7;
                border: 1px solid #d6dfea;
                border-radius: 60px;
                padding: 0.4rem 1.2rem;
                font-weight: 600;
                font-size: 0.85rem;
                color: #1f3a5f;
                transition: all 0.2s ease;
                display: inline-flex;
                align-items: center;
                gap: 0.4rem;
            }

                .btn-print:hover {
                    background: #e2eaf5;
                    border-color: #bcc9da;
                    transform: scale(1.03);
                    color: #0b2a4a;
                }

            /* ── Footer Info ── */
            .footer-info {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-top: 1rem;
            }

            /* ── Responsive ── */
            @@media (max-width: 768px) {
                body {
                    padding: 1rem;
                }

                .card-body-custom {
                    padding: 1.2rem;
                }

                .card-header-custom {
                    padding: 1rem 1.2rem;
                }

                    .card-header-custom h5 {
                        font-size: 1.1rem;
                    }

                        .card-header-custom h5 i {
                            font-size: 1.3rem;
                        }

                .record-count-badge {
                    font-size: 0.65rem;
                    padding: 0.15rem 0.6rem;
                }

                .filter-form {
                    padding: 1rem;
                }

                    .filter-form .row {
                        gap: 0.5rem;
                    }

                    .filter-form .col-md-3,
                    .filter-form .col-auto {
                        width: 100%;
                    }

                    .filter-form .form-control,
                    .filter-form .form-select {
                        width: 100%;
                    }

                .btn-search {
                    width: 100%;
                    justify-content: center;
                }

                .table-custom {
                    min-width: 550px;
                    font-size: 0.8rem;
                }

                    .table-custom thead th {
                        font-size: 0.65rem;
                        padding: 0.5rem 0.4rem;
                    }

                    .table-custom tbody td {
                        padding: 0.4rem 0.4rem;
                    }

                    .table-custom tfoot td {
                        padding: 0.4rem 0.4rem;
                        font-size: 0.8rem;
                    }

                .footer-info {
                    flex-direction: column;
                    gap: 0.5rem;
                    align-items: flex-start;
                }

                .btn-print {
                    font-size: 0.8rem;
                    padding: 0.3rem 1rem;
                }

                .customer-name-header {
                    font-size: 0.9rem;
                    padding: 0.4rem 1rem;
                }
            }

            @@media (max-width: 576px) {
                .table-custom {
                    min-width: 450px;
                    font-size: 0.7rem;
                }

                    .table-custom thead th {
                        padding: 0.3rem 0.2rem;
                        font-size: 0.6rem;
                    }

                    .table-custom tbody td {
                        padding: 0.3rem 0.2rem;
                    }

                    .table-custom tfoot td {
                        padding: 0.3rem 0.2rem;
                        font-size: 0.7rem;
                    }

                .btn-print {
                    font-size: 0.75rem;
                    padding: 0.3rem 0.8rem;
                }

                .badge-type {
                    font-size: 0.65rem;
                    padding: 0.15rem 0.5rem;
                }

                .record-count-badge {
                    font-size: 0.6rem;
                    padding: 0.1rem 0.5rem;
                }
            }

            /* ── Print Styles ── */
            @@media print {
                .no-print {
                    display: none !important;
                }

                body {
                    background: white !important;
                    padding: 0.5in !important;
                }

                .ledger-card {
                    box-shadow: none !important;
                    border: 1px solid #ddd !important;
                    border-radius: 8px !important;
                }

                .card-header-custom {
                    background: #fffbeb !important;
                    border-bottom: 2px solid #d97706 !important;
                }

                    .card-header-custom::after {
                        display: none !important;
                    }

                .filter-form {
                    background: #f8fafc !important;
                    border: 1px solid #e2e8f0 !important;
                }

                .table-custom thead th {
                    background: #f1f5f9 !important;
                    border-bottom: 2px solid #d1d5db !important;
                    color: #111827 !important;
                }

                .table-custom tfoot td {
                    background: #fef3c7 !important;
                    border-top: 2px solid #d97706 !important;
                }

                .btn-search {
                    background: #d97706 !important;
                    color: white !important;
                }

                .ledger-card:hover {
                    transform: none !important;
                    box-shadow: none !important;
                }
            }

            /* ── Reduced Motion ── */
            @@media (prefers-reduced-motion: reduce) {
                * {
                    animation-duration: 0.01ms !important;
                    transition-duration: 0.01ms !important;
                }
            }

            /* Custom Scrollbar for table */
            .table-wrapper::-webkit-scrollbar {
                height: 6px;
            }

            .table-wrapper::-webkit-scrollbar-track {
                background: #f1f5f9;
                border-radius: 10px;
            }

            .table-wrapper::-webkit-scrollbar-thumb {
                background: #d1dbe8;
                border-radius: 10px;
            }

                .table-wrapper::-webkit-scrollbar-thumb:hover {
                    background: #b8c6d6;
                }

            /* Table row animation */
            .table-custom tbody tr {
                animation: fadeInRow 0.3s ease forwards;
                opacity: 0;
            }

                .table-custom tbody tr:nth-child(1) {
                    animation-delay: 0.05s;
                }

                .table-custom tbody tr:nth-child(2) {
                    animation-delay: 0.08s;
                }

                .table-custom tbody tr:nth-child(3) {
                    animation-delay: 0.11s;
                }

                .table-custom tbody tr:nth-child(4) {
                    animation-delay: 0.14s;
                }

                .table-custom tbody tr:nth-child(5) {
                    animation-delay: 0.17s;
                }

                .table-custom tbody tr:nth-child(6) {
                    animation-delay: 0.20s;
                }

                .table-custom tbody tr:nth-child(7) {
                    animation-delay: 0.23s;
                }

                .table-custom tbody tr:nth-child(8) {
                    animation-delay: 0.26s;
                }

                .table-custom tbody tr:nth-child(9) {
                    animation-delay: 0.29s;
                }

                .table-custom tbody tr:nth-child(10) {
                    animation-delay: 0.32s;
                }

            @@keyframes fadeInRow {
                from {
                    opacity: 0;
                    transform: translateX(-10px);
                }

                to {
                    opacity: 1;
                    transform: translateX(0);
                }
            }
    </style>
</head>
<body>

    <div class="page-wrapper">

        <!-- ── Ledger Card ── -->
        <div class="ledger-card">
            <!-- Card Header -->
            <div class="card-header-custom">
                <h5>
                    <i class="bi bi-person-lines-fill"></i>
                    <span>Customer Ledger</span>
                    <div class="ms-auto d-flex align-items-center gap-2">
                        @if (Model != null && ViewBag.CustId != null)
                        {
                            <span class="record-count-badge">
                                <i class="bi bi-database me-1"></i>
                                @Model.Entries.Count() transaction(s)
                            </span>
                        }
                        <button class="btn-print no-print" onclick="printReport('Customer Ledger')">
                            <i class="bi bi-printer"></i> Print
                        </button>
                    </div>
                </h5>
            </div>

            <!-- Card Body -->
            <div class="card-body-custom">
                <!-- Filter Form -->
                <div class="filter-form no-print">
                    <form method="get" class="row g-3 align-items-end">
                        <div class="col-md-4">
                            <label class="form-label"><i class="bi bi-person me-1"></i>Customer</label>
                            <select name="custId" class="form-select" asp-items="ViewBag.Customers">
                                <option value="">-- Select Customer --</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label"><i class="bi bi-calendar3 me-1"></i>From Date</label>
                            <input type="date" name="from" class="form-control"
                                   value="@(ViewBag.From ?? DateTime.Today.ToString("yyyy-MM-dd"))" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label"><i class="bi bi-calendar3 me-1"></i>To Date</label>
                            <input type="date" name="to" class="form-control"
                                   value="@(ViewBag.To ?? DateTime.Today.ToString("yyyy-MM-dd"))" />
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn-search w-100">
                                <i class="bi bi-search"></i> Search
                            </button>
                        </div>
                    </form>
                </div>

                <!-- Customer Name Header -->
                @if (Model != null && ViewBag.CustId != null && !string.IsNullOrEmpty(Model.CustomerName))
                {
                    <div class="customer-name-header">
                        <i class="bi bi-person me-2"></i>
                        Ledger for: <strong>@Model.CustomerName</strong>
                    </div>
                }

                <!-- Table -->
                @if (Model != null && ViewBag.CustId != null)
                {
                    <div class="table-wrapper">
                        <table class="table-custom">
                            <thead>
                                <tr>
                                    <th><i class="bi bi-calendar3 me-1"></i>Date</th>
                                    <th><i class="bi bi-file-text me-1"></i>Particulars</th>
                                    <th><i class="bi bi-tag me-1"></i>Type</th>
                                    <th class="text-end"><i class="bi bi-arrow-up me-1"></i>Debit (₹)</th>
                                    <th class="text-end"><i class="bi bi-arrow-down me-1"></i>Credit (₹)</th>
                                    <th class="text-end"><i class="bi bi-scale me-1"></i>Balance (₹)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.Entries.Any())
                                {
                                    <tr>
                                        <td colspan="6" class="text-center empty-state">
                                            <i class="bi bi-inbox"></i>
                                            No transactions found for this customer.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var row in Model.Entries)
                                    {
                                        <tr>
                                            <td>@row.Date.ToString("dd-MM-yyyy")</td>
                                            <td>@row.Particulars</td>
                                            <td>
                                                <span class="badge-type @(row.Type == "Sale" ? "sale" : "receipt")">
                                                    @row.Type
                                                </span>
                                            </td>
                                            <td class="text-end @(row.Debit > 0 ? "text-debit" : "")">
                                                @(row.Debit > 0 ? "₹" + row.Debit.ToString("N2") : "-")
                                            </td>
                                            <td class="text-end @(row.Credit > 0 ? "text-credit" : "")">
                                                @(row.Credit > 0 ? "₹" + row.Credit.ToString("N2") : "-")
                                            </td>
                                            <td class="text-end @(row.Balance > 0 ? "text-balance-debit" : "text-balance-credit")">
                                                ₹@row.Balance.ToString("N2")
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                            @if (Model.Entries.Any())
                            {
                                <tfoot>
                                    <tr>
                                        <td colspan="3" class="text-end">Totals</td>
                                        <td class="text-end text-debit">
                                            ₹@Model.Entries.Sum(r => r.Debit).ToString("N2")
                                        </td>
                                        <td class="text-end text-credit">
                                            ₹@Model.Entries.Sum(r => r.Credit).ToString("N2")
                                        </td>
                                        <td class="text-end @(Model.ClosingBalance > 0 ? "text-balance-debit" : "text-balance-credit")">
                                            ₹@Model.ClosingBalance.ToString("N2")
                                        </td>
                                    </tr>
                                </tfoot>
                            }
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert-info-custom">
                        <i class="bi bi-info-circle-fill"></i>
                        <span>Please select a customer and date range to view the ledger.</span>
                    </div>
                }
            </div>
        </div>

        <!-- ── Footer Info ── -->
        <div class="footer-info">
            <small class="text-muted">
                <i class="bi bi-clock me-1"></i>
                Generated: @DateTime.Now.ToString("dd MMM yyyy, hh:mm tt")
            </small>
        </div>

    </div>

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

    <script>
            function printReport(title) {
                window.print();
            }
    </script>

</body>
</html>