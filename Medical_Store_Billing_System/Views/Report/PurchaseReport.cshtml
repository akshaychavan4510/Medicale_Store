@model IEnumerable<MedicalStore.Business.ViewModels.PurchaseReportVM>
@{
    ViewData["Title"] = "Purchase Report";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.5">
    <title>@ViewData["Title"]</title>
    <!-- Bootstrap 5 + Icons + Google Font -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@@14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet">
    <style>
            /* ── Reset & Base ── */
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
                background: linear-gradient(145deg, #eff6ff 0%, #dbeafe 100%);
                min-height: 100vh;
                padding: 1.5rem;
                margin: 0;
            }

            /* ── Main Container ── */
            .page-wrapper {
                max-width: 1200px;
                margin: 0 auto;
                animation: fadeSlideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1);
            }

            @@keyframes fadeSlideUp {
                0% {
                    opacity: 0;
                    transform: translateY(30px) scale(0.97);
                }

                100% {
                    opacity: 1;
                    transform: translateY(0) scale(1);
                }
            }

            /* ── Card ── */
            .report-card {
                background: #ffffff;
                border: none;
                border-radius: 24px;
                box-shadow: 0 20px 60px rgba(0, 0, 0, 0.06), 0 8px 28px rgba(0, 0, 0, 0.03), 0 0 0 1px rgba(0, 0, 0, 0.02);
                transition: box-shadow 0.3s ease, transform 0.2s ease;
                overflow: hidden;
            }

                .report-card:hover {
                    box-shadow: 0 32px 80px rgba(0, 0, 0, 0.08), 0 12px 36px rgba(0, 0, 0, 0.04), 0 0 0 1px rgba(0, 0, 0, 0.02);
                    transform: translateY(-2px);
                }

            /* ── Card Header ── */
            .card-header-custom {
                background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);
                border-bottom: 2px solid rgba(37, 99, 235, 0.15);
                padding: 1.35rem 2rem;
                border-radius: 24px 24px 0 0 !important;
                position: relative;
            }

                .card-header-custom::after {
                    content: '';
                    position: absolute;
                    bottom: 0;
                    left: 2rem;
                    right: 2rem;
                    height: 3px;
                    background: linear-gradient(90deg, #2563eb, #60a5fa);
                    border-radius: 3px;
                }

                .card-header-custom h5 {
                    font-weight: 700;
                    font-size: 1.3rem;
                    letter-spacing: -0.02em;
                    color: #1e3a5f;
                    display: flex;
                    align-items: center;
                    gap: 0.6rem;
                    margin: 0;
                }

                    .card-header-custom h5 i {
                        color: #2563eb;
                        font-size: 1.6rem;
                        filter: drop-shadow(0 2px 6px rgba(37, 99, 235, 0.30));
                    }

            .record-count {
                background: #ffffff;
                padding: 0.2rem 0.9rem;
                border-radius: 60px;
                font-size: 0.75rem;
                font-weight: 600;
                color: #1e3a5f;
                border: 1px solid #93b5f5;
                margin-left: auto;
                box-shadow: 0 2px 8px rgba(37, 99, 235, 0.10);
            }

            /* ── Card Body ── */
            .card-body-custom {
                padding: 2rem;
            }

            /* ── Filter Form ── */
            .filter-form {
                background: #f8fafc;
                border-radius: 16px;
                padding: 1.2rem 1.5rem;
                margin-bottom: 1.5rem;
                border: 1px solid #e8edf5;
            }

                .filter-form .form-label {
                    font-weight: 600;
                    font-size: 0.8rem;
                    color: #1f3a5f;
                    margin-bottom: 0.3rem;
                }

                .filter-form .form-control {
                    border: 1px solid #e2e9f3;
                    border-radius: 12px;
                    padding: 0.6rem 1rem;
                    font-size: 0.9rem;
                    background: #ffffff;
                    transition: border 0.2s, box-shadow 0.2s;
                }

                    .filter-form .form-control:focus {
                        border-color: #2563eb;
                        box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.12);
                    }

            .btn-search {
                background: #2563eb;
                border: none;
                border-radius: 12px;
                padding: 0.6rem 1.8rem;
                font-weight: 600;
                font-size: 0.9rem;
                color: #ffffff;
                transition: all 0.25s ease;
                box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);
                display: inline-flex;
                align-items: center;
                gap: 0.4rem;
            }

                .btn-search:hover {
                    background: #1d4ed8;
                    transform: translateY(-2px);
                    box-shadow: 0 8px 20px rgba(37, 99, 235, 0.30);
                    color: #ffffff;
                }

                .btn-search i {
                    font-size: 1.1rem;
                }

            /* ── Table ── */
            .table-wrapper {
                overflow-x: auto;
                -webkit-overflow-scrolling: touch;
            }

            .table-custom {
                width: 100%;
                min-width: 600px;
                font-size: 0.9rem;
                border-collapse: separate;
                border-spacing: 0;
                margin-bottom: 0;
            }

                .table-custom thead th {
                    background: #f8faff;
                    border-bottom: 2px solid #e2e8f0;
                    font-weight: 600;
                    font-size: 0.75rem;
                    text-transform: uppercase;
                    letter-spacing: 0.04em;
                    color: #4a5d7a;
                    padding: 0.75rem 0.75rem;
                    white-space: nowrap;
                    position: sticky;
                    top: 0;
                    z-index: 5;
                }

                .table-custom tbody td {
                    padding: 0.7rem 0.75rem;
                    vertical-align: middle;
                    border-bottom: 1px solid #f0f3f9;
                }

                .table-custom tbody tr {
                    background: #ffffff;
                    transition: background 0.15s;
                }

                    .table-custom tbody tr:hover {
                        background: #f8fbff;
                    }

                .table-custom tfoot td {
                    padding: 0.7rem 0.75rem;
                    border-top: 2px solid #e2e8f0;
                    font-weight: 600;
                    background: #eff6ff;
                }

            .text-amount {
                font-weight: 700;
                color: #2563eb;
            }

            .text-muted-light {
                color: #9aabbe;
            }

            /* ── Empty State ── */
            .empty-state {
                color: #9aabbe;
                padding: 2.5rem 0;
            }

                .empty-state i {
                    font-size: 3rem;
                    display: block;
                    margin-bottom: 0.5rem;
                    opacity: 0.6;
                }

            /* ── Print Button ── */
            .btn-print {
                background: #eef2f7;
                border: 1px solid #d6dfea;
                border-radius: 60px;
                padding: 0.4rem 1.2rem;
                font-weight: 600;
                font-size: 0.85rem;
                color: #1f3a5f;
                transition: all 0.2s ease;
                display: inline-flex;
                align-items: center;
                gap: 0.4rem;
            }

                .btn-print:hover {
                    background: #e2eaf5;
                    border-color: #bcc9da;
                    transform: scale(1.03);
                    color: #0b2a4a;
                }

            /* ── Footer Info ── */
            .footer-info {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-top: 1rem;
            }

            /* ── Responsive ── */
            @@media (max-width: 768px) {
                body {
                    padding: 1rem;
                }

                .card-body-custom {
                    padding: 1.2rem;
                }

                .card-header-custom {
                    padding: 1rem 1.2rem;
                }

                    .card-header-custom h5 {
                        font-size: 1.1rem;
                    }

                        .card-header-custom h5 i {
                            font-size: 1.3rem;
                        }

                .record-count {
                    font-size: 0.65rem;
                    padding: 0.15rem 0.6rem;
                }

                .filter-form {
                    padding: 1rem;
                }

                    .filter-form .row {
                        gap: 0.5rem;
                    }

                    .filter-form .col-auto {
                        width: 100%;
                    }

                    .filter-form .form-control {
                        width: 100%;
                    }

                .btn-search {
                    width: 100%;
                    justify-content: center;
                }

                .table-custom {
                    min-width: 500px;
                    font-size: 0.8rem;
                }

                    .table-custom thead th {
                        font-size: 0.65rem;
                        padding: 0.5rem 0.4rem;
                    }

                    .table-custom tbody td {
                        padding: 0.4rem 0.4rem;
                    }

                    .table-custom tfoot td {
                        padding: 0.4rem 0.4rem;
                        font-size: 0.8rem;
                    }

                .footer-info {
                    flex-direction: column;
                    gap: 0.5rem;
                    align-items: flex-start;
                }

                .btn-print {
                    font-size: 0.8rem;
                    padding: 0.3rem 1rem;
                }
            }

            @@media (max-width: 576px) {
                .table-custom {
                    min-width: 400px;
                    font-size: 0.7rem;
                }

                    .table-custom thead th {
                        padding: 0.3rem 0.2rem;
                        font-size: 0.6rem;
                    }

                    .table-custom tbody td {
                        padding: 0.3rem 0.2rem;
                    }

                    .table-custom tfoot td {
                        padding: 0.3rem 0.2rem;
                        font-size: 0.7rem;
                    }

                .btn-print {
                    font-size: 0.75rem;
                    padding: 0.3rem 0.8rem;
                }
            }

            /* ── Print Styles ── */
            @@media print {
                .no-print {
                    display: none !important;
                }

                body {
                    background: white !important;
                    padding: 0.5in !important;
                }

                .report-card {
                    box-shadow: none !important;
                    border: 1px solid #ddd !important;
                    border-radius: 8px !important;
                }

                .card-header-custom {
                    background: #eff6ff !important;
                    border-bottom: 2px solid #2563eb !important;
                }

                    .card-header-custom::after {
                        display: none !important;
                    }

                .filter-form {
                    background: #f8fafc !important;
                    border: 1px solid #e2e8f0 !important;
                }

                .table-custom thead th {
                    background: #f1f5f9 !important;
                    border-bottom: 2px solid #d1d5db !important;
                    color: #111827 !important;
                }

                .table-custom tfoot td {
                    background: #eff6ff !important;
                    border-top: 2px solid #2563eb !important;
                }

                .btn-search {
                    background: #2563eb !important;
                    color: white !important;
                }

                .report-card:hover {
                    transform: none !important;
                    box-shadow: none !important;
                }
            }

            /* ── Reduced Motion ── */
            @@media (prefers-reduced-motion: reduce) {
                * {
                    animation-duration: 0.01ms !important;
                    transition-duration: 0.01ms !important;
                }
            }

            /* Custom Scrollbar for table */
            .table-wrapper::-webkit-scrollbar {
                height: 6px;
            }

            .table-wrapper::-webkit-scrollbar-track {
                background: #f1f5f9;
                border-radius: 10px;
            }

            .table-wrapper::-webkit-scrollbar-thumb {
                background: #d1dbe8;
                border-radius: 10px;
            }

                .table-wrapper::-webkit-scrollbar-thumb:hover {
                    background: #b8c6d6;
                }

            /* Table row animation */
            .table-custom tbody tr {
                animation: fadeInRow 0.3s ease forwards;
                opacity: 0;
            }

                .table-custom tbody tr:nth-child(1) {
                    animation-delay: 0.05s;
                }

                .table-custom tbody tr:nth-child(2) {
                    animation-delay: 0.08s;
                }

                .table-custom tbody tr:nth-child(3) {
                    animation-delay: 0.11s;
                }

                .table-custom tbody tr:nth-child(4) {
                    animation-delay: 0.14s;
                }

                .table-custom tbody tr:nth-child(5) {
                    animation-delay: 0.17s;
                }

                .table-custom tbody tr:nth-child(6) {
                    animation-delay: 0.20s;
                }

                .table-custom tbody tr:nth-child(7) {
                    animation-delay: 0.23s;
                }

                .table-custom tbody tr:nth-child(8) {
                    animation-delay: 0.26s;
                }

                .table-custom tbody tr:nth-child(9) {
                    animation-delay: 0.29s;
                }

                .table-custom tbody tr:nth-child(10) {
                    animation-delay: 0.32s;
                }

            @@keyframes fadeInRow {
                from {
                    opacity: 0;
                    transform: translateX(-10px);
                }

                to {
                    opacity: 1;
                    transform: translateX(0);
                }
            }
    </style>
</head>
<body>

    <div class="page-wrapper">

        <!-- ── Report Card ── -->
        <div class="report-card">
            <!-- Card Header -->
            <div class="card-header-custom">
                <h5>
                    <i class="bi bi-graph-up"></i>
                    <span>Purchase Report</span>
                    <span class="record-count">
                        <i class="bi bi-database me-1"></i>@Model.Count() records
                    </span>
                </h5>
            </div>

            <!-- Card Body -->
            <div class="card-body-custom">
                <!-- Filter Form -->
                <div class="filter-form">
                    <form method="get" class="row g-3 align-items-end">
                        <div class="col-md-3 col-sm-6">
                            <label class="form-label"><i class="bi bi-calendar3 me-1"></i>From Date</label>
                            <input type="date" name="from" class="form-control" value="@ViewBag.From" />
                        </div>
                        <div class="col-md-3 col-sm-6">
                            <label class="form-label"><i class="bi bi-calendar3 me-1"></i>To Date</label>
                            <input type="date" name="to" class="form-control" value="@ViewBag.To" />
                        </div>
                        <div class="col-md-2 col-sm-6">
                            <button type="submit" class="btn-search w-100">
                                <i class="bi bi-search"></i> Search
                            </button>
                        </div>
                        <div class="col-md-2 col-sm-6">
                            <a asp-action="PurchaseReport" class="btn-print w-100 justify-content-center">
                                <i class="bi bi-arrow-counterclockwise"></i> Reset
                            </a>
                        </div>
                        <div class="col-md-2 col-sm-12">
                            <button class="btn-print w-100 justify-content-center" onclick="printReport('Purchase Report')">
                                <i class="bi bi-printer"></i> Print
                            </button>
                        </div>
                    </form>
                </div>

                <!-- Table -->
                <div class="table-wrapper">
                    <table class="table-custom">
                        <thead>
                            <tr>
                                <th><i class="bi bi-calendar3 me-1"></i>Date</th>
                                <th><i class="bi bi-hash me-1"></i>Purchase #</th>
                                <th><i class="bi bi-building me-1"></i>Supplier</th>
                                <th class="text-center"><i class="bi bi-box me-1"></i>Items</th>
                                <th class="text-end"><i class="bi bi-coin me-1"></i>Grand Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center empty-state">
                                        <i class="bi bi-inbox"></i>
                                        No records found for the selected date range.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var r in Model)
                                {
                                    <tr>
                                        <td>@r.Date.ToString("dd-MM-yyyy")</td>
                                        <td class="fw-semibold">#@r.PurId</td>
                                        <td class="fw-semibold">@r.SupplierName</td>
                                        <td class="text-center">
                                            <span class="badge bg-secondary-subtle text-secondary border">
                                                @r.ItemCount
                                            </span>
                                        </td>
                                        <td class="text-end text-amount">₹@r.GrandTotal.ToString("N2")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                        @if (Model.Any())
                        {
                            <tfoot>
                                <tr>
                                    <td colspan="4" class="text-end">Total</td>
                                    <td class="text-end text-amount">₹@Model.Sum(r => r.GrandTotal).ToString("N2")</td>
                                </tr>
                            </tfoot>
                        }
                    </table>
                </div>
            </div>
        </div>

        <!-- ── Footer Info ── -->
        <div class="footer-info">
            <small class="text-muted">
                <i class="bi bi-clock me-1"></i>
                Generated: @DateTime.Now.ToString("dd MMM yyyy, hh:mm tt")
            </small>
          
        </div>

    </div>

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

    <script>
            function printReport(title) {
                window.print();
            }
    </script>

</body>
</html>