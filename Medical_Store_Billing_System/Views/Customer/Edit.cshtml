@model MedicalStore.Business.ViewModels.CustomerVM
@{
    ViewData["Title"] = "Edit Customer";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Edit Customer</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
            *, *::before, *::after {
                box-sizing: border-box;
            }

            body {
                min-height: 100vh;
                background: linear-gradient(135deg, #e8f4f8 0%, #f0f7f4 50%, #e8f0f8 100%);
                font-family: 'Inter', system-ui, sans-serif;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 2rem 1rem;
            }

            /* ── Card ── */
            .edit-card {
                width: 100%;
                max-width: 580px;
                border-radius: 20px;
                overflow: hidden;
                background: #ffffff;
                box-shadow: 0 4px 6px -1px rgba(0, 120, 140, 0.07), 0 10px 24px -4px rgba(0, 120, 140, 0.13), 0 32px 56px -8px rgba(0, 100, 120, 0.10);
                transition: box-shadow .3s ease;
            }

                .edit-card:hover {
                    box-shadow: 0 6px 10px -2px rgba(0, 120, 140, 0.10), 0 16px 36px -4px rgba(0, 120, 140, 0.18), 0 40px 70px -10px rgba(0, 100, 120, 0.14);
                }

            /* ── Hero Header ── */
            .card-hero {
                background: linear-gradient(120deg, #0d7a8a 0%, #0a9e7f 100%);
                padding: 1.6rem 1.75rem;
                position: relative;
                overflow: hidden;
            }

                .card-hero::after {
                    content: '';
                    position: absolute;
                    inset: 0;
                    background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.04'%3E%3Ccircle cx='30' cy='30' r='28'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E") repeat;
                    pointer-events: none;
                }

            .hero-inner {
                display: flex;
                align-items: center;
                gap: .95rem;
                position: relative;
                z-index: 1;
            }

            .avatar-ring {
                width: 48px;
                height: 48px;
                border-radius: 50%;
                background: rgba(255,255,255,0.18);
                border: 2px solid rgba(255,255,255,0.38);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.35rem;
                color: #fff;
                flex-shrink: 0;
            }

            .hero-title {
                font-size: 1.12rem;
                font-weight: 700;
                color: #fff;
                letter-spacing: -.01em;
            }

            .hero-sub {
                font-size: .75rem;
                color: rgba(255,255,255,.68);
                font-weight: 500;
                letter-spacing: .04em;
                text-transform: uppercase;
                margin-top: 2px;
            }

            /* ── Form body ── */
            .form-body {
                padding: 1.6rem 1.75rem;
            }

            /* ── Validation summary ── */
            .val-summary {
                border-radius: 12px;
                border: 1px solid #fddbc8;
                background: #fff8f5;
                color: #c44000;
                padding: .65rem 1rem;
                font-size: .82rem;
                font-weight: 500;
                margin-bottom: 1.25rem;
            }

                .val-summary:empty {
                    display: none;
                }

            /* ── Field wrapper ── */
            .field-wrap {
                display: flex;
                flex-direction: column;
                gap: .28rem;
            }

            .field-label {
                font-size: .73rem;
                font-weight: 700;
                color: #5a7280;
                text-transform: uppercase;
                letter-spacing: .06em;
            }

            /* ── Input styles ── */
            .field-control,
            .field-textarea {
                width: 100%;
                border: 1.5px solid #dde6ec;
                border-radius: 11px;
                padding: .58rem .85rem;
                font-family: inherit;
                font-size: .92rem;
                font-weight: 500;
                color: #1e2d3a;
                background: #f8fafc;
                outline: none;
                transition: border-color .18s, box-shadow .18s, background .18s;
            }

                .field-control:focus,
                .field-textarea:focus {
                    border-color: #0d7a8a;
                    background: #fff;
                    box-shadow: 0 0 0 3.5px rgba(13, 122, 138, 0.12);
                }

                .field-control::placeholder,
                .field-textarea::placeholder {
                    color: #b0bec5;
                    font-weight: 400;
                }

            .field-textarea {
                resize: vertical;
                min-height: 72px;
            }

            /* ── Input group (icon prefix) ── */
            .input-with-icon {
                position: relative;
            }

            .input-icon {
                position: absolute;
                left: .8rem;
                top: 50%;
                transform: translateY(-50%);
                color: #0d7a8a;
                font-size: .95rem;
                pointer-events: none;
            }

            .input-with-icon .field-control {
                padding-left: 2.2rem;
            }

            /* ── Read-only balance field ── */
            .balance-wrap {
                position: relative;
            }

            .balance-prefix {
                position: absolute;
                left: .85rem;
                top: 50%;
                transform: translateY(-50%);
                font-weight: 700;
                color: #0d7a8a;
                font-size: .95rem;
                pointer-events: none;
            }

            .field-control.readonly-bal {
                padding-left: 1.9rem;
                background: #f0f7f9;
                color: #1a8a50;
                font-weight: 700;
                font-size: 1rem;
                border-color: #c8e6ec;
                cursor: not-allowed;
            }

            .bal-hint {
                font-size: .72rem;
                color: #94a3b0;
                font-weight: 500;
                margin-top: 4px;
                display: flex;
                align-items: center;
                gap: .3rem;
            }

            /* ── Validation messages ── */
            .val-msg {
                font-size: .75rem;
                color: #d44a00;
                font-weight: 500;
                margin-top: 2px;
            }

            /* ── Divider ── */
            .form-divider {
                border: none;
                border-top: 1px solid #edf1f4;
                margin: 1.4rem 0 1.25rem;
            }

            /* ── Buttons ── */
            .footer-actions {
                display: flex;
                flex-wrap: wrap;
                gap: .6rem;
                align-items: center;
            }

            .btn-action {
                display: inline-flex;
                align-items: center;
                gap: .4rem;
                padding: .55rem 1.25rem;
                border-radius: 11px;
                font-size: .88rem;
                font-weight: 600;
                border: none;
                cursor: pointer;
                text-decoration: none;
                font-family: inherit;
                transition: transform .15s, box-shadow .15s, filter .15s;
            }

                .btn-action:hover {
                    transform: translateY(-1px);
                    filter: brightness(1.06);
                    box-shadow: 0 4px 14px rgba(0,0,0,0.13);
                }

                .btn-action:active {
                    transform: translateY(0);
                }

            .btn-save {
                background: linear-gradient(120deg, #0d7a8a, #0a9e7f);
                color: #fff;
            }

            .btn-cancel {
                background: #f0f4f6;
                color: #546e7a;
                border: 1.5px solid #dde4e8;
            }

                .btn-cancel:hover {
                    background: #e4eaed;
                    color: #37474f;
                }

            /* ── Responsive ── */
            @@media (max-width: 480px) {
                body {
                    padding: 1rem .5rem;
                }

                .card-hero {
                    padding: 1.3rem 1.1rem;
                }

                .form-body {
                    padding: 1.2rem 1rem;
                }

                .grid-2col {
                    grid-template-columns: 1fr !important;
                }
            }

            @@media (prefers-reduced-motion: reduce) {
                .edit-card, .btn-action, .field-control, .field-textarea {
                    transition: none;
                }
            }
    </style>
</head>
<body>

    <div class="edit-card">

        <!-- ── Hero Header ── -->
        <div class="card-hero">
            <div class="hero-inner">
                <div class="avatar-ring">
                    <i class="bi bi-pencil-fill"></i>
                </div>
                <div>
                    <div class="hero-title">Edit Customer</div>
                    <div class="hero-sub">Update customer information</div>
                </div>
            </div>
        </div>

        <!-- ── Form Body ── -->
        <div class="form-body">
            <form asp-action="Edit" method="post" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="CustId" />

                <!-- Validation Summary -->
                <div asp-validation-summary="ModelOnly" class="val-summary"></div>

                <!-- Full Name -->
                <div class="field-wrap mb-3">
                    <label asp-for="CustName" class="field-label">
                        <i class="bi bi-person me-1"></i>Full Name
                    </label>
                    <div class="input-with-icon">
                        <i class="bi bi-person input-icon"></i>
                        <input asp-for="CustName" class="field-control" placeholder="Enter customer name" style="padding-left:2.2rem" />
                    </div>
                    <span asp-validation-for="CustName" class="val-msg"></span>
                </div>

                <!-- Phone + Email row -->
                <div class="row g-3 mb-3"
                     style="display:grid; grid-template-columns:1fr 1fr; gap:.85rem;"
                     class="grid-2col">
                    <div class="field-wrap">
                        <label asp-for="CustPhone" class="field-label">
                            <i class="bi bi-telephone me-1"></i>Phone
                        </label>
                        <div class="input-with-icon">
                            <i class="bi bi-telephone input-icon"></i>
                            <input asp-for="CustPhone" class="field-control" placeholder="e.g. 9876543210" style="padding-left:2.2rem" />
                        </div>
                        <span asp-validation-for="CustPhone" class="val-msg"></span>
                    </div>
                    <div class="field-wrap">
                        <label asp-for="CustEmail" class="field-label">
                            <i class="bi bi-envelope me-1"></i>Email
                        </label>
                        <div class="input-with-icon">
                            <i class="bi bi-envelope input-icon"></i>
                            <input asp-for="CustEmail" class="field-control" placeholder="email@example.com" style="padding-left:2.2rem" />
                        </div>
                        <span asp-validation-for="CustEmail" class="val-msg"></span>
                    </div>
                </div>

                <!-- Address -->
                <div class="field-wrap mb-3">
                    <label asp-for="CustAddress" class="field-label">
                        <i class="bi bi-geo-alt me-1"></i>Address
                    </label>
                    <textarea asp-for="CustAddress" class="field-textarea" rows="2"
                              placeholder="Street, City, State..."></textarea>
                </div>

                <!-- Balance (read-only) -->
                <div class="field-wrap mb-1">
                    <label asp-for="CustBal" class="field-label">
                        <i class="bi bi-wallet2 me-1"></i>Outstanding Balance
                    </label>
                    <div class="balance-wrap">
                        <span class="balance-prefix">&#8377;</span>
                        <input asp-for="CustBal" class="field-control readonly-bal" readonly />
                    </div>
                    <div class="bal-hint">
                        <i class="bi bi-info-circle"></i>
                        Balance is system-managed via sales &amp; receipts.
                    </div>
                </div>

                <hr class="form-divider" />

                <!-- Actions -->
                <div class="footer-actions">
                    <button type="submit" class="btn-action btn-save">
                        <i class="bi bi-check-lg"></i> Update Customer
                    </button>
                    <a asp-action="Index" class="btn-action btn-cancel">
                        <i class="bi bi-x-lg"></i> Cancel
                    </a>
                </div>

            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await Html.PartialAsync("_ValidationScriptsPartial")
</body>
</html>
