@model MedicalStore.Business.ViewModels.BrandDetailsVM

@{
    ViewData["Title"] = "Brand Details";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Medical Store</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
            * {
                font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            }

            body {
                background: #f4f7fc;
                padding: 24px;
                min-height: 100vh;
                display: flex;
                align-items: flex-start;
                justify-content: center;
            }

            .details-container {
                max-width: 700px;
                width: 100%;
                margin: 0 auto;
            }

            /* ── Header ── */
            .page-header {
                background: linear-gradient(135deg, #0b2a3e 0%, #1a4a6b 100%);
                border-radius: 20px;
                padding: 24px 28px;
                color: #fff;
                margin-bottom: 24px;
                position: relative;
                overflow: hidden;
                border: 1px solid rgba(255, 255, 255, .08);
                box-shadow: 0 10px 30px rgba(0, 0, 0, .12);
            }

                .page-header::after {
                    content: '';
                    position: absolute;
                    top: -60%;
                    right: -20%;
                    width: 300px;
                    height: 300px;
                    background: rgba(255, 255, 255, 0.04);
                    border-radius: 50%;
                    pointer-events: none;
                }

                .page-header .header-icon {
                    width: 52px;
                    height: 52px;
                    background: rgba(255, 255, 255, 0.15);
                    backdrop-filter: blur(4px);
                    border-radius: 14px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 26px;
                    flex-shrink: 0;
                }

                .page-header h4 {
                    font-weight: 700;
                    letter-spacing: -0.02em;
                    margin: 0;
                }

                .page-header .subtitle {
                    font-weight: 400;
                    font-size: 0.9rem;
                    opacity: 0.7;
                    margin: 0;
                }

                .page-header .badge-status {
                    background: rgba(255, 255, 255, 0.18);
                    backdrop-filter: blur(4px);
                    padding: 4px 16px;
                    border-radius: 40px;
                    font-size: 0.8rem;
                    font-weight: 600;
                    border: 1px solid rgba(255, 255, 255, 0.08);
                }

            .badge-status.active {
                background: rgba(46, 160, 67, 0.25);
                border-color: rgba(46, 160, 67, 0.3);
            }

            .badge-status.inactive {
                background: rgba(220, 53, 69, 0.2);
                border-color: rgba(220, 53, 69, 0.3);
            }

            /* ── Card ── */
            .details-card {
                background: #fff;
                border-radius: 18px;
                overflow: hidden;
                border: 1px solid #eef2f6;
                box-shadow: 0 8px 25px rgba(0, 0, 0, .08);
            }

                .details-card .card-body {
                    padding: 28px 32px;
                }

            .detail-row {
                display: flex;
                padding: 12px 0;
                border-bottom: 1px solid #f0f3f7;
            }

                .detail-row:last-child {
                    border-bottom: 0;
                }

            .detail-label {
                width: 180px;
                flex-shrink: 0;
                font-weight: 600;
                color: #5a738a;
                font-size: 0.85rem;
                text-transform: uppercase;
                letter-spacing: 0.4px;
            }

            .detail-value {
                flex: 1;
                color: #0b2a3e;
                font-weight: 500;
                font-size: 0.95rem;
            }

                .detail-value .badge {
                    font-size: 0.8rem;
                    padding: 4px 14px;
                }

                .detail-value .medicine-count {
                    background: #e8f4fd;
                    color: #0d6efd;
                    padding: 2px 12px;
                    border-radius: 40px;
                    font-weight: 600;
                    font-size: 0.9rem;
                }

                .detail-value .stock-value {
                    color: #16a34a;
                    font-weight: 700;
                    font-size: 1rem;
                }

            /* ── Action Buttons ── */
            .action-buttons {
                margin-top: 24px;
                display: flex;
                gap: 10px;
                flex-wrap: wrap;
            }

            .btn-back {
                background: #f0f4f9;
                border: 1px solid #e2e8f0;
                padding: 8px 24px;
                border-radius: 40px;
                font-weight: 600;
                font-size: 0.9rem;
                color: #3a5a7a;
                transition: all 0.25s ease;
                text-decoration: none;
                display: inline-flex;
                align-items: center;
                gap: 8px;
            }

                .btn-back:hover {
                    background: #e2e8f0;
                    color: #0b2a3e;
                }

            .btn-edit {
                background: linear-gradient(135deg, #0b2a3e, #1a4a6b);
                border: none;
                padding: 8px 24px;
                border-radius: 40px;
                font-weight: 600;
                font-size: 0.9rem;
                color: #fff;
                transition: all 0.25s ease;
                text-decoration: none;
                display: inline-flex;
                align-items: center;
                gap: 8px;
                box-shadow: 0 4px 14px rgba(26, 74, 107, 0.3);
            }

                .btn-edit:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 8px 24px rgba(26, 74, 107, 0.35);
                    color: #fff;
                }

            /* ── Responsive ── */
            @@media (max-width: 768px) {
                body {
                    padding: 12px;
                }

                .page-header {
                    padding: 18px 20px;
                    border-radius: 16px;
                }

                    .page-header h4 {
                        font-size: 1.1rem;
                    }

                    .page-header .header-icon {
                        width: 40px;
                        height: 40px;
                        font-size: 18px;
                    }

                .details-card .card-body {
                    padding: 20px;
                }

                .detail-row {
                    flex-direction: column;
                    padding: 10px 0;
                }

                .detail-label {
                    width: 100%;
                    font-size: 0.75rem;
                    margin-bottom: 2px;
                }

                .detail-value {
                    font-size: 0.9rem;
                }

                .action-buttons {
                    flex-direction: column;
                }

                .btn-back,
                .btn-edit {
                    justify-content: center;
                    width: 100%;
                }
            }
    </style>
</head>

<body>

    <div class="details-container">

        <!-- ─── HEADER ─── -->
        <div class="page-header d-flex align-items-center gap-3">
            <div class="header-icon">
                <i class="bi bi-award-fill"></i>
            </div>
            <div class="flex-grow-1">
                <h4 class="d-flex align-items-center gap-3 flex-wrap">
                    Brand Details
                    <span class="badge-status @(Model.IsActive ? "active" : "inactive")">
                        <i class="bi @(Model.IsActive ? "bi-check-circle" : "bi-x-circle") me-1"></i>
                        @Model.Status
                    </span>
                </h4>
                <p class="subtitle">View complete brand information</p>
            </div>
        </div>

        <!-- ─── DETAILS CARD ─── -->
        <div class="details-card">
            <div class="card-body">

                <div class="detail-row">
                    <div class="detail-label">Brand ID</div>
                    <div class="detail-value">
                        <span class="badge bg-secondary">#@Model.BrandId</span>
                    </div>
                </div>

                <div class="detail-row">
                    <div class="detail-label">Brand Name</div>
                    <div class="detail-value fw-bold">@Model.BrandName</div>
                </div>

                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <div class="detail-row">
                        <div class="detail-label">Description</div>
                        <div class="detail-value">@Model.Description</div>
                    </div>
                }

                <div class="detail-row">
                    <div class="detail-label">Status</div>
                    <div class="detail-value">
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Inactive</span>
                        }
                    </div>
                </div>

                <div class="detail-row">
                    <div class="detail-label">Created Date</div>
                    <div class="detail-value">@Model.CreatedDateFormatted</div>
                </div>

                @if (Model.ModifiedDate.HasValue)
                {
                    <div class="detail-row">
                        <div class="detail-label">Last Modified</div>
                        <div class="detail-value">@Model.ModifiedDateFormatted</div>
                    </div>
                }

                <!-- ─── Additional Stats ─── -->
                <div class="detail-row" style="border-top: 2px solid #eef2f6; margin-top: 8px; padding-top: 16px;">
                    <div class="detail-label">Related Medicines</div>
                    <div class="detail-value">
                        <span class="medicine-count">
                            <i class="bi bi-capsule me-1"></i> @Model.MedicineCount
                        </span>
                    </div>
                </div>

                <div class="detail-row">
                    <div class="detail-label">Total Stock Value</div>
                    <div class="detail-value">
                        <span class="stock-value">
                            <i class="bi bi-currency-rupee me-1"></i> ₹@Model.TotalStockValue.ToString("N2")
                        </span>
                    </div>
                </div>

            </div>
        </div>

        <!-- ─── ACTION BUTTONS ─── -->
        <div class="action-buttons">
            <a asp-action="Index" class="btn-back">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
            
        </div>

        <div class="text-center text-muted small mt-4 opacity-50" style="font-size:0.75rem;">
            <i class="bi bi-shield-check me-1"></i> Secure · Medical Store Management
        </div>

    </div>

</body>
</html>