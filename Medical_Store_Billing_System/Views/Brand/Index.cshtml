@model IEnumerable<MedicalStore.Business.ViewModels.BrandVM>
@{
    ViewData["Title"] = "Brands";
    Layout = null;
    var allBrandsData = ViewBag.AllBrands as IEnumerable<MedicalStore.Business.ViewModels.BrandVM> ?? Model;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Medical Store</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" defer></script>

    <style>
        * {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        }

        body {
        background: #f0f4f9;
        padding: 24px;
        min-height: 100vh;
        display: flex;
        align-items: flex-start;
        justify-content: center;
        }

        .brand-container {
        max-width: 900px;
        width: 100%;
        margin: 0 auto;
        }

        /* ── Header Styles ── */
        .page-header {
        background: linear-gradient(135deg, #0b2a3e 0%, #1a4a6b 100%);
        border-radius: 20px;
        padding: 28px 32px;
        color: #fff;
        margin-bottom: 28px;
        position: relative;
        overflow: hidden;
        border: 1px solid rgba(255,255,255,.08);
        box-shadow: 0 10px 30px rgba(0,0,0,.12), 0 18px 50px rgba(11,42,62,.18);
        }

        .page-header::after {
        content: '';
        position: absolute;
        top: -60%;
        right: -20%;
        width: 300px;
        height: 300px;
        background: rgba(255, 255, 255, 0.04);
        border-radius: 50%;
        pointer-events: none;
        }

        .page-header .header-icon {
        width: 52px;
        height: 52px;
        background: rgba(255, 255, 255, 0.15);
        backdrop-filter: blur(4px);
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
        flex-shrink: 0;
        }

        .page-header h1 {
        font-weight: 700;
        font-size: 1.65rem;
        letter-spacing: -0.02em;
        margin: 0;
        }

        .page-header .subtitle {
        font-weight: 400;
        font-size: 0.9rem;
        opacity: 0.7;
        margin: 0;
        }

        .page-header .badge-count {
        background: rgba(255, 255, 255, 0.18);
        backdrop-filter: blur(4px);
        padding: 6px 16px;
        border-radius: 40px;
        font-size: 0.85rem;
        font-weight: 500;
        letter-spacing: 0.3px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        }

        /* ── Toolbar Styles ── */
        .toolbar {
        background: #fff;
        border-radius: 16px;
        padding: 14px 20px;
        margin-bottom: 24px;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 12px;
        border: 1px solid #eef2f6;
        box-shadow: 0 8px 25px rgba(0,0,0,.08), 0 2px 8px rgba(0,0,0,.05);
        }

        .search-container {
        flex: 1;
        min-width: 250px;
        }

        .search-container .search-wrapper {
        position: relative;
        width: 100%;
        }

        .search-container .search-wrapper input {
        width: 100%;
        padding: 10px 14px 10px 40px;
        background: #f8fafc;
        border: 1.5px solid #e9edf2;
        border-radius: 40px;
        color: #0b2a3e;
        font-size: 0.9rem;
        outline: none;
        transition: all 0.25s ease;
        }

        .search-container .search-wrapper input:focus {
        border-color: #1a4a6b;
        background: #fff;
        box-shadow: 0 0 0 4px rgba(26, 74, 107, 0.08);
        }

        .search-container .search-wrapper input::placeholder {
        color: #a5b9cd;
        font-weight: 400;
        }

        .search-container .search-wrapper .search-icon {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: #a0b8cc;
        font-size: 0.95rem;
        pointer-events: none;
        }

        .clear-search-btn {
        background: #ef4444;
        color: white;
        border: none;
        padding: 8px 16px;
        border-radius: 30px;
        cursor: pointer;
        font-size: 0.8rem;
        font-weight: 600;
        transition: all 0.2s ease;
        display: none;
        align-items: center;
        gap: 6px;
        white-space: nowrap;
        }

        .clear-search-btn:hover {
        background: #dc2626;
        transform: scale(1.05);
        }

        .clear-search-btn.show {
        display: inline-flex;
        }

        .search-info {
        color: #64748b;
        font-size: 0.8rem;
        display: none;
        align-items: center;
        gap: 4px;
        }

        .search-info.show {
        display: inline-flex;
        }

        /* ── Button Styles ── */
        .btn-add {
        background: linear-gradient(135deg, #0b2a3e, #1a4a6b);
        border: none;
        padding: 9px 24px;
        border-radius: 40px;
        font-weight: 600;
        font-size: 0.9rem;
        color: #fff;
        transition: all 0.25s ease;
        white-space: nowrap;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 4px 14px rgba(26, 74, 107, 0.3);
        text-decoration: none;
        }

        .btn-add:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(26, 74, 107, 0.35);
        color: #fff;
        }

        .btn-add:active {
        transform: translateY(0);
        }

        /* ── Table Styles ── */
        .brand-card {
        background: #fff;
        border-radius: 18px;
        overflow: hidden;
        border: 1px solid #eef2f6;
        transition: all .3s ease;
        box-shadow: 0 10px 30px rgba(0,0,0,.08), 0 3px 10px rgba(0,0,0,.05);
        }

        .brand-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 18px 45px rgba(0,0,0,.14), 0 6px 18px rgba(0,0,0,.08);
        }

        .table-brand {
        margin: 0;
        font-size: 0.92rem;
        }

        .table-brand thead {
        background: #f8fafc;
        border-bottom: 1.5px solid #eef2f6;
        }

        .table-brand thead th {
        font-weight: 600;
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #5a738a;
        padding: 16px 18px;
        border: 0;
        }

        .table-brand tbody td {
        padding: 14px 18px;
        vertical-align: middle;
        border-bottom: 1px solid #f0f3f7;
        background: #fff;
        }

        .table-brand tbody tr:last-child td {
        border-bottom: 0;
        }

        .table-brand tbody tr {
        transition: background 0.15s ease;
        }

        .table-brand tbody tr:hover {
        background: #fafcff;
        }

        .brand-id {
        font-weight: 500;
        color: #7a93ab;
        font-size: 0.8rem;
        background: #f0f4f9;
        padding: 2px 10px;
        border-radius: 40px;
        display: inline-block;
        letter-spacing: 0.2px;
        }

        .brand-name {
        font-weight: 600;
        color: #0b2a3e;
        font-size: 0.95rem;
        display: flex;
        align-items: center;
        gap: 10px;
        }

        .brand-name .brand-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        display: inline-block;
        flex-shrink: 0;
        background: #34a853;
        }

        /* ── Action Buttons ── */
        .action-group {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        }

        .action-group .btn-icon {
        width: 34px;
        height: 34px;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        font-size: 0.9rem;
        border: 0;
        transition: all 0.2s ease;
        background: transparent;
        color: #7a93ab;
        text-decoration: none;
        }

        .action-group .btn-icon:hover {
        background: #f0f4f9;
        color: #0b2a3e;
        transform: scale(1.05);
        }

        .action-group .btn-icon.details:hover {
        background: #e8f4fd;
        color: #0d6efd;
        }

        .action-group .btn-icon.edit:hover {
        background: #e8f0fe;
        color: #1a73e8;
        }

        .action-group .btn-icon.delete:hover {
        background: #fde8e8;
        color: #d93025;
        }

        /* ── Footer Styles ── */
        .card-footer-custom {
        background: #fafcfe;
        padding: 14px 20px;
        border-top: 1px solid #eef2f6;
        font-size: 0.85rem;
        color: #5a738a;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        }

        .card-footer-custom .total-badge {
        background: #eef2f6;
        padding: 4px 14px;
        border-radius: 40px;
        font-weight: 500;
        font-size: 0.8rem;
        color: #3a5a7a;
        }

        /* ── Empty State ── */
        .empty-state {
        padding: 52px 20px;
        text-align: center;
        }

        .empty-state .empty-icon {
        font-size: 56px;
        color: #d0dce8;
        display: block;
        margin-bottom: 16px;
        }

        .empty-state h6 {
        font-weight: 600;
        color: #1a3a5a;
        font-size: 1.1rem;
        margin-bottom: 6px;
        }

        .empty-state p {
        color: #7a93ab;
        font-size: 0.9rem;
        max-width: 320px;
        margin: 0 auto 18px;
        }

        /* ── Pagination Styles ── */
        .pagination .page-link {
        color: #1a4a6b;
        border-radius: 8px;
        margin: 0 3px;
        border: 1px solid #e9edf2;
        padding: 8px 14px;
        }

        .pagination .page-link:hover {
        background: #f0f4f9;
        border-color: #1a4a6b;
        }

        .pagination .page-item.active .page-link {
        background: #1a4a6b;
        border-color: #1a4a6b;
        color: #fff;
        }

        .pagination .page-item.disabled .page-link {
        color: #a0b8cc;
        cursor: not-allowed;
        }

        /* ── Animation ── */
        .fade-in {
        animation: fadeIn 0.4s ease forwards;
        opacity: 0;
        }

        @@keyframes fadeIn {
        to {
        opacity: 1;
        }
        }

        .fade-in:nth-child(1) {
        animation-delay: 0.02s;
        }

        .fade-in:nth-child(2) {
        animation-delay: 0.04s;
        }

        .fade-in:nth-child(3) {
        animation-delay: 0.06s;
        }

        .fade-in:nth-child(4) {
        animation-delay: 0.08s;
        }

        .fade-in:nth-child(5) {
        animation-delay: 0.10s;
        }

        .fade-in:nth-child(6) {
        animation-delay: 0.12s;
        }

        .fade-in:nth-child(7) {
        animation-delay: 0.14s;
        }

        .fade-in:nth-child(8) {
        animation-delay: 0.16s;
        }

        .fade-in:nth-child(9) {
        animation-delay: 0.18s;
        }

        .fade-in:nth-child(10) {
        animation-delay: 0.20s;
        }

        #noClientMatch {
        display: none;
        }

        /* ── Responsive ── */
        @@media (max-width: 768px) {
        body {
        padding: 12px;
        }

        .page-header {
        padding: 20px 18px;
        border-radius: 16px;
        flex-wrap: wrap;
        }

        .page-header h1 {
        font-size: 1.25rem;
        }

        .page-header .header-icon {
        width: 44px;
        height: 44px;
        font-size: 20px;
        }

        .page-header .badge-count {
        font-size: 0.75rem;
        padding: 4px 12px;
        margin-top: 4px;
        }

        .toolbar {
        padding: 12px 16px;
        border-radius: 14px;
        flex-direction: column;
        align-items: stretch;
        gap: 10px;
        }

        .search-container {
        min-width: 100%;
        }

        .clear-search-btn {
        width: 100%;
        justify-content: center;
        }

        .toolbar .btn-add {
        justify-content: center;
        padding: 10px 18px;
        width: 100%;
        }

        .brand-card {
        border-radius: 14px;
        }

        .table-brand thead {
        display: none;
        }

        .table-brand tbody tr {
        display: block;
        padding: 16px 16px 14px;
        border-bottom: 1px solid #eef2f6;
        background: #fff;
        }

        .table-brand tbody tr:last-child {
        border-bottom: 0;
        }

        .table-brand tbody td {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 6px 0;
        border: 0;
        background: transparent;
        font-size: 0.88rem;
        }

        .table-brand tbody td::before {
        content: attr(data-label);
        font-weight: 500;
        color: #5a738a;
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.3px;
        }

        .table-brand tbody td:first-child {
        padding-top: 0;
        }

        .table-brand tbody td:last-child {
        padding-bottom: 0;
        border-top: 1px solid #f0f3f7;
        margin-top: 8px;
        padding-top: 10px;
        justify-content: center;
        }

        .table-brand tbody td:last-child::before {
        display: none;
        }

        .action-group .btn-icon {
        width: 40px;
        height: 40px;
        font-size: 1rem;
        }

        .card-footer-custom {
        flex-direction: column;
        text-align: center;
        padding: 12px 16px;
        gap: 4px;
        }

        .empty-state {
        padding: 36px 16px;
        }

        .empty-state .empty-icon {
        font-size: 44px;
        }
        }

        @@media (max-width: 400px) {
        .page-header h1 {
        font-size: 1.1rem;
        }

        .page-header .subtitle {
        font-size: 0.78rem;
        }
        }
    </style>
</head>

<body>
    <div class="brand-container">
        <!-- ─── HEADER ─── -->
        <div class="page-header d-flex flex-wrap align-items-center gap-3">
            <div class="header-icon">
                <i class="bi bi-award-fill"></i>
            </div>
            <div class="flex-grow-1">
                <h1 class="d-flex align-items-center gap-2 flex-wrap">
                    Brands
                    <span class="badge-count">
                        <i class="bi bi-database me-1"></i>
                        @ViewBag.TotalRecords results
                    </span>
                </h1>
                <p class="subtitle">Manage your product brands and manufacturers</p>
            </div>
            <a asp-action="Create" class="btn-add">
                <i class="bi bi-plus-lg"></i> Add Brand aaa
            </a>
        </div>

        <!-- ─── TOOLBAR WITH SEARCH ─── -->
        <div class="toolbar">
            <div class="search-container">
                <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
                    <div class="search-wrapper" style="flex: 1; min-width: 250px;">
                        <input type="text" id="brandSearchInput"
                               placeholder="Search across all brands by name or ID..."
                               autocomplete="off"
                               value="@ViewBag.CurrentSearch" />
                        <i class="fa-solid fa-magnifying-glass search-icon"></i>
                    </div>
                    <button type="button" id="clearSearchBtn" class="clear-search-btn">
                        <i class="fa-solid fa-times"></i> Clear
                    </button>
                    <div id="searchInfo" class="search-info">
                        <i class="fa-solid fa-info-circle"></i>
                        <span id="searchResultCount"></span>
                    </div>
                </div>
            </div>

            <div class="d-flex align-items-center gap-2 ms-auto flex-wrap">
                <span class="text-muted small" id="resultCount">
                    Showing <strong id="visibleCount">@ViewBag.TotalRecords</strong> of <strong id="totalCount">@ViewBag.TotalRecords</strong> brands
                </span>
            </div>
        </div>

        <!-- ─── TABLE ─── -->
        <div class="brand-card">
            <div class="table-responsive">
                <table class="table table-brand" id="brandTable">
                    <thead>
                        <tr>
                            <th style="width:80px">ID</th>
                            <th>Brand Name</th>
                            <th style="width:180px" class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="brandTableBody">
                        @if (!Model.Any())
                        {
                            <tr id="serverEmptyState">
                                <td colspan="3">
                                    <div class="empty-state">
                                        @if (!string.IsNullOrEmpty(ViewBag.CurrentSearch))
                                        {
                                            <i class="bi bi-search empty-icon"></i>
                                            <h6>No matching brands</h6>
                                            <p>No brands found matching "<strong>@ViewBag.CurrentSearch</strong>". Try adjusting your search.</p>
                                            <a asp-action="Index" class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-arrow-left me-1"></i> Clear Search
                                            </a>
                                        }
                                        else
                                        {
                                            <i class="bi bi-inbox empty-icon"></i>
                                            <h6>No brands yet</h6>
                                            <p>Get started by adding your first brand. Click <strong>Add Brand</strong> above.</p>
                                            <a asp-action="Create" class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-plus-lg me-1"></i> Create Brand
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr class="fade-in"
                                    data-search="@item.BrandName.ToLower() @item.BrandId">
                                    <td data-label="ID">
                                        <span class="brand-id">#@item.BrandId</span>
                                    </td>
                                    <td data-label="Brand">
                                        <span class="brand-name">
                                            <span class="brand-dot"></span>
                                            @item.BrandName
                                        </span>
                                    </td>
                                    <td data-label="Actions" class="text-center">
                                        <div class="action-group">
                                            <a asp-action="Details" asp-route-id="@item.BrandId"
                                               class="btn-icon details" title="View Details">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.BrandId"
                                               class="btn-icon edit" title="Edit brand">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.BrandId"
                                               class="btn-icon delete" title="Delete brand">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                            <!-- Shown only when client-side search matches nothing -->
                            <tr id="noClientMatch" style="display:none;">
                                <td colspan="3">
                                    <div class="empty-state">
                                        <i class="bi bi-search empty-icon"></i>
                                        <h6>No matching brands</h6>
                                        <p>No brands found matching your search across all pages.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="card-footer-custom">
                <span>
                    <i class="bi bi-list-ul me-1"></i>
                    Showing <strong id="footerVisibleCount">@ViewBag.TotalRecords</strong> of <strong id="footerTotalCount">@ViewBag.TotalRecords</strong> brands
                </span>
                <span class="total-badge">
                    <i class="bi bi-clock-history me-1"></i> Updated just now
                </span>
            </div>
        </div>

        <!-- ─── PAGINATION ─── -->
        @if (ViewBag.TotalPages > 1)
        {
            <nav class="mt-4" id="paginationNav">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-page="@(ViewBag.CurrentPage - 1)"
                           asp-route-searchTerm="@ViewBag.CurrentSearch">
                            <i class="bi bi-chevron-left"></i> Previous
                        </a>
                    </li>

                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-page="@i"
                               asp-route-searchTerm="@ViewBag.CurrentSearch">@i</a>
                        </li>
                    }

                    <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-page="@(ViewBag.CurrentPage + 1)"
                           asp-route-searchTerm="@ViewBag.CurrentSearch">
                            Next <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        }

        <!-- ─── FOOTER ─── -->
        <div class="text-center text-muted small mt-4 opacity-50" style="font-size:0.75rem;">
            <i class="bi bi-shield-check me-1"></i> Secure · Medical Store Management
        </div>
    </div>

    <!-- ─── SCRIPTS ─── -->
    <script>
        (function() {
        'use strict';

        // Store ALL brands for searching across all pages
        const allBrandsForSearch = @Html.Raw(Json.Serialize(allBrandsData));
        const searchInput = document.getElementById('brandSearchInput');
        const clearBtn = document.getElementById('clearSearchBtn');
        const tbody = document.getElementById('brandTableBody');
        const visibleCount = document.getElementById('visibleCount');
        const totalCount = document.getElementById('totalCount');
        const footerVisibleCount = document.getElementById('footerVisibleCount');
        const footerTotalCount = document.getElementById('footerTotalCount');
        const searchInfo = document.getElementById('searchInfo');
        const searchResultCount = document.getElementById('searchResultCount');
        const paginationNav = document.getElementById('paginationNav');
        const noClientMatch = document.getElementById('noClientMatch');

        // Get current page from ViewBag
        const currentPage = @ViewBag.CurrentPage;

        // Escape HTML to prevent XSS
        function escapeHtml(text) {
        if (!text) return '';
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
        }

        // Toggle clear button visibility
        function toggleClearButton() {
        if (searchInput.value.trim().length > 0) {
        clearBtn.classList.add('show');
        } else {
        clearBtn.classList.remove('show');
        }
        }

        // Debounce function
        function debounce(func, delay) {
        let timeout;
        return function() {
        clearTimeout(timeout);
        timeout = setTimeout(() => func.apply(this, arguments), delay);
        };
        }

        // Render filtered brands
        function renderFilteredBrands(searchTerm) {
        if (!tbody) return;

        const trimmedTerm = searchTerm.trim();

        // If search is empty, reload the page to show server-side pagination
        if (trimmedTerm === "") {
        window.location.href = '@Url.Action("Index", new { page = -1 })'.replace('-1', currentPage);
        return;
        }

        const lowerSearch = trimmedTerm.toLowerCase();

        // Filter brands from all data
        const filtered = allBrandsForSearch.filter(b =>
        (b.brandName && b.brandName.toLowerCase().includes(lowerSearch)) ||
        (b.brandId && b.brandId.toString().includes(lowerSearch))
        );

        // Show search info
        searchInfo.classList.add('show');
        searchResultCount.textContent = `${filtered.length} result(s) found across all pages`;

        // Hide pagination when searching
        if (paginationNav) paginationNav.style.display = 'none';

        // Update counts
        const total = allBrandsForSearch.length;
        const shown = filtered.length;

        if (visibleCount) visibleCount.innerText = shown;
        if (totalCount) totalCount.innerText = total;
        if (footerVisibleCount) footerVisibleCount.innerText = shown;
        if (footerTotalCount) footerTotalCount.innerText = total;

        // Show clear button
        toggleClearButton();

        if (filtered.length === 0) {
        // Show no results row
        if (noClientMatch) {
        noClientMatch.style.display = '';
        }
        // Hide all other rows
        const rows = tbody.querySelectorAll('tr:not(#noClientMatch)');
        rows.forEach(row => row.style.display = 'none');
        return;
        }

        // Hide no results row
        if (noClientMatch) {
        noClientMatch.style.display = 'none';
        }

        // Build results HTML
        let html = '';
        filtered.forEach(function(b) {
        html += `
        <tr class="fade-in" data-id="${b.brandId}">
        <td data-label="ID">
        <span class="brand-id">#${b.brandId}</span>
        </td>
        <td data-label="Brand">
        <span class="brand-name">
        <span class="brand-dot"></span>
        ${escapeHtml(b.brandName)}
        </span>
        </td>
        <td data-label="Actions" class="text-center">
        <div class="action-group">
        <a href="/Brand/Details/${b.brandId}" class="btn-icon details" title="View Details">
        <i class="bi bi-eye"></i>
        </a>
        <a href="/Brand/Edit/${b.brandId}" class="btn-icon edit" title="Edit brand">
        <i class="bi bi-pencil"></i>
        </a>
        <a href="/Brand/Delete/${b.brandId}" class="btn-icon delete" title="Delete brand">
        <i class="bi bi-trash"></i>
        </a>
        </div>
        </td>
        </tr>
        `;
        });

        tbody.innerHTML = html;
        }

        // ── Event Listeners ──

        // Search input with debounce
        searchInput.addEventListener('input', debounce(function() {
        renderFilteredBrands(this.value);
        }, 300));

        // Clear button
        clearBtn.addEventListener('click', function() {
        window.location.href = '@Url.Action("Index", new { page = -1 })'.replace('-1', currentPage);
        });

        // Escape key to clear search
        searchInput.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
        clearBtn.click();
        }
        });

        // Enter key to search
        searchInput.addEventListener('keydown', function(e) {
        if (e.key === 'Enter') {
        e.preventDefault();
        renderFilteredBrands(this.value);
        }
        });

        // ── Initial state ──
        toggleClearButton();

        // If there's a search term from server, trigger client-side filter
        const currentSearchTerm = '@ViewBag.CurrentSearch';
        if (currentSearchTerm && currentSearchTerm.trim() !== '') {
        searchInput.value = currentSearchTerm;
        setTimeout(function() {
        renderFilteredBrands(currentSearchTerm);
        }, 100);
        }

        })();
    </script>

</body>
</html>