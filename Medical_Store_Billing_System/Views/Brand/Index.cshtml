@model IEnumerable<MedicalStore.Business.ViewModels.BrandVM>
@{
    ViewData["Title"] = "Brands";
    Layout = null;
    var allBrandsData = ViewBag.AllBrands as IEnumerable<MedicalStore.Business.ViewModels.BrandVM> ?? Model;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Medical Store</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" defer></script>

    <style>
        * {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: linear-gradient(135deg, #eef2f7 0%, #dce4ed 100%);
            padding: 30px;
            min-height: 100vh;
            display: flex;
            align-items: flex-start;
            justify-content: center;
            position: relative;
        }

        body::before {
            content: '';
            position: fixed;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle at 30% 20%, rgba(26, 74, 107, 0.03) 0%, transparent 50%),
                        radial-gradient(circle at 70% 80%, rgba(26, 74, 107, 0.03) 0%, transparent 50%);
            pointer-events: none;
            z-index: 0;
        }

        .brand-container {
            max-width: 1100px;
            width: 100%;
            margin: 0 auto;
            position: relative;
            z-index: 1;
        }

        /* ── Enhanced Header Styles ── */
        .page-header {
            background: linear-gradient(135deg, #0a2638 0%, #1a4a6b 50%, #2a6a8b 100%);
            border-radius: 28px;
            padding: 36px 42px;
            color: #fff;
            margin-bottom: 32px;
            position: relative;
            overflow: hidden;
            border: 1px solid rgba(255,255,255,.1);
            box-shadow: 0 15px 50px rgba(0,0,0,.18), 0 25px 70px rgba(11,42,62,.25);
            transform: translateY(0);
            transition: all 0.3s ease;
        }

        .page-header:hover {
            transform: translateY(-2px);
            box-shadow: 0 20px 60px rgba(0,0,0,.22), 0 30px 80px rgba(11,42,62,.3);
        }

        .page-header::before {
            content: '';
            position: absolute;
            top: -60%;
            right: -15%;
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, rgba(255,255,255,0.07) 0%, transparent 70%);
            pointer-events: none;
            animation: floatShapes 8s ease-in-out infinite;
        }

        .page-header::after {
            content: '';
            position: absolute;
            bottom: -40%;
            left: 10%;
            width: 300px;
            height: 300px;
            background: radial-gradient(circle, rgba(255,255,255,0.05) 0%, transparent 70%);
            pointer-events: none;
            animation: floatShapes 10s ease-in-out infinite reverse;
        }

        @@keyframes floatShapes {
            0%, 100% { transform: translate(0, 0) scale(1); }
            50% { transform: translate(20px, -20px) scale(1.1); }
        }

        .page-header .header-icon {
            width: 64px;
            height: 64px;
            background: rgba(255, 255, 255, 0.12);
            backdrop-filter: blur(10px);
            border-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 32px;
            flex-shrink: 0;
            border: 1px solid rgba(255,255,255,0.12);
            box-shadow: 0 8px 24px rgba(0,0,0,0.15);
            transition: all 0.3s ease;
        }

        .page-header:hover .header-icon {
            transform: rotate(-5deg) scale(1.05);
            background: rgba(255, 255, 255, 0.18);
        }

        .page-header h1 {
            font-weight: 800;
            font-size: 2rem;
            letter-spacing: -0.03em;
            margin: 0;
            background: linear-gradient(135deg, #ffffff 60%, rgba(255,255,255,0.7));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .page-header .subtitle {
            font-weight: 400;
            font-size: 1rem;
            opacity: 0.8;
            margin: 0;
            letter-spacing: 0.3px;
        }

        .page-header .badge-count {
            background: rgba(255, 255, 255, 0.12);
            backdrop-filter: blur(10px);
            padding: 8px 22px;
            border-radius: 50px;
            font-size: 0.9rem;
            font-weight: 600;
            letter-spacing: 0.5px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 4px 16px rgba(0,0,0,0.1);
            transition: all 0.3s ease;
        }

        .page-header:hover .badge-count {
            background: rgba(255, 255, 255, 0.18);
            transform: scale(1.02);
        }

        .btn-add {
            background: linear-gradient(135deg, #ffffff, #f0f5fa);
            border: none;
            padding: 12px 32px;
            border-radius: 50px;
            font-weight: 700;
            font-size: 0.95rem;
            color: #0a2638;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            white-space: nowrap;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            box-shadow: 0 6px 24px rgba(0, 0, 0, 0.2);
            text-decoration: none;
            position: relative;
            z-index: 1;
            letter-spacing: 0.3px;
        }

        .btn-add:hover {
            transform: translateY(-3px) scale(1.03);
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
            color: #0a2638;
            background: linear-gradient(135deg, #ffffff, #e8eff6);
        }

        .btn-add:active {
            transform: translateY(0) scale(0.98);
        }

        /* ── Enhanced Toolbar ── */
        .toolbar {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(16px);
            border-radius: 24px;
            padding: 20px 28px;
            margin-bottom: 28px;
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 16px;
            border: 1px solid rgba(255, 255, 255, 0.6);
            box-shadow: 0 10px 40px rgba(0,0,0,.06), 0 4px 12px rgba(0,0,0,.03);
            transition: all 0.3s ease;
        }

        .toolbar:hover {
            box-shadow: 0 15px 50px rgba(0,0,0,.08), 0 6px 16px rgba(0,0,0,.04);
            background: rgba(255, 255, 255, 0.92);
        }

        .search-container {
            flex: 1;
            min-width: 300px;
        }

        .search-container .search-wrapper {
            position: relative;
            width: 100%;
        }

        .search-container .search-wrapper input {
            width: 100%;
            padding: 13px 20px 13px 50px;
            background: rgba(255, 255, 255, 0.95);
            border: 2px solid #e9edf2;
            border-radius: 50px;
            color: #0a2638;
            font-size: 1rem;
            outline: none;
            transition: all 0.3s ease;
            font-weight: 500;
        }

        .search-container .search-wrapper input:focus {
            border-color: #1a4a6b;
            background: #ffffff;
            box-shadow: 0 0 0 5px rgba(26, 74, 107, 0.08), 0 8px 24px rgba(0,0,0,0.04);
            transform: scale(1.01);
        }

        .search-container .search-wrapper input::placeholder {
            color: #a5b9cd;
            font-weight: 400;
        }

        .search-container .search-wrapper .search-icon {
            position: absolute;
            left: 20px;
            top: 50%;
            transform: translateY(-50%);
            color: #8aadc9;
            font-size: 1.1rem;
            pointer-events: none;
            transition: color 0.3s ease;
        }

        .search-container .search-wrapper input:focus + .search-icon {
            color: #1a4a6b;
        }

        .clear-search-btn {
            background: linear-gradient(135deg, #ef4444, #dc2626);
            color: white;
            border: none;
            padding: 10px 24px;
            border-radius: 50px;
            cursor: pointer;
            font-size: 0.9rem;
            font-weight: 600;
            transition: all 0.3s ease;
            display: none;
            align-items: center;
            gap: 8px;
            white-space: nowrap;
            box-shadow: 0 4px 16px rgba(239, 68, 68, 0.25);
            letter-spacing: 0.3px;
        }

        .clear-search-btn:hover {
            transform: translateY(-2px) scale(1.04);
            box-shadow: 0 8px 28px rgba(239, 68, 68, 0.35);
            background: linear-gradient(135deg, #dc2626, #b91c1c);
        }

        .clear-search-btn:active {
            transform: translateY(0) scale(0.96);
        }

        .clear-search-btn.show {
            display: inline-flex;
        }

        /* ── Enhanced Table ── */
        .brand-card {
            background: rgba(255, 255, 255, 0.92);
            backdrop-filter: blur(12px);
            border-radius: 24px;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.5);
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 15px 50px rgba(0,0,0,.06), 0 6px 18px rgba(0,0,0,.03);
        }

        .brand-card:hover {
            box-shadow: 0 25px 70px rgba(0,0,0,.10), 0 8px 24px rgba(0,0,0,.05);
            transform: translateY(-2px);
        }

        .table-brand {
            margin: 0;
            font-size: 0.95rem;
        }

        .table-brand thead {
            background: linear-gradient(135deg, #f8fafc, #eef2f7);
            border-bottom: 2px solid #e5e9ef;
        }

        .table-brand thead th {
            font-weight: 700;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #4a6a8a;
            padding: 20px 24px;
            border: 0;
            position: relative;
        }

        .table-brand thead th::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 0;
            height: 2px;
            background: linear-gradient(90deg, #1a4a6b, transparent);
            transition: width 0.3s ease;
        }

        .table-brand thead:hover th::after {
            width: 60%;
        }

        .table-brand tbody td {
            padding: 18px 24px;
            vertical-align: middle;
            border-bottom: 1px solid #f0f3f7;
            background: transparent;
            transition: all 0.2s ease;
        }

        .table-brand tbody tr {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            cursor: default;
        }

        .table-brand tbody tr:hover {
            background: rgba(26, 74, 107, 0.04);
            transform: scale(1.003);
            box-shadow: 0 4px 20px rgba(0,0,0,0.02);
        }

        .table-brand tbody tr:last-child td {
            border-bottom: 0;
        }

        .brand-id {
            font-weight: 700;
            color: #5a7a9a;
            font-size: 0.85rem;
            background: #eef2f7;
            padding: 6px 16px;
            border-radius: 50px;
            display: inline-block;
            letter-spacing: 0.5px;
            transition: all 0.3s ease;
        }

        .table-brand tbody tr:hover .brand-id {
            background: #dce4ed;
            color: #1a4a6b;
            transform: scale(1.02);
        }

        .brand-name {
            font-weight: 700;
            color: #0a2638;
            font-size: 1.05rem;
            display: flex;
            align-items: center;
            gap: 14px;
            letter-spacing: -0.3px;
        }

        .brand-name .brand-dot {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            display: inline-block;
            flex-shrink: 0;
            background: linear-gradient(135deg, #34a853, #1a7a3a);
            animation: pulse-dot 2.5s ease-in-out infinite;
            box-shadow: 0 2px 8px rgba(52, 168, 83, 0.3);
        }

        @@keyframes pulse-dot {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.5; transform: scale(0.85); box-shadow: 0 2px 12px rgba(52, 168, 83, 0.5); }
        }

        /* ── Enhanced Actions ── */
        .action-group {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

        .action-group .btn-icon {
            width: 42px;
            height: 42px;
            padding: 0;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 14px;
            font-size: 1.05rem;
            border: 0;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            background: transparent;
            color: #7a93ab;
            text-decoration: none;
            position: relative;
        }

        .action-group .btn-icon:hover {
            transform: translateY(-3px) scale(1.08);
        }

        .action-group .btn-icon::after {
            content: attr(title);
            position: absolute;
            bottom: -28px;
            left: 50%;
            transform: translateX(-50%) scale(0);
            background: #0a2638;
            color: white;
            padding: 4px 12px;
            border-radius: 8px;
            font-size: 0.7rem;
            font-weight: 500;
            white-space: nowrap;
            opacity: 0;
            transition: all 0.3s ease;
            pointer-events: none;
        }

        .action-group .btn-icon:hover::after {
            transform: translateX(-50%) scale(1);
            opacity: 1;
        }

        .action-group .btn-icon.details:hover {
            background: #e8f4fd;
            color: #0d6efd;
            box-shadow: 0 6px 20px rgba(13, 110, 253, 0.2);
        }

        .action-group .btn-icon.edit:hover {
            background: #e8f0fe;
            color: #1a73e8;
            box-shadow: 0 6px 20px rgba(26, 115, 232, 0.2);
        }

        .action-group .btn-icon.delete:hover {
            background: #fde8e8;
            color: #d93025;
            box-shadow: 0 6px 20px rgba(217, 48, 37, 0.2);
        }

        /* ── Footer ── */
        .card-footer-custom {
            background: rgba(248, 250, 252, 0.9);
            padding: 18px 28px;
            border-top: 1px solid #e5e9ef;
            font-size: 0.9rem;
            color: #5a7a9a;
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
        }

        .card-footer-custom .total-badge {
            background: #eef2f7;
            padding: 6px 20px;
            border-radius: 50px;
            font-weight: 600;
            font-size: 0.85rem;
            color: #2a5a7a;
            transition: all 0.3s ease;
        }

        .card-footer-custom .total-badge:hover {
            background: #dce4ed;
            transform: scale(1.02);
        }

        /* ── Empty State ── */
        .empty-state {
            padding: 70px 20px;
            text-align: center;
        }

        .empty-state .empty-icon {
            font-size: 72px;
            color: #c5d5e5;
            display: block;
            margin-bottom: 24px;
            animation: float 4s ease-in-out infinite;
        }

        @@keyframes float {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-12px) rotate(2deg); }
        }

        .empty-state h6 {
            font-weight: 800;
            color: #1a3a5a;
            font-size: 1.3rem;
            margin-bottom: 10px;
            letter-spacing: -0.5px;
        }

        .empty-state p {
            color: #7a93ab;
            font-size: 1rem;
            max-width: 400px;
            margin: 0 auto 24px;
            line-height: 1.6;
        }

        .empty-state .btn-outline-primary {
            border-radius: 50px;
            padding: 10px 28px;
            font-weight: 600;
            border-color: #1a4a6b;
            color: #1a4a6b;
            transition: all 0.3s ease;
        }

        .empty-state .btn-outline-primary:hover {
            background: #1a4a6b;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(26, 74, 107, 0.25);
        }

        /* ── Pagination ── */
        .pagination .page-link {
            color: #1a4a6b;
            border-radius: 12px;
            margin: 0 5px;
            border: 2px solid #e5e9ef;
            padding: 12px 20px;
            font-weight: 600;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            background: transparent;
        }

        .pagination .page-link:hover {
            background: #f0f4f9;
            border-color: #1a4a6b;
            transform: translateY(-3px);
            box-shadow: 0 6px 20px rgba(26, 74, 107, 0.12);
        }

        .pagination .page-item.active .page-link {
            background: linear-gradient(135deg, #1a4a6b, #0a2638);
            border-color: #1a4a6b;
            color: #fff;
            box-shadow: 0 6px 24px rgba(26, 74, 107, 0.25);
        }

        .pagination .page-item.disabled .page-link {
            color: #b0c8dd;
            cursor: not-allowed;
            opacity: 0.5;
        }

        /* ── Animations ── */
        .fade-in {
            animation: fadeInUp 0.6s cubic-bezier(0.4, 0, 0.2, 1) forwards;
            opacity: 0;
        }

        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px) scale(0.98);
            }
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        .fade-in:nth-child(1) { animation-delay: 0.03s; }
        .fade-in:nth-child(2) { animation-delay: 0.06s; }
        .fade-in:nth-child(3) { animation-delay: 0.09s; }
        .fade-in:nth-child(4) { animation-delay: 0.12s; }
        .fade-in:nth-child(5) { animation-delay: 0.15s; }
        .fade-in:nth-child(6) { animation-delay: 0.18s; }
        .fade-in:nth-child(7) { animation-delay: 0.21s; }
        .fade-in:nth-child(8) { animation-delay: 0.24s; }
        .fade-in:nth-child(9) { animation-delay: 0.27s; }
        .fade-in:nth-child(10) { animation-delay: 0.30s; }

        #noClientMatch {
            display: none;
        }

        /* ── Toast Notification ── */
        .toast-container {
            position: fixed;
            bottom: 30px;
            right: 30px;
            z-index: 9999;
        }

        .toast-message {
            background: rgba(10, 38, 56, 0.95);
            backdrop-filter: blur(12px);
            color: white;
            padding: 16px 28px;
            border-radius: 16px;
            box-shadow: 0 15px 50px rgba(0,0,0,0.2);
            font-weight: 500;
            transform: translateY(100px);
            opacity: 0;
            transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
            border: 1px solid rgba(255,255,255,0.1);
        }

        .toast-message.show {
            transform: translateY(0);
            opacity: 1;
        }

        /* ── Responsive ── */
        @@media (max-width: 992px) {
            .page-header {
                padding: 28px 24px;
            }
            
            .page-header h1 {
                font-size: 1.6rem;
            }
        }

        @@media (max-width: 768px) {
            body {
                padding: 16px;
            }

            .page-header {
                padding: 24px 18px;
                border-radius: 20px;
                flex-wrap: wrap;
            }

            .page-header h1 {
                font-size: 1.4rem;
            }

            .page-header .header-icon {
                width: 52px;
                height: 52px;
                font-size: 24px;
            }

            .page-header .badge-count {
                font-size: 0.8rem;
                padding: 6px 14px;
                margin-top: 4px;
            }

            .btn-add {
                padding: 10px 24px;
                font-size: 0.9rem;
                width: 100%;
                justify-content: center;
            }

            .toolbar {
                padding: 16px 18px;
                border-radius: 18px;
                flex-direction: column;
                align-items: stretch;
                gap: 14px;
            }

            .search-container {
                min-width: 100%;
            }

            .clear-search-btn {
                width: 100%;
                justify-content: center;
            }

            .brand-card {
                border-radius: 18px;
            }

            .table-brand thead {
                display: none;
            }

            .table-brand tbody tr {
                display: block;
                padding: 20px 16px 16px;
                border-bottom: 1px solid #eef2f6;
                background: transparent;
            }

            .table-brand tbody tr:last-child {
                border-bottom: 0;
            }

            .table-brand tbody td {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 8px 0;
                border: 0;
                background: transparent;
                font-size: 0.95rem;
            }

            .table-brand tbody td::before {
                content: attr(data-label);
                font-weight: 700;
                color: #5a7a9a;
                font-size: 0.8rem;
                text-transform: uppercase;
                letter-spacing: 0.8px;
            }

            .table-brand tbody td:first-child {
                padding-top: 0;
            }

            .table-brand tbody td:last-child {
                padding-bottom: 0;
                border-top: 1px solid #f0f3f7;
                margin-top: 12px;
                padding-top: 14px;
                justify-content: center;
            }

            .table-brand tbody td:last-child::before {
                display: none;
            }

            .action-group .btn-icon {
                width: 48px;
                height: 48px;
                font-size: 1.15rem;
            }

            .action-group .btn-icon::after {
                display: none;
            }

            .card-footer-custom {
                flex-direction: column;
                text-align: center;
                padding: 16px 18px;
                gap: 8px;
            }

            .empty-state {
                padding: 44px 16px;
            }

            .empty-state .empty-icon {
                font-size: 52px;
            }

            .pagination .page-link {
                padding: 10px 14px;
                font-size: 0.9rem;
            }
        }

        @@media (max-width: 400px) {
            .page-header h1 {
                font-size: 1.2rem;
            }

            .page-header .subtitle {
                font-size: 0.85rem;
            }

            .page-header {
                padding: 18px 14px;
            }
        }

        /* Scrollbar Styling */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }

        ::-webkit-scrollbar-track {
            background: #eef2f7;
            border-radius: 10px;
        }

        ::-webkit-scrollbar-thumb {
            background: #c5d5e5;
            border-radius: 10px;
            transition: background 0.3s ease;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: #8aadc9;
        }
    </style>
</head>

<body>
    <div class="brand-container">
        <!-- ─── HEADER ─── -->
        <div class="page-header d-flex flex-wrap align-items-center gap-3">
            <div class="header-icon">
                <i class="bi bi-award-fill"></i>
            </div>
            <div class="flex-grow-1">
                <h1 class="d-flex align-items-center gap-3 flex-wrap">
                    Brands
                    <span class="badge-count">
                        <i class="bi bi-database me-1"></i>
                        @ViewBag.TotalRecords results
                    </span>
                </h1>
                <p class="subtitle">Manage your product brands and manufacturers</p>
            </div>
            <a asp-action="Create" class="btn-add">
                <i class="bi bi-plus-lg"></i> Add Brand
            </a>
        </div>

        <!-- ─── TOOLBAR ─── -->
        <div class="toolbar">
            <div class="search-container">
                <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap; width: 100%;">
                    <div class="search-wrapper" style="flex: 1; min-width: 250px;">
                        <input type="text" id="brandSearchInput"
                               placeholder="Search by name or ID..."
                               autocomplete="off"
                               value="@ViewBag.CurrentSearch" />
                        <i class="fa-solid fa-magnifying-glass search-icon"></i>
                    </div>
                    <button type="button" id="clearSearchBtn" class="clear-search-btn">
                        <i class="fa-solid fa-times"></i> Clear
                    </button>
                </div>
            </div>

            <div class="d-flex align-items-center gap-3 ms-auto flex-wrap">
                <span class="text-muted small" id="resultCount" style="font-weight: 500;">
                    Showing <strong id="visibleCount">@ViewBag.TotalRecords</strong> of <strong id="totalCount">@ViewBag.TotalRecords</strong> brands
                </span>
            </div>
        </div>

        <!-- ─── TABLE ─── -->
        <div class="brand-card">
            <div class="table-responsive">
                <table class="table table-brand" id="brandTable">
                    <thead>
                        <tr>
                            <th style="width:100px">ID</th>
                            <th>Brand Name</th>
                            <th style="width:220px" class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="brandTableBody">
                        @if (!Model.Any())
                        {
                            <tr id="serverEmptyState">
                                <td colspan="3">
                                    <div class="empty-state">
                                        @if (!string.IsNullOrEmpty(ViewBag.CurrentSearch))
                                        {
                                            <i class="bi bi-search empty-icon"></i>
                                            <h6>No matching brands</h6>
                                            <p>No brands found matching "<strong>@ViewBag.CurrentSearch</strong>". Try adjusting your search.</p>
                                            <a asp-action="Index" class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-arrow-left me-1"></i> Clear Search
                                            </a>
                                        }
                                        else
                                        {
                                            <i class="bi bi-inbox empty-icon"></i>
                                            <h6>No brands yet</h6>
                                            <p>Get started by adding your first brand. Click <strong>Add Brand</strong> above.</p>
                                            <a asp-action="Create" class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-plus-lg me-1"></i> Create Brand
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr class="fade-in"
                                    data-search="@item.BrandName.ToLower() @item.BrandId">
                                    <td data-label="ID">
                                        <span class="brand-id">#@item.BrandId</span>
                                    </td>
                                    <td data-label="Brand">
                                        <span class="brand-name">
                                            <span class="brand-dot"></span>
                                            @item.BrandName
                                        </span>
                                    </td>
                                    <td data-label="Actions" class="text-center">
                                        <div class="action-group">
                                            <a asp-action="Details" asp-route-id="@item.BrandId"
                                               class="btn-icon details" title="View Details">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.BrandId"
                                               class="btn-icon edit" title="Edit brand">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.BrandId"
                                               class="btn-icon delete" title="Delete brand">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                            <tr id="noClientMatch" style="display:none;">
                                <td colspan="3">
                                    <div class="empty-state">
                                        <i class="bi bi-search empty-icon"></i>
                                        <h6>No matching brands</h6>
                                        <p>No brands found matching your search across all pages.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="card-footer-custom">
                <span>
                    <i class="bi bi-list-ul me-1"></i>
                    Showing <strong id="footerVisibleCount">@ViewBag.TotalRecords</strong> of <strong id="footerTotalCount">@ViewBag.TotalRecords</strong> brands
                </span>
                <span class="total-badge">
                    <i class="bi bi-clock-history me-1"></i> Updated just now
                </span>
            </div>
        </div>

        <!-- ─── PAGINATION ─── -->
        @if (ViewBag.TotalPages > 1)
        {
            <nav class="mt-4" id="paginationNav">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-page="@(ViewBag.CurrentPage - 1)"
                           asp-route-searchTerm="@ViewBag.CurrentSearch">
                            <i class="bi bi-chevron-left"></i> Previous
                        </a>
                    </li>

                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-page="@i"
                               asp-route-searchTerm="@ViewBag.CurrentSearch">@i</a>
                        </li>
                    }

                    <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-page="@(ViewBag.CurrentPage + 1)"
                           asp-route-searchTerm="@ViewBag.CurrentSearch">
                            Next <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        }

        <!-- ─── FOOTER ─── -->
        <div class="text-center text-muted small mt-4 opacity-50" style="font-size:0.8rem; letter-spacing: 0.5px;">
            <i class="bi bi-shield-check me-1"></i> Secure · Medical Store Management
        </div>
    </div>

    <!-- ─── SCRIPTS ─── -->
    <script>
        (function() {
            'use strict';

            const allBrandsForSearch = @Html.Raw(Json.Serialize(allBrandsData));
            const searchInput = document.getElementById('brandSearchInput');
            const clearBtn = document.getElementById('clearSearchBtn');
            const tbody = document.getElementById('brandTableBody');
            const visibleCount = document.getElementById('visibleCount');
            const totalCount = document.getElementById('totalCount');
            const footerVisibleCount = document.getElementById('footerVisibleCount');
            const footerTotalCount = document.getElementById('footerTotalCount');
            const paginationNav = document.getElementById('paginationNav');
            const noClientMatch = document.getElementById('noClientMatch');
            const currentPage = @ViewBag.CurrentPage;

            let searchTimeout;

            function escapeHtml(text) {
                if (!text) return '';
                const div = document.createElement('div');
                div.textContent = text;
                return div.innerHTML;
            }

            function toggleClearButton() {
                if (searchInput.value.trim().length > 0) {
                    clearBtn.classList.add('show');
                } else {
                    clearBtn.classList.remove('show');
                }
            }

            function showToast(message, type) {
                const existingToast = document.querySelector('.toast-container');
                if (existingToast) {
                    existingToast.remove();
                }

                const container = document.createElement('div');
                container.className = 'toast-container';
                const toast = document.createElement('div');
                toast.className = 'toast-message';
                toast.innerHTML = `<i class="bi bi-${type === 'success' ? 'check-circle' : 'info-circle'} me-2"></i> ${message}`;
                container.appendChild(toast);
                document.body.appendChild(container);

                // Trigger animation
                setTimeout(() => toast.classList.add('show'), 10);

                // Auto-hide after 3 seconds
                setTimeout(() => {
                    toast.classList.remove('show');
                    setTimeout(() => container.remove(), 500);
                }, 3000);
            }

            function renderFilteredBrands(searchTerm) {
                if (!tbody) return;

                const trimmedTerm = searchTerm.trim();

                if (trimmedTerm === "") {
                    window.location.href = '@Url.Action("Index", new { page = -1 })'.replace('-1', currentPage);
                    return;
                }

                const lowerSearch = trimmedTerm.toLowerCase();

                const filtered = allBrandsForSearch.filter(b =>
                    (b.brandName && b.brandName.toLowerCase().includes(lowerSearch)) ||
                    (b.brandId && b.brandId.toString().includes(lowerSearch))
                );

                if (paginationNav) {
                    paginationNav.style.display = 'none';
                }

                const total = allBrandsForSearch.length;
                const shown = filtered.length;

                if (visibleCount) visibleCount.innerText = shown;
                if (totalCount) totalCount.innerText = total;
                if (footerVisibleCount) footerVisibleCount.innerText = shown;
                if (footerTotalCount) footerTotalCount.innerText = total;

                toggleClearButton();

                if (filtered.length === 0) {
                    if (noClientMatch) {
                        noClientMatch.style.display = '';
                    }
                    const rows = tbody.querySelectorAll('tr:not(#noClientMatch)');
                    rows.forEach(row => row.style.display = 'none');
                    
                    // Show toast for no results
                    showToast('No brands found matching your search', 'info');
                    return;
                }

                if (noClientMatch) {
                    noClientMatch.style.display = 'none';
                }

                let html = '';
                filtered.forEach(function(b, index) {
                    const delay = Math.min(index * 0.03, 0.3);
                    html += `
                        <tr class="fade-in" data-id="${b.brandId}" style="animation-delay: ${delay}s">
                            <td data-label="ID">
                                <span class="brand-id">#${b.brandId}</span>
                            </td>
                            <td data-label="Brand">
                                <span class="brand-name">
                                    <span class="brand-dot"></span>
                                    ${escapeHtml(b.brandName)}
                                </span>
                            </td>
                            <td data-label="Actions" class="text-center">
                                <div class="action-group">
                                    <a href="/Brand/Details/${b.brandId}" class="btn-icon details" title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a href="/Brand/Edit/${b.brandId}" class="btn-icon edit" title="Edit brand">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a href="/Brand/Delete/${b.brandId}" class="btn-icon delete" title="Delete brand">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    `;
                });

                tbody.innerHTML = html;
                
                // Show toast with result count
                if (shown > 0) {
                    showToast(`Found ${shown} brand${shown > 1 ? 's' : ''} matching your search`, 'success');
                }
            }

            // ── Event Listeners ──

            searchInput.addEventListener('input', function() {
                clearTimeout(searchTimeout);
                searchTimeout = setTimeout(() => {
                    renderFilteredBrands(this.value);
                }, 300);
            });

            clearBtn.addEventListener('click', function() {
                window.location.href = '@Url.Action("Index", new { page = -1 })'.replace('-1', currentPage);
            });

            searchInput.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') {
                    clearBtn.click();
                }
                if (e.key === 'Enter') {
                    e.preventDefault();
                    clearTimeout(searchTimeout);
                    renderFilteredBrands(this.value);
                }
            });

            // ── Initial state ──
            toggleClearButton();

            const currentSearchTerm = '@ViewBag.CurrentSearch';
            if (currentSearchTerm && currentSearchTerm.trim() !== '') {
                searchInput.value = currentSearchTerm;
                setTimeout(function() {
                    renderFilteredBrands(currentSearchTerm);
                }, 150);
            }

            // ── Keyboard shortcuts ──
            document.addEventListener('keydown', function(e) {
                // Ctrl+F or Cmd+F to focus search
                if ((e.ctrlKey || e.metaKey) && e.key === 'f') {
                    e.preventDefault();
                    searchInput.focus();
                    searchInput.select();
                }
                // Escape to clear
                if (e.key === 'Escape' && document.activeElement === searchInput) {
                    if (searchInput.value.trim() !== '') {
                        clearBtn.click();
                    }
                }
            });

            console.log('🏷️ Brands Management System loaded successfully!');
            console.log(`📊 Total brands: ${allBrandsForSearch.length}`);
        })();
    </script>
</body>
</html>