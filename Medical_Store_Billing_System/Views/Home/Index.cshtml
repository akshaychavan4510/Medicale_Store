@{
    ViewData["Title"] = "Dashboard";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MediStore — Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <style>
        /* ─────────────────────────────────────────
        TOKENS
        ───────────────────────────────────────── */
        :root {
        --green-900: #0b2318;
        --green-800: #133320;
        --green-700: #1a4a2e;
        --green-500: #198754;
        --green-400: #34b86a;
        --green-100: rgba(25,135,84,.10);
        --green-glow: rgba(25,135,84,.18);
        --surface: #f0f4f1;
        --card-bg: rgba(255,255,255,.92);
        --card-border: rgba(0,0,0,.07);
        --text-primary: #0f1c14;
        --text-secondary: #5c7a67;
        --text-muted: #8aab97;
        --blue: #0d6efd;
        --red: #dc3545;
        --orange: #fd7e14;
        --cyan: #0dcaf0;
        --radius-sm: 10px;
        --radius-md: 16px;
        --radius-lg: 22px;
        --sidebar-w: 260px;
        --header-h: 62px;
        --shadow-sm: 0 2px 8px rgba(0,0,0,.07);
        --shadow-md: 0 6px 24px rgba(0,0,0,.10);
        --shadow-lg: 0 14px 44px rgba(0,0,0,.13);
        --transition: all .22s cubic-bezier(.4,0,.2,1);
        }

        /* ─────────────────────────────────────────
        RESET / BASE
        ───────────────────────────────────────── */
        *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
        }

        html {
        scroll-behavior: smooth;
        }

        body {
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        background: var(--surface);
        color: var(--text-primary);
        min-height: 100vh;
        }

        /* ─────────────────────────────────────────
        SCROLLBAR
        ───────────────────────────────────────── */
        ::-webkit-scrollbar {
        width: 5px;
        }

        ::-webkit-scrollbar-track {
        background: transparent;
        }

        ::-webkit-scrollbar-thumb {
        background: var(--green-500);
        border-radius: 10px;
        }

        ::-webkit-scrollbar-thumb:hover {
        background: var(--green-700);
        }

        /* ─────────────────────────────────────────
        TOP HEADER
        ───────────────────────────────────────── */
        .top-header {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        height: var(--header-h);
        background: linear-gradient(135deg, var(--green-900) 0%, var(--green-800) 100%);
        border-bottom: 1px solid rgba(255,255,255,.06);
        box-shadow: 0 4px 24px rgba(0,0,0,.28);
        z-index: 1050;
        display: flex;
        align-items: center;
        padding: 0 24px;
        gap: 12px;
        }

        .header-hamburger {
        background: rgba(255,255,255,.08);
        border: 1px solid rgba(255,255,255,.14);
        color: #fff;
        border-radius: var(--radius-sm);
        width: 38px;
        height: 38px;
        font-size: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: var(--transition);
        flex-shrink: 0;
        }

        .header-hamburger:hover {
        background: rgba(255,255,255,.18);
        box-shadow: 0 4px 14px rgba(0,0,0,.3);
        }

        .header-brand {
        display: flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        }

        .header-brand-icon {
        background: rgba(255,255,255,.12);
        border-radius: 11px;
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        color: var(--green-400);
        transition: var(--transition);
        }

        .header-brand-icon:hover {
        transform: rotate(-6deg) scale(1.08);
        }

        .header-brand-name {
        font-size: 17px;
        font-weight: 700;
        color: #fff;
        line-height: 1.2;
        }

        .header-brand-sub {
        font-size: 9px;
        color: rgba(255,255,255,.4);
        letter-spacing: 1.6px;
        text-transform: uppercase;
        display: block;
        }

        .header-spacer {
        flex: 1;
        }

        .header-pill {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 5px 13px;
        border-radius: 30px;
        font-size: 12px;
        font-weight: 600;
        border: 1px solid;
        }

        .header-pill-online {
        background: rgba(52,184,106,.14);
        border-color: rgba(52,184,106,.3);
        color: var(--green-400);
        }

        .header-pill-date {
        background: rgba(255,255,255,.07);
        border-color: rgba(255,255,255,.12);
        color: rgba(255,255,255,.72);
        }

        @@keyframes pulse {
        0%, 100% {
        opacity: 1;
        }

        50% {
        opacity: .3;
        }
        }

        .pulse-dot {
        font-size: 7px;
        animation: pulse 2.2s ease-in-out infinite;
        }

        .header-avatar {
        background: var(--green-500);
        border: 2px solid rgba(255,255,255,.22);
        border-radius: 50%;
        width: 34px;
        height: 34px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-weight: 700;
        font-size: 13px;
        cursor: pointer;
        transition: var(--transition);
        }

        .header-avatar:hover {
        border-color: rgba(255,255,255,.55);
        transform: scale(1.08);
        }

        .header-logout-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(220,53,69,.16);
        border: 1.5px solid rgba(220,53,69,.4);
        color: #ff8a94;
        border-radius: var(--radius-sm);
        padding: 6px 13px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: var(--transition);
        white-space: nowrap;
        }

        .header-logout-btn:hover {
        background: rgba(220,53,69,.32);
        border-color: rgba(220,53,69,.75);
        color: #fff;
        transform: translateY(-1px);
        box-shadow: 0 4px 14px rgba(220,53,69,.3);
        }

        /* ─────────────────────────────────────────
        MOBILE SIDEBAR OFFCANVAS
        ───────────────────────────────────────── */
        .offcanvas.bg-sidebar {
        background: linear-gradient(180deg, var(--green-900) 0%, var(--green-800) 100%) !important;
        }

        .mobile-nav-link {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 14px;
        border-radius: 11px;
        color: rgba(255,255,255,.65);
        text-decoration: none;
        font-size: 14px;
        font-weight: 500;
        transition: var(--transition);
        margin-bottom: 2px;
        }

        .mobile-nav-link i {
        font-size: 17px;
        flex-shrink: 0;
        }

        .mobile-nav-link:hover,
        .mobile-nav-link.active {
        background: rgba(255,255,255,.10);
        color: #fff;
        }

        /* ─────────────────────────────────────────
        LAYOUT SHELL
        ───────────────────────────────────────── */
        .app-shell {
        display: flex;
        min-height: 100vh;
        padding-top: var(--header-h);
        }

        /* ─────────────────────────────────────────
        DESKTOP SIDEBAR
        ───────────────────────────────────────── */
        .sidebar {
        width: var(--sidebar-w);
        position: fixed;
        top: var(--header-h);
        left: 0;
        bottom: 0;
        background: linear-gradient(180deg, var(--green-900) 0%, var(--green-800) 100%);
        color: #fff;
        display: flex;
        flex-direction: column;
        padding: 20px 14px 16px;
        overflow-y: auto;
        z-index: 999;
        border-right: 1px solid rgba(255,255,255,.05);
        box-shadow: 4px 0 28px rgba(0,0,0,.18);
        }

        .sidebar::-webkit-scrollbar {
        width: 3px;
        }

        .sidebar::-webkit-scrollbar-thumb {
        background: rgba(255,255,255,.15);
        }

        /* Search */
        .sidebar-search {
        display: flex;
        align-items: center;
        gap: 10px;
        background: rgba(255,255,255,.07);
        border: 1px solid transparent;
        border-radius: 30px;
        padding: 7px 14px;
        margin-bottom: 20px;
        transition: var(--transition);
        position: relative;
        }

        .sidebar-search:focus-within {
        background: rgba(255,255,255,.12);
        border-color: rgba(255,255,255,.22);
        box-shadow: 0 0 0 3px rgba(255,255,255,.04);
        }

        .sidebar-search i {
        color: rgba(255,255,255,.38);
        font-size: 14px;
        flex-shrink: 0;
        }

        .sidebar-search input {
        background: transparent;
        border: none;
        outline: none;
        color: #fff;
        font-size: 13px;
        flex: 1;
        }

        .sidebar-search input::placeholder {
        color: rgba(255,255,255,.33);
        }

        .clear-btn {
        background: transparent;
        border: none;
        color: rgba(255,255,255,.4);
        cursor: pointer;
        font-size: 13px;
        display: none;
        padding: 2px 4px;
        border-radius: 4px;
        transition: color .2s;
        }

        .clear-btn:hover {
        color: #fff;
        }

        /* Nav section label */
        .nav-label {
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 2px;
        color: rgba(255,255,255,.32);
        text-transform: uppercase;
        padding: 0 4px 8px;
        }

        /* Nav items */
        .sidebar-nav {
        list-style: none;
        flex: 1;
        }

        .sidebar-nav li {
        margin-bottom: 1px;
        }

        .sidebar-nav a {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 9px 14px;
        border-radius: 11px;
        color: rgba(255,255,255,.6);
        text-decoration: none;
        font-size: 13.5px;
        font-weight: 500;
        transition: var(--transition);
        position: relative;
        }

        .sidebar-nav a i {
        font-size: 17px;
        width: 22px;
        text-align: center;
        flex-shrink: 0;
        }

        .sidebar-nav a:hover {
        background: rgba(255,255,255,.08);
        color: #fff;
        transform: translateX(3px);
        }

        .sidebar-nav li.active > a {
        background: rgba(52,184,106,.18);
        color: #fff;
        box-shadow: 0 4px 16px rgba(0,0,0,.18);
        }

        .sidebar-nav li.active > a::before {
        content: '';
        position: absolute;
        left: 0;
        top: 18%;
        height: 64%;
        width: 3px;
        background: var(--green-400);
        border-radius: 0 4px 4px 0;
        }

        .nav-divider {
        border-top: 1px solid rgba(255,255,255,.07);
        margin: 12px 0 14px;
        }

        .sidebar-logout-btn {
        width: 100%;
        background: rgba(220,53,69,.16);
        border: 1.5px solid rgba(220,53,69,.35);
        color: #ff8a94;
        border-radius: 11px;
        padding: 9px 14px;
        font-size: 13.5px;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 10px;
        cursor: pointer;
        transition: var(--transition);
        }

        .sidebar-logout-btn:hover {
        background: rgba(220,53,69,.3);
        color: #fff;
        box-shadow: 0 6px 20px rgba(220,53,69,.3);
        }

        /* ─────────────────────────────────────────
        MAIN CONTENT
        ───────────────────────────────────────── */
        .main-content {
        flex: 1;
        margin-left: var(--sidebar-w);
        padding: 28px 30px 0;
        min-height: calc(100vh - var(--header-h));
        display: flex;
        flex-direction: column;
        }

        /* ── Welcome Banner ── */
        .welcome-banner {
        background: var(--card-bg);
        backdrop-filter: blur(16px);
        border-radius: var(--radius-lg);
        padding: 22px 28px;
        margin-bottom: 28px;
        border: 1px solid rgba(255,255,255,.7);
        box-shadow: var(--shadow-md), inset 0 1px 0 rgba(255,255,255,.85);
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        }

        .welcome-banner h2 {
        font-size: 22px;
        font-weight: 700;
        color: var(--green-700);
        margin: 0;
        }

        .welcome-banner p {
        color: var(--text-secondary);
        font-size: 14px;
        margin: 3px 0 0;
        }

        .welcome-tag {
        background: var(--green-100);
        border: 1px solid rgba(25,135,84,.18);
        color: var(--green-500);
        font-size: 12px;
        font-weight: 600;
        padding: 5px 14px;
        border-radius: 30px;
        white-space: nowrap;
        }

        /* ── Stat Cards ── */
        .stat-card {
        border-radius: var(--radius-md);
        color: #fff;
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 16px;
        min-height: 108px;
        position: relative;
        overflow: hidden;
        transition: var(--transition);
        box-shadow: var(--shadow-md);
        }

        .stat-card::after {
        content: '';
        position: absolute;
        top: -30%;
        right: -15%;
        width: 140px;
        height: 140px;
        background: rgba(255,255,255,.07);
        border-radius: 50%;
        pointer-events: none;
        }

        .stat-card:hover {
        transform: translateY(-6px) scale(1.015);
        box-shadow: var(--shadow-lg);
        }

        .stat-icon {
        width: 52px;
        height: 52px;
        background: rgba(255,255,255,.18);
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        flex-shrink: 0;
        }

        .stat-body h3 {
        font-size: 28px;
        font-weight: 700;
        line-height: 1.1;
        }

        .stat-body p {
        font-size: 12.5px;
        opacity: .8;
        margin: 0;
        font-weight: 500;
        }

        .stat-trend {
        font-size: 11px;
        font-weight: 700;
        background: rgba(255,255,255,.2);
        padding: 2px 9px 2px 5px;
        border-radius: 30px;
        display: inline-flex;
        align-items: center;
        gap: 1px;
        margin-top: 5px;
        }

        .stat-trend.up {
        color: #d4fde4;
        }

        .stat-trend.down {
        color: #ffd6da;
        }

        .stat-trend i {
        font-size: 15px;
        }

        .sc-blue {
        background: linear-gradient(135deg, #0d6efd 0%, #4a90e2 100%);
        }

        .sc-red {
        background: linear-gradient(135deg, #dc3545 0%, #f0626e 100%);
        }

        .sc-green {
        background: linear-gradient(135deg, #198754 0%, #34b86a 100%);
        }

        .sc-orange {
        background: linear-gradient(135deg, #fd7e14 0%, #ffa94d 100%);
        }

        /* ── Section Heading ── */
        .section-title {
        font-size: 16px;
        font-weight: 700;
        color: var(--text-primary);
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 0 0 4px;
        }

        .section-title .dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--green-500);
        flex-shrink: 0;
        }

        .section-sub {
        font-size: 12.5px;
        color: var(--text-muted);
        }

        /* ── Quick Access Cards ── */
        .qa-card {
        background: var(--card-bg);
        border: 1.5px solid var(--card-border);
        border-radius: var(--radius-md);
        text-decoration: none;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 16px 8px 14px;
        min-height: 104px;
        gap: 10px;
        transition: var(--transition);
        box-shadow: var(--shadow-sm);
        position: relative;
        overflow: hidden;
        }

        .qa-card::before {
        content: '';
        position: absolute;
        inset: 0;
        opacity: 0;
        transition: opacity .22s;
        border-radius: inherit;
        }

        .qa-card:hover {
        transform: translateY(-6px) scale(1.03);
        box-shadow: var(--shadow-lg);
        background: #fff;
        }

        .qa-card:hover::before {
        opacity: 1;
        }

        .qa-icon {
        width: 46px;
        height: 46px;
        border-radius: 13px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        transition: transform .3s;
        }

        .qa-card:hover .qa-icon {
        transform: scale(1.1) rotate(-4deg);
        }

        .qa-label {
        font-size: 12.5px;
        font-weight: 600;
        color: var(--text-primary);
        text-align: center;
        line-height: 1.2;
        }

        /* Icon colours */
        .ic-green {
        background: rgba(25,135,84,.12);
        color: #198754;
        }

        .ic-blue {
        background: rgba(13,110,253,.12);
        color: #0d6efd;
        }

        .ic-cyan {
        background: rgba(13,202,240,.12);
        color: #0aa2c0;
        }

        .ic-orange {
        background: rgba(253,126,20,.12);
        color: #d96b0a;
        }

        .ic-red {
        background: rgba(220,53,69,.12);
        color: #dc3545;
        }

        .ic-purple {
        background: rgba(111,66,193,.12);
        color: #6f42c1;
        }

        .ic-teal {
        background: rgba(32,201,151,.12);
        color: #13795b;
        }

        .ic-yellow {
        background: rgba(255,193,7,.14);
        color: #9d7e00;
        }

        .ic-dark {
        background: rgba(33,37,41,.08);
        color: #343a40;
        }

        /* ── Footer ── */
        .dash-footer {
        margin: auto -30px 0;
        background: linear-gradient(135deg, var(--green-900) 0%, var(--green-800) 100%);
        border-top: 1px solid rgba(255,255,255,.06);
        padding: 14px 30px;
        box-shadow: 0 -4px 20px rgba(0,0,0,.14);
        }

        .footer-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 8px;
        }

        .footer-copy {
        font-size: 11.5px;
        color: rgba(255,255,255,.45);
        }

        .footer-copy strong {
        color: var(--green-400);
        }

        .footer-links {
        display: flex;
        align-items: center;
        gap: 16px;
        }

        .footer-tag {
        font-size: 10px;
        color: rgba(255,255,255,.3);
        background: rgba(255,255,255,.06);
        padding: 2px 10px;
        border-radius: 20px;
        }

        .footer-link {
        font-size: 11.5px;
        color: rgba(255,255,255,.4);
        text-decoration: none;
        transition: color .2s;
        }

        .footer-link:hover {
        color: var(--green-400);
        }

        /* ─────────────────────────────────────────
        RESPONSIVE
        ───────────────────────────────────────── */
        @@media (max-width: 991.98px) {
        .sidebar {
        display: none;
        }

        .main-content {
        margin-left: 0;
        padding: 18px 16px 0;
        }

        .dash-footer {
        margin: auto -16px 0;
        padding: 14px 20px;
        }
        }

        @@media (max-width: 767.98px) {
        :root {
        --header-h: 56px;
        }

        .top-header {
        padding: 0 14px;
        }

        .header-brand-name {
        font-size: 15px;
        }

        .header-brand-sub {
        display: none;
        }

        .main-content {
        padding: 14px 12px 0;
        }

        .dash-footer {
        margin: auto -12px 0;
        }

        .welcome-banner {
        padding: 16px 18px;
        }

        .welcome-banner h2 {
        font-size: 18px;
        }

        .stat-card {
        min-height: 90px;
        padding: 14px 16px;
        gap: 12px;
        }

        .stat-icon {
        width: 42px;
        height: 42px;
        font-size: 20px;
        border-radius: 11px;
        }

        .stat-body h3 {
        font-size: 22px;
        }
        }

        @@media (max-width: 575.98px) {
        .header-pill-date,
        .header-pill-online {
        display: none !important;
        }

        .header-avatar {
        display: none !important;
        }

        .header-logout-btn span {
        display: none !important;
        }

        .header-logout-btn {
        padding: 6px 9px;
        }

        .qa-card {
        min-height: 84px;
        padding: 12px 6px 10px;
        }

        .qa-icon {
        width: 38px;
        height: 38px;
        font-size: 18px;
        border-radius: 10px;
        }

        .qa-label {
        font-size: 11px;
        }
        }

        /* ── Dark mode ── */
        @@media (prefers-color-scheme: dark) {
        body {
        background: #111a14;
        }

        :root {
        --surface: #111a14;
        --card-bg: rgba(25,38,28,.92);
        --card-border: rgba(255,255,255,.06);
        --text-primary: #e2ede7;
        --text-secondary: #8aab97;
        --text-muted: #5c7a67;
        }

        .welcome-banner {
        background: rgba(20,34,24,.9);
        border-color: rgba(255,255,255,.06);
        }

        .welcome-banner h2 {
        color: var(--green-400) !important;
        }

        .welcome-banner p {
        color: var(--text-secondary) !important;
        }

        .qa-card {
        background: rgba(20,34,24,.85);
        }

        .qa-card:hover {
        background: rgba(30,48,34,.95);
        }

        .qa-label {
        color: #cde5d5;
        }
        }
    </style>
</head>
<body>

    <!-- ═══════════════════════════════════════
     TOP HEADER
════════════════════════════════════════ -->
    <header class="top-header">

        <!-- Hamburger (mobile only) -->
        <button class="header-hamburger d-lg-none"
                type="button"
                data-bs-toggle="offcanvas"
                data-bs-target="#mobileSidebar"
                aria-label="Open menu">
            <i class="bi bi-list"></i>
        </button>

        <!-- Brand -->
        <a class="header-brand" asp-controller="Dashboard" asp-action="Index">
            <div class="header-brand-icon"><i class="bi bi-capsule"></i></div>
            <div>
                <span class="header-brand-name">MediStore</span>
                <span class="header-brand-sub">Billing System</span>
            </div>
        </a>

        <div class="header-spacer"></div>

        <!-- Right group -->
        <span class="header-pill header-pill-online d-none d-sm-inline-flex">
            <i class="bi bi-circle-fill pulse-dot"></i>Online
        </span>
        <span class="header-pill header-pill-date d-none d-md-inline-flex">
            <i class="bi bi-calendar3"></i>
            @DateTime.Now.ToString("dd MMM yyyy")
        </span>
        <div class="header-avatar d-none d-sm-flex" title="Admin">A</div>

        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
            @Html.AntiForgeryToken()
            <button type="submit" class="header-logout-btn">
                <i class="bi bi-box-arrow-right"></i>
                <span>Logout</span>
            </button>
        </form>

    </header>

    <!-- ═══════════════════════════════════════
     MOBILE SIDEBAR (Offcanvas)
════════════════════════════════════════ -->
    <div class="offcanvas offcanvas-start bg-sidebar" tabindex="-1" id="mobileSidebar">
        <div class="offcanvas-header border-bottom border-white border-opacity-10">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-capsule text-success fs-5"></i>
                <span class="fw-bold text-white">MediStore</span>
            </div>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
        </div>
        <div class="offcanvas-body p-3">
            <nav>
                <a class="mobile-nav-link active" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2"></i>Dashboard</a>
                <a class="mobile-nav-link" asp-controller="Brand" asp-action="Index"><i class="bi bi-building"></i>Brand</a>
                <a class="mobile-nav-link" asp-controller="Customer" asp-action="Index"><i class="bi bi-people"></i>Customer</a>
                <a class="mobile-nav-link" asp-controller="Supplier" asp-action="Index"><i class="bi bi-truck"></i>Supplier</a>
                <a class="mobile-nav-link" asp-controller="MedicineCategory" asp-action="Index"><i class="bi bi-tags"></i>Medicine Category</a>
                <a class="mobile-nav-link" asp-controller="MedicineMaster" asp-action="Index"><i class="bi bi-capsule-pill"></i>Medicine Master</a>
                <a class="mobile-nav-link" asp-controller="Purchase" asp-action="Index"><i class="bi bi-cart-plus"></i>Purchase</a>
                <a class="mobile-nav-link" asp-controller="Sale" asp-action="Index"><i class="bi bi-cart-check"></i>Sale</a>
                <a class="mobile-nav-link" asp-controller="Payment" asp-action="Index"><i class="bi bi-cash-coin"></i>Payment</a>
                <a class="mobile-nav-link" asp-controller="Receipt" asp-action="Index"><i class="bi bi-receipt"></i>Receipt</a>
                <a class="mobile-nav-link" asp-controller="Report" asp-action="Index"><i class="bi bi-bar-chart"></i>Reports</a>
                <div style="border-top:1px solid rgba(255,255,255,.08);margin:14px 0 16px;"></div>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="sidebar-logout-btn">
                        <i class="bi bi-box-arrow-right"></i>Logout
                    </button>
                </form>
            </nav>
        </div>
    </div>

    <!-- ═══════════════════════════════════════
     APP SHELL
════════════════════════════════════════ -->
    <div class="app-shell">

        <!-- DESKTOP SIDEBAR -->
        <aside class="sidebar d-none d-lg-flex">

            <div class="sidebar-search">
                <i class="bi bi-search"></i>
                <input type="text" id="sidebarSearch" placeholder="Search menu…" autocomplete="off" />
                <button type="button" id="clearBtn" class="clear-btn" title="Clear"><i class="bi bi-x-lg"></i></button>
            </div>

            <div class="nav-label">Navigation</div>

            <ul class="sidebar-nav" id="menuList">
                <li class="active"><a asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2"></i>Dashboard</a></li>
                <li><a asp-controller="Brand" asp-action="Index"><i class="bi bi-building"></i>Brand</a></li>
                <li><a asp-controller="Customer" asp-action="Index"><i class="bi bi-people"></i>Customer</a></li>
                <li><a asp-controller="Supplier" asp-action="Index"><i class="bi bi-truck"></i>Supplier</a></li>
                <li><a asp-controller="MedicineCategory" asp-action="Index"><i class="bi bi-tags"></i>Medicine Category</a></li>
                <li><a asp-controller="MedicineMaster" asp-action="Index"><i class="bi bi-capsule-pill"></i>Medicine Master</a></li>
                <li><a asp-controller="Purchase" asp-action="Index"><i class="bi bi-cart-plus"></i>Purchase</a></li>
                <li><a asp-controller="Sale" asp-action="Index"><i class="bi bi-cart-check"></i>Sale</a></li>
                <li><a asp-controller="Payment" asp-action="Index"><i class="bi bi-cash-coin"></i>Payment</a></li>
                <li><a asp-controller="Receipt" asp-action="Index"><i class="bi bi-receipt"></i>Receipt</a></li>
                <li><a asp-controller="Report" asp-action="Index"><i class="bi bi-bar-chart"></i>Reports</a></li>
            </ul>

            <div class="nav-divider"></div>
            <form asp-controller="Account" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="sidebar-logout-btn">
                    <i class="bi bi-box-arrow-right"></i>Logout
                </button>
            </form>

        </aside>

        <!-- MAIN CONTENT -->
        <main class="main-content">

            <!-- Welcome -->
            <div class="welcome-banner">
                <div>
                    <h2>Welcome back, Admin 👋</h2>
                    <p>Here's what's happening with your medical store today.</p>
                </div>
                <span class="welcome-tag">
                    <i class="bi bi-clock me-1"></i>@DateTime.Now.ToString("hh:mm tt")
                </span>
            </div>

            <!-- Stat Cards -->
            <div class="row g-3 g-md-4 mb-4">
                <div class="col-lg-3 col-sm-6">
                    <div class="stat-card sc-blue">
                        <div class="stat-icon"><i class="bi bi-cart-check-fill"></i></div>
                        <div class="stat-body">
                            <h3>250</h3>
                            <p>Total Sales</p>
                            <span class="stat-trend up"><i class="bi bi-arrow-up-short"></i>+12%</span>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-sm-6">
                    <div class="stat-card sc-red">
                        <div class="stat-icon"><i class="bi bi-cart-plus-fill"></i></div>
                        <div class="stat-body">
                            <h3>120</h3>
                            <p>Total Purchases</p>
                            <span class="stat-trend up"><i class="bi bi-arrow-up-short"></i>+8%</span>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-sm-6">
                    <div class="stat-card sc-green">
                        <div class="stat-icon"><i class="bi bi-capsule-pill"></i></div>
                        <div class="stat-body">
                            <h3>500</h3>
                            <p>Medicines</p>
                            <span class="stat-trend up"><i class="bi bi-arrow-up-short"></i>+5%</span>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-sm-6">
                    <div class="stat-card sc-orange">
                        <div class="stat-icon"><i class="bi bi-people-fill"></i></div>
                        <div class="stat-body">
                            <h3>150</h3>
                            <p>Customers</p>
                            <span class="stat-trend down"><i class="bi bi-arrow-down-short"></i>-3%</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Quick Access -->
            <div class="d-flex align-items-end justify-content-between mb-3 px-1">
                <div>
                    <p class="section-title"><span class="dot"></span>Quick Access</p>
                    <span class="section-sub">Jump to any module instantly</span>
                </div>
            </div>

            <div class="row g-2 g-sm-3 g-md-3 mb-4">
                <div class="col-xl-2 col-lg-3 col-md-4 col-4">
                    <a asp-controller="Brand" asp-action="Index" class="qa-card">
                        <div class="qa-icon ic-green"><i class="bi bi-building"></i></div>
                        <span class="qa-label">Brand</span>
                    </a>
                </div>
                <div class="col-xl-2 col-lg-3 col-md-4 col-4">
                    <a asp-controller="Customer" asp-action="Index" class="qa-card">
                        <div class="qa-icon ic-blue"><i class="bi bi-people-fill"></i></div>
                        <span class="qa-label">Customer</span>
                    </a>
                </div>
                <div class="col-xl-2 col-lg-3 col-md-4 col-4">
                    <a asp-controller="MedicineCategory" asp-action="Index" class="qa-card">
                        <div class="qa-icon ic-cyan"><i class="bi bi-tags-fill"></i></div>
                        <span class="qa-label">Category</span>
                    </a>
                </div>
                <div class="col-xl-2 col-lg-3 col-md-4 col-4">
                    <a asp-controller="MedicineMaster" asp-action="Index" class="qa-card">
                        <div class="qa-icon ic-green"><i class="bi bi-capsule-pill"></i></div>
                        <span class="qa-label">Medicine</span>
                    </a>
                </div>
                <div class="col-xl-2 col-lg-3 col-md-4 col-4">
                    <a asp-controller="Supplier" asp-action="Index" class="qa-card">
                        <div class="qa-icon ic-orange"><i class="bi bi-truck"></i></div>
                        <span class="qa-label">Supplier</span>
                    </a>
                </div>
                <div class="col-xl-2 col-lg-3 col-md-4 col-4">
                    <a asp-controller="Purchase" asp-action="Index" class="qa-card">
                        <div class="qa-icon ic-red"><i class="bi bi-cart-plus-fill"></i></div>
                        <span class="qa-label">Purchase</span>
                    </a>
                </div>
                <div class="col-xl-2 col-lg-3 col-md-4 col-4">
                    <a asp-controller="Sale" asp-action="Index" class="qa-card">
                        <div class="qa-icon ic-blue"><i class="bi bi-cart-check-fill"></i></div>
                        <span class="qa-label">Sale</span>
                    </a>
                </div>
                <div class="col-xl-2 col-lg-3 col-md-4 col-4">
                    <a asp-controller="Payment" asp-action="Index" class="qa-card">
                        <div class="qa-icon ic-yellow"><i class="bi bi-cash-coin"></i></div>
                        <span class="qa-label">Payment</span>
                    </a>
                </div>
                <div class="col-xl-2 col-lg-3 col-md-4 col-4">
                    <a asp-controller="Receipt" asp-action="Index" class="qa-card">
                        <div class="qa-icon ic-teal"><i class="bi bi-receipt"></i></div>
                        <span class="qa-label">Receipt</span>
                    </a>
                </div>
                <div class="col-xl-2 col-lg-3 col-md-4 col-4">
                    <a asp-controller="Report" asp-action="Index" class="qa-card">
                        <div class="qa-icon ic-dark"><i class="bi bi-bar-chart-fill"></i></div>
                        <span class="qa-label">Reports</span>
                    </a>
                </div>
            </div>

            <!-- Footer -->
            <footer class="dash-footer">
                <div class="footer-inner">
                    <p class="footer-copy m-0">
                        <i class="bi bi-capsule me-1"></i>
                        &copy; @DateTime.Now.Year <strong>MediStore</strong> Billing System — All rights reserved
                    </p>
                    <div class="footer-links">
                        <span class="footer-tag">v1.0.0</span>
                        <a href="#" class="footer-link">Privacy</a>
                        <a href="#" class="footer-link">Support</a>
                    </div>
                </div>
            </footer>

        </main>
    </div>

    <!-- ─── Scripts ─── -->
    <script>
        (function () {
        const input = document.getElementById('sidebarSearch');
        const clearBtn = document.getElementById('clearBtn');
        const list = document.getElementById('menuList');
        if (!input || !clearBtn || !list) return;

        const items = [...list.querySelectorAll('li')];

        function filter() {
        const q = input.value.trim().toLowerCase();
        items.forEach(li => {
        const text = li.querySelector('a')?.textContent.trim().toLowerCase() ?? '';
        li.style.display = (!q || text.includes(q)) ? '' : 'none';
        });
        clearBtn.style.display = input.value ? 'inline-flex' : 'none';
        }

        input.addEventListener('input', filter);
        clearBtn.addEventListener('click', () => { input.value = ''; filter(); input.focus(); });
        })();
    </script>

</body>
</html>
