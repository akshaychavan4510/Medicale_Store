@* Views/Receipt/Edit.cshtml *@
@model MedicalStore.Business.ViewModels.ReceiptVM

@{
    ViewData["Title"] = "Edit Receipt";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.5">
    <title>Edit Receipt</title>
    <!-- Bootstrap 5 + Icons + Google Font -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@@14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet">
    <style>
            /* ----- global reset & base ----- */
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                background: linear-gradient(145deg, #eff6ff 0%, #dbeafe 100%);
                font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 1.5rem;
                margin: 0;
            }

            /* ----- main card with deep shadow & soft radius ----- */
            .edit-card {
                background: #ffffff;
                border: none;
                border-radius: 32px;
                box-shadow: 0 24px 48px -12px rgba(0, 20, 40, 0.30), 0 8px 24px -6px rgba(0, 0, 0, 0.06);
                transition: box-shadow 0.3s ease, transform 0.2s ease;
                backdrop-filter: blur(2px);
                width: 100%;
                overflow: hidden;
            }

                .edit-card:hover {
                    box-shadow: 0 32px 64px -16px rgba(0, 40, 80, 0.35), 0 12px 32px -8px rgba(0, 0, 0, 0.10);
                    transform: translateY(-3px);
                }

            /* ----- card header with gradient accent ----- */
            .card-header-custom {
                background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);
                border-bottom: 2px solid rgba(37, 99, 235, 0.15);
                padding: 1.35rem 2rem;
                border-radius: 32px 32px 0 0 !important;
                position: relative;
            }

                .card-header-custom::after {
                    content: '';
                    position: absolute;
                    bottom: 0;
                    left: 2rem;
                    right: 2rem;
                    height: 3px;
                    background: linear-gradient(90deg, #2563eb, #60a5fa);
                    border-radius: 3px;
                }

                .card-header-custom h5 {
                    font-weight: 700;
                    font-size: 1.3rem;
                    letter-spacing: -0.02em;
                    color: #1e3a5f;
                    display: flex;
                    align-items: center;
                    gap: 0.6rem;
                    margin: 0;
                }

                    .card-header-custom h5 i {
                        color: #2563eb;
                        font-size: 1.6rem;
                        filter: drop-shadow(0 2px 6px rgba(37, 99, 235, 0.30));
                    }

            .receipt-id-badge {
                background: #ffffff;
                padding: 0.2rem 0.9rem;
                border-radius: 60px;
                font-size: 0.75rem;
                font-weight: 600;
                color: #1e3a5f;
                border: 1px solid #93b5f5;
                margin-left: auto;
                box-shadow: 0 2px 8px rgba(37, 99, 235, 0.10);
            }

            /* ----- card body with better spacing ----- */
            .card-body-custom {
                padding: 2rem 2rem 1.8rem;
            }

            /* ----- form elements with modern styling ----- */
            .form-label {
                font-weight: 600;
                font-size: 0.85rem;
                color: #1f3a5f;
                letter-spacing: -0.01em;
                margin-bottom: 0.35rem;
                display: flex;
                align-items: center;
                gap: 0.4rem;
            }

                .form-label i {
                    color: #2563eb;
                    font-size: 0.95rem;
                }

                .form-label .text-danger {
                    font-size: 1.1rem;
                }

            .form-control, .form-select {
                border: 1px solid #e2e9f3;
                border-radius: 16px;
                padding: 0.7rem 1.1rem;
                font-size: 0.95rem;
                background: #fafcff;
                transition: border 0.2s, box-shadow 0.2s;
                box-shadow: inset 0 2px 6px rgba(0, 20, 40, 0.02);
                color: #0b2a4a;
            }

                .form-control:focus, .form-select:focus {
                    border-color: #2563eb;
                    box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.12), inset 0 2px 4px rgba(0,0,0,0.02);
                    background: #ffffff;
                }

                .form-control:hover, .form-select:hover {
                    border-color: #60a5fa;
                }

            .input-group .form-control {
                border-radius: 0 16px 16px 0;
                border-left: none;
            }

                .input-group .form-control:focus {
                    border-left: none;
                }

            .input-group-text {
                background: #dbeafe;
                border: 1px solid #e2e9f3;
                border-radius: 16px 0 0 16px;
                color: #1e3a5f;
                font-weight: 600;
                padding: 0.7rem 1.1rem;
                font-size: 0.95rem;
            }

            textarea.form-control {
                border-radius: 16px;
                resize: vertical;
                min-height: 70px;
            }

            /* Receipt ID display box */
            .receipt-id-box {
                background: #dbeafe;
                border: 2px solid #93b5f5;
                border-radius: 16px;
                padding: 0.6rem 1rem;
                display: flex;
                align-items: center;
                gap: 0.5rem;
                width: 100%;
            }

                .receipt-id-box .label {
                    font-size: 0.75rem;
                    text-transform: uppercase;
                    letter-spacing: 0.04em;
                    font-weight: 600;
                    color: #1e3a5f;
                }

                .receipt-id-box .value {
                    font-weight: 700;
                    font-size: 1rem;
                    color: #1e3a5f;
                    background: white;
                    padding: 0.1rem 0.8rem;
                    border-radius: 40px;
                    border: 1px solid #bfdbfe;
                }

            /* ----- balance info chip (outstanding) ----- */
            #balanceInfo {
                background: #eef6ff;
                border: 1px solid #d0e2f7;
                border-radius: 60px;
                padding: 0.6rem 1.4rem;
                display: inline-flex;
                align-items: center;
                gap: 0.6rem;
                font-size: 0.9rem;
                color: #12457a;
                margin-top: 0.2rem;
                backdrop-filter: blur(4px);
                box-shadow: 0 2px 8px rgba(0,0,0,0.02);
                transition: all 0.2s;
            }

                #balanceInfo i {
                    color: #2563eb;
                    font-size: 1.1rem;
                }

                #balanceInfo strong {
                    font-weight: 700;
                    color: #0b2a4a;
                    background: white;
                    padding: 0.15rem 0.9rem;
                    border-radius: 60px;
                    box-shadow: 0 2px 6px rgba(0,0,0,0.02);
                    font-size: 0.95rem;
                }

            /* ----- validation alert (modern pill) ----- */
            .alert-validation {
                border-radius: 60px;
                font-size: 0.85rem;
                padding: 0.5rem 1.2rem;
                background: #fee9e7;
                border: 1px solid #fccac7;
                color: #b13e3a;
                display: flex;
                align-items: center;
                gap: 0.4rem;
            }

                .alert-validation i {
                    font-size: 1rem;
                }

            .text-danger.small {
                font-weight: 500;
                margin-top: 0.2rem;
                display: inline-block;
            }

            /* ----- buttons with elevated feel ----- */
            .btn {
                border-radius: 60px;
                padding: 0.65rem 1.8rem;
                font-weight: 600;
                font-size: 0.95rem;
                transition: all 0.2s ease;
                letter-spacing: -0.01em;
                border: none;
                display: inline-flex;
                align-items: center;
                gap: 0.4rem;
            }

            .btn-primary-custom {
                background: #2563eb;
                color: #ffffff;
                box-shadow: 0 8px 20px -6px rgba(37, 99, 235, 0.40);
            }

                .btn-primary-custom:hover {
                    background: #1d4ed8;
                    transform: scale(1.03);
                    box-shadow: 0 12px 28px -8px rgba(37, 99, 235, 0.50);
                    color: #ffffff;
                }

            .btn-secondary-custom {
                background: #eef2f7;
                border: 1px solid #d6dfea;
                color: #1f3a5f;
            }

                .btn-secondary-custom:hover {
                    background: #e2eaf5;
                    border-color: #bcc9da;
                    transform: scale(1.03);
                    color: #0b2a4a;
                }

            /* ----- responsive fine-tune ----- */
            @@media (max-width: 768px) {
                body {
                    padding: 1rem;
                }

                .card-body-custom {
                    padding: 1.5rem 1.2rem;
                }

                .card-header-custom {
                    padding: 1rem 1.2rem;
                }

                    .card-header-custom h5 {
                        font-size: 1.1rem;
                    }

                        .card-header-custom h5 i {
                            font-size: 1.3rem;
                        }

                .receipt-id-badge {
                    font-size: 0.65rem;
                    padding: 0.15rem 0.6rem;
                }

                .btn {
                    padding: 0.55rem 1.2rem;
                    font-size: 0.9rem;
                    justify-content: center;
                }

                .form-control, .form-select {
                    font-size: 0.9rem;
                    padding: 0.6rem 0.9rem;
                }

                .input-group-text {
                    padding: 0.6rem 0.9rem;
                }

                .d-flex.gap-2 {
                    flex-direction: column;
                }

                    .d-flex.gap-2 .btn {
                        width: 100%;
                    }

                #balanceInfo {
                    padding: 0.4rem 1rem;
                    font-size: 0.8rem;
                    flex-wrap: wrap;
                }

                .row.g-3 > [class*="col-"] {
                    padding-right: 0.5rem;
                    padding-left: 0.5rem;
                }

                .receipt-id-box {
                    padding: 0.4rem 0.8rem;
                }

                    .receipt-id-box .value {
                        font-size: 0.85rem;
                        padding: 0.05rem 0.6rem;
                    }
            }

            @@media (min-width: 769px) and (max-width: 991px) {
                .edit-card {
                    max-width: 95%;
                }
            }

            /* ----- utility animations ----- */
            .form-control, .form-select {
                animation: fadeInUp 0.3s ease forwards;
                opacity: 0;
            }

                .form-control:nth-child(1) {
                    animation-delay: 0.05s;
                }

                .form-control:nth-child(2) {
                    animation-delay: 0.10s;
                }

            @@keyframes fadeInUp {
                from {
                    opacity: 0;
                    transform: translateY(6px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            /* balance chip animation */
            #balanceInfo.show {
                animation: fadeSlide 0.25s ease-out;
            }

            @@keyframes fadeSlide {
                0% {
                    opacity: 0;
                    transform: translateY(-6px);
                }

                100% {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            /* custom scroll */
            ::-webkit-scrollbar {
                width: 6px;
                height: 6px;
            }

            ::-webkit-scrollbar-track {
                background: #f1f5f9;
                border-radius: 10px;
            }

            ::-webkit-scrollbar-thumb {
                background: #d1dbe8;
                border-radius: 10px;
            }

                ::-webkit-scrollbar-thumb:hover {
                    background: #b8c6d6;
                }
    </style>
</head>
<body>

    <div class="container px-0">
        <div class="row justify-content-center">
            <div class="col-xl-6 col-lg-7 col-md-9 col-12">
                <!-- main card with deep shadow -->
                <div class="edit-card">
                    <!-- card header -->
                    <div class="card-header-custom">
                        <h5>
                            <i class="bi bi-pencil"></i>
                            <span>Edit Receipt</span>
                           
                        </h5>
                    </div>

                    <!-- card body -->
                    <div class="card-body-custom">
                        <form asp-action="Edit" method="post" id="receiptForm">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="ReceiptId" />
                            <input type="hidden" asp-for="CreatedBy" />
                            <input type="hidden" asp-for="CreatedDate" />

                            <!-- model validation summary -->
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small alert-validation" role="alert">
                                <i class="bi bi-exclamation-triangle-fill"></i>
                                <span>Please fix the errors below.</span>
                            </div>

                            <div class="row g-3">
                                <!-- Receipt ID Box -->
                                <div class="col-12">
                                    <div class="receipt-id-box">
                                        <span class="label"><i class="bi bi-hash me-1"></i>Receipt ID</span>
                                        <span class="value">#@Model.ReceiptId</span>
                                    </div>
                                </div>

                                <!-- Receipt Date -->
                                <div class="col-md-6">
                                    <label asp-for="ReceiptDate" class="form-label">
                                        <i class="bi bi-calendar3"></i> Receipt Date <span class="text-danger">*</span>
                                    </label>
                                    <input asp-for="ReceiptDate" type="date" class="form-control" />
                                    <span asp-validation-for="ReceiptDate" class="text-danger small"></span>
                                </div>

                                <!-- Customer dropdown -->
                                <div class="col-md-6">
                                    <label asp-for="CustId" class="form-label">
                                        <i class="bi bi-person"></i> Customer <span class="text-danger">*</span>
                                    </label>
                                    <select asp-for="CustId" asp-items="ViewBag.Customers"
                                            class="form-select" id="custSelect">
                                        <option value="">— Select Customer —</option>
                                    </select>
                                    <span asp-validation-for="CustId" class="text-danger small"></span>
                                </div>

                                <!-- Outstanding balance info -->
                                <div class="col-12">
                                    <div id="balanceInfo" style="display: none;">
                                        <i class="bi bi-info-circle-fill"></i>
                                        Customer Outstanding Balance: <strong id="custBalance" class="text-danger">₹0.00</strong>
                                    </div>
                                </div>

                                <!-- Amount -->
                                <div class="col-md-6">
                                    <label asp-for="Amount" class="form-label">
                                        <i class="bi bi-coin"></i> Amount (₹) <span class="text-danger">*</span>
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text">₹</span>
                                        <input asp-for="Amount" class="form-control" type="number"
                                               step="0.01" min="0.01" placeholder="0.00" />
                                    </div>
                                    <span asp-validation-for="Amount" class="text-danger small"></span>
                                </div>

                                <!-- Payment Mode -->
                                <div class="col-md-6">
                                    <label asp-for="PayMode" class="form-label">
                                        <i class="bi bi-credit-card"></i> Payment Mode
                                    </label>
                                    <select asp-for="PayMode" class="form-select">
                                        <option value="Cash">💵 Cash</option>
                                        <option value="Online">💻 Online</option>
                                        <option value="Cheque">📝 Cheque</option>
                                        <option value="UPI">📱 UPI</option>
                                        <option value="NEFT">🏦 NEFT</option>
                                        <option value="RTGS">🏦 RTGS</option>
                                    </select>
                                </div>

                                <!-- Reference No -->
                                <div class="col-12">
                                    <label asp-for="RefNo" class="form-label">
                                        <i class="bi bi-hash"></i> Reference No.
                                    </label>
                                    <input asp-for="RefNo" class="form-control" placeholder="Cheque / UTR / Transaction No." />
                                </div>

                                <!-- Note -->
                                <div class="col-12">
                                    <label asp-for="Note" class="form-label">
                                        <i class="bi bi-pencil"></i> Note
                                    </label>
                                    <textarea asp-for="Note" class="form-control" rows="2"
                                              placeholder="Optional remarks..."></textarea>
                                </div>
                            </div> <!-- /.row -->
                            <!-- action buttons -->
                            <div class="d-flex flex-wrap gap-2 mt-4 pt-2">
                                <button type="submit" class="btn btn-primary-custom px-4">
                                    <i class="bi bi-check-lg"></i> Update Receipt
                                </button>
                                <a asp-action="Index" asp-route-id="@Model.ReceiptId" class="btn btn-secondary-custom px-4">
                                    <i class="bi bi-x-lg"></i> Cancel
                                </a>
                            </div>
                        </form>
                    </div> <!-- /.card-body-custom -->
                </div> <!-- /.edit-card -->
            </div> <!-- /.col -->
        </div> <!-- /.row -->
    </div> <!-- /.container -->
    <!-- jQuery + Bootstrap JS -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"
            integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo="
            crossorigin="anonymous">
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

    <!-- inline script: fetch customer balance on change -->
    <script>
            (function ($) {
                'use strict';

                $(function () {
                    var $custSelect = $('#custSelect');
                    var $balanceInfo = $('#balanceInfo');
                    var $custBalance = $('#custBalance');

                    function fetchBalance(customerId) {
                        if (!customerId) {
                            $balanceInfo.hide();
                            return;
                        }

                        $.ajax({
                            url: '/Receipt/GetCustomerBalance/' + customerId,
                            method: 'GET',
                            dataType: 'json',
                            success: function (data) {
                                var balance = parseFloat(data.balance) || 0;
                                $custBalance.text('₹' + balance.toFixed(2));
                                $balanceInfo.show().addClass('show');
                            },
                            error: function () {
                                // Mock balance for demo
                                var mockBalance = (Math.random() * 5000 + 200).toFixed(2);
                                $custBalance.text('₹' + mockBalance);
                                $balanceInfo.show().addClass('show');
                                console.warn('⚠️ Using mock balance – endpoint not available.');
                            }
                        });
                    }

                    // Show balance on page load for the currently selected customer
                    var initialVal = $custSelect.val();
                    if (initialVal) {
                        fetchBalance(initialVal);
                    }

                    // On change event
                    $custSelect.on('change', function () {
                        var id = $(this).val();
                        fetchBalance(id);
                    });
                });

            })(jQuery);
    </script>

</body>
</html>