@* Views/Receipt/Details.cshtml *@
@model MedicalStore.Business.ViewModels.ReceiptVM

@{
    ViewData["Title"] = "Receipt Details";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.5">
    <title>Receipt Details</title>
    <!-- Bootstrap 5 + Icons + Google Font -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@@14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet">
    <style>
            /* ----- global reset & base ----- */
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                background: linear-gradient(145deg, #f0fdf4 0%, #dcfce7 100%);
                font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 1.5rem;
                margin: 0;
            }

            /* ----- main card with deep shadow & soft radius ----- */
            .details-card {
                background: #ffffff;
                border: none;
                border-radius: 32px;
                box-shadow: 0 24px 48px -12px rgba(0, 20, 40, 0.30), 0 8px 24px -6px rgba(0, 0, 0, 0.06);
                transition: box-shadow 0.3s ease, transform 0.2s ease;
                backdrop-filter: blur(2px);
                width: 100%;
                overflow: hidden;
            }

                .details-card:hover {
                    box-shadow: 0 32px 64px -16px rgba(0, 40, 80, 0.35), 0 12px 32px -8px rgba(0, 0, 0, 0.10);
                    transform: translateY(-3px);
                }

            /* ----- card header with gradient accent ----- */
            .card-header-custom {
                background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);
                border-bottom: 2px solid rgba(21, 128, 61, 0.15);
                padding: 1.35rem 2rem;
                border-radius: 32px 32px 0 0 !important;
                position: relative;
            }

                .card-header-custom::after {
                    content: '';
                    position: absolute;
                    bottom: 0;
                    left: 2rem;
                    right: 2rem;
                    height: 3px;
                    background: linear-gradient(90deg, #15803d, #4ade80);
                    border-radius: 3px;
                }

                .card-header-custom h5 {
                    font-weight: 700;
                    font-size: 1.3rem;
                    letter-spacing: -0.02em;
                    color: #14532d;
                    display: flex;
                    align-items: center;
                    gap: 0.6rem;
                    margin: 0;
                }

                    .card-header-custom h5 i {
                        color: #15803d;
                        font-size: 1.6rem;
                        filter: drop-shadow(0 2px 6px rgba(21, 128, 61, 0.30));
                    }

            .receipt-id-badge {
                background: #ffffff;
                padding: 0.2rem 0.9rem;
                border-radius: 60px;
                font-size: 0.75rem;
                font-weight: 600;
                color: #14532d;
                border: 1px solid #86efac;
                margin-left: auto;
                box-shadow: 0 2px 8px rgba(21, 128, 61, 0.10);
            }

            .amount-badge {
                background: #15803d;
                color: #ffffff;
                padding: 0.3rem 1.2rem;
                border-radius: 60px;
                font-size: 1.1rem;
                font-weight: 700;
                box-shadow: 0 4px 12px rgba(21, 128, 61, 0.30);
            }

            /* ----- card body with better spacing ----- */
            .card-body-custom {
                padding: 2rem 2rem 1.5rem;
            }

            /* ----- details list modern styling ----- */
            .details-grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 0.8rem 0.5rem;
            }

            .detail-item {
                display: flex;
                flex-direction: column;
                padding: 0.6rem 0.8rem;
                border-radius: 14px;
                background: #fafcff;
                transition: background 0.2s ease;
                border: 1px solid transparent;
            }

                .detail-item:hover {
                    background: #f0fdf4;
                    border-color: #86efac;
                }

                .detail-item.full-width {
                    grid-column: 1 / -1;
                }

            .detail-label {
                font-size: 0.72rem;
                text-transform: uppercase;
                letter-spacing: 0.04em;
                font-weight: 600;
                color: #7a8fa6;
                margin-bottom: 0.15rem;
            }

            .detail-value {
                font-size: 0.95rem;
                font-weight: 500;
                color: #0b2a4a;
                word-break: break-word;
            }

                .detail-value.receipt-id {
                    font-weight: 700;
                    color: #14532d;
                    background: #dcfce7;
                    padding: 0.1rem 0.6rem;
                    border-radius: 40px;
                    display: inline-block;
                }

                .detail-value.amount {
                    font-size: 1.2rem;
                    font-weight: 700;
                    color: #15803d;
                    background: #dcfce7;
                    padding: 0.1rem 0.6rem;
                    border-radius: 40px;
                    display: inline-block;
                }

                .detail-value .badge-mode {
                    background: #e8edf5;
                    color: #1f3a5f;
                    padding: 0.15rem 0.8rem;
                    border-radius: 40px;
                    font-size: 0.8rem;
                    font-weight: 500;
                }

                .detail-value .ref-number {
                    font-family: 'Courier New', monospace;
                    background: #f1f5f9;
                    padding: 0.1rem 0.6rem;
                    border-radius: 40px;
                    font-size: 0.85rem;
                }

            /* ----- card footer with action buttons ----- */
            .card-footer-custom {
                background: #ffffff;
                border-top: 1px solid rgba(0, 0, 0, 0.03);
                padding: 1.2rem 2rem 1.8rem;
                border-radius: 0 0 32px 32px !important;
                display: flex;
                flex-wrap: wrap;
                gap: 0.8rem;
                align-items: center;
            }

            /* ----- buttons with elevated feel ----- */
            .btn {
                border-radius: 60px;
                padding: 0.6rem 1.6rem;
                font-weight: 600;
                font-size: 0.9rem;
                transition: all 0.2s ease;
                letter-spacing: -0.01em;
                border: none;
                display: inline-flex;
                align-items: center;
                gap: 0.4rem;
            }

            .btn-primary-custom {
                background: #0d47a1;
                color: #ffffff;
                box-shadow: 0 8px 20px -6px rgba(13, 71, 161, 0.35);
            }

                .btn-primary-custom:hover {
                    background: #0a3a8a;
                    transform: scale(1.03);
                    box-shadow: 0 12px 28px -8px rgba(13, 71, 161, 0.45);
                    color: #ffffff;
                }

            .btn-danger-custom {
                background: #dc2626;
                color: #ffffff;
                box-shadow: 0 8px 20px -6px rgba(220, 38, 38, 0.30);
            }

                .btn-danger-custom:hover {
                    background: #b91c1c;
                    transform: scale(1.03);
                    box-shadow: 0 12px 28px -8px rgba(220, 38, 38, 0.40);
                    color: #ffffff;
                }

            .btn-secondary-custom {
                background: #eef2f7;
                border: 1px solid #d6dfea;
                color: #1f3a5f;
            }

                .btn-secondary-custom:hover {
                    background: #e2eaf5;
                    border-color: #bcc9da;
                    transform: scale(1.03);
                    color: #0b2a4a;
                }

            /* ----- responsive fine-tune ----- */
            @@media (max-width: 768px) {
                body {
                    padding: 1rem;
                }

                .details-grid {
                    grid-template-columns: 1fr;
                    gap: 0.5rem;
                }

                .detail-item {
                    padding: 0.5rem 0.7rem;
                }

                .card-body-custom {
                    padding: 1.5rem 1.2rem;
                }

                .card-header-custom {
                    padding: 1rem 1.2rem;
                }

                    .card-header-custom h5 {
                        font-size: 1.1rem;
                    }

                        .card-header-custom h5 i {
                            font-size: 1.3rem;
                        }

                .card-footer-custom {
                    padding: 1rem 1.2rem 1.5rem;
                    flex-direction: column;
                    align-items: stretch;
                }

                .btn {
                    justify-content: center;
                    padding: 0.55rem 1.2rem;
                    font-size: 0.9rem;
                }

                .receipt-id-badge {
                    font-size: 0.65rem;
                    padding: 0.15rem 0.6rem;
                }

                .amount-badge {
                    font-size: 0.9rem;
                    padding: 0.2rem 1rem;
                }

                .detail-value.amount {
                    font-size: 1rem;
                }
            }

            @@media (min-width: 769px) and (max-width: 991px) {
                .details-card {
                    max-width: 95%;
                }
            }

            /* ----- utility animations ----- */
            .detail-item {
                animation: fadeInUp 0.3s ease forwards;
                opacity: 0;
            }

                .detail-item:nth-child(1) {
                    animation-delay: 0.05s;
                }

                .detail-item:nth-child(2) {
                    animation-delay: 0.08s;
                }

                .detail-item:nth-child(3) {
                    animation-delay: 0.11s;
                }

                .detail-item:nth-child(4) {
                    animation-delay: 0.14s;
                }

                .detail-item:nth-child(5) {
                    animation-delay: 0.17s;
                }

                .detail-item:nth-child(6) {
                    animation-delay: 0.20s;
                }

                .detail-item:nth-child(7) {
                    animation-delay: 0.23s;
                }

                .detail-item:nth-child(8) {
                    animation-delay: 0.26s;
                }

                .detail-item:nth-child(9) {
                    animation-delay: 0.29s;
                }

                .detail-item:nth-child(10) {
                    animation-delay: 0.32s;
                }

            @@keyframes fadeInUp {
                from {
                    opacity: 0;
                    transform: translateY(8px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            /* custom scroll */
            ::-webkit-scrollbar {
                width: 6px;
                height: 6px;
            }

            ::-webkit-scrollbar-track {
                background: #f1f5f9;
                border-radius: 10px;
            }

            ::-webkit-scrollbar-thumb {
                background: #d1dbe8;
                border-radius: 10px;
            }

                ::-webkit-scrollbar-thumb:hover {
                    background: #b8c6d6;
                }
    </style>
</head>
<body>

    <div class="container px-0">
        <div class="row justify-content-center">
            <div class="col-xl-6 col-lg-7 col-md-9 col-12">
                <!-- main card with deep shadow -->
                <div class="details-card">
                    <!-- card header -->
                    <div class="card-header-custom">
                        <h5>
                            <i class="bi bi-receipt"></i>
                            <span>Receipt Details</span>
                            
                        </h5>
                    </div>

                    <!-- card body -->
                    <div class="card-body-custom">
                        <div class="details-grid">
                            <!-- Receipt ID -->
                            <div class="detail-item">
                                <span class="detail-label"><i class="bi bi-hash me-1"></i>Receipt </span>
                                <span class="detail-value receipt-id">@Model.ReceiptId</span>
                            </div>

                            <!-- Date -->
                            <div class="detail-item">
                                <span class="detail-label"><i class="bi bi-calendar3 me-1"></i>Receipt Date</span>
                                <span class="detail-value">@Model.ReceiptDate.ToString("dd MMM yyyy")</span>
                            </div>

                            <!-- Customer -->
                            <div class="detail-item full-width">
                                <span class="detail-label"><i class="bi bi-person me-1"></i>Customer</span>
                                <span class="detail-value fw-bold" style="font-size:1.05rem;">
                                    @(string.IsNullOrWhiteSpace(Model.CustomerName) ? "—" : Model.CustomerName)
                                </span>
                            </div>

                            <!-- Amount -->
                            <div class="detail-item full-width">
                                <span class="detail-label"><i class="bi bi-coin me-1"></i>Amount Received</span>
                                <span class="detail-value amount">₹@Model.Amount.ToString("N2")</span>
                            </div>

                            <!-- Payment Mode -->
                            <div class="detail-item">
                                <span class="detail-label"><i class="bi bi-credit-card me-1"></i>Payment Mode</span>
                                <span class="detail-value">
                                    <span class="badge-mode">@(Model.PayMode ?? "Cash")</span>
                                </span>
                            </div>

                            <!-- Reference No -->
                            <div class="detail-item">
                                <span class="detail-label"><i class="bi bi-hash me-1"></i>Reference No.</span>
                                <span class="detail-value">
                                    @if (!string.IsNullOrWhiteSpace(Model.RefNo))
                                    {
                                        <span class="ref-number">@Model.RefNo</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </span>
                            </div>

                            <!-- Note -->
                            <div class="detail-item full-width">
                                <span class="detail-label"><i class="bi bi-pencil me-1"></i>Note</span>
                                <span class="detail-value">@(string.IsNullOrWhiteSpace(Model.Note) ? "—" : Model.Note)</span>
                            </div>

                            <!-- Created On -->
                            <div class="detail-item">
                                <span class="detail-label"><i class="bi bi-clock me-1"></i>Created On</span>
                                <span class="detail-value" style="font-size:0.85rem; color:#6b7f94;">
                                    @Model.CreatedDate.ToString("dd MMM yyyy, hh:mm tt")
                                </span>
                            </div>

                            <!-- Created By -->
                            @if (!string.IsNullOrWhiteSpace(Model.CreatedBy))
                            {
                                <div class="detail-item">
                                    <span class="detail-label"><i class="bi bi-person me-1"></i>Created By</span>
                                    <span class="detail-value" style="font-size:0.85rem; color:#6b7f94;">
                                        @Model.CreatedBy
                                    </span>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- card footer with actions -->
                    <div class="card-footer-custom">
                        
                        <a asp-action="Index" class="btn btn-secondary-custom ms-auto">
                            <i class="bi bi-arrow-left"></i> Back to List
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

</body>
</html>