@model IEnumerable<MedicalStore.Business.ViewModels.PurchaseMasterVM>

@{
    ViewData["Title"] = "Purchases";
    Layout = null;

    var purchases = Model ?? Enumerable.Empty<MedicalStore.Business.ViewModels.PurchaseMasterVM>();

    var totalPurchases = purchases.Count();
    var totalAmount = purchases.Sum(x => x.NetTotal);
    var latestPurchase = purchases.Any()
        ? purchases.Max(x => x.PurchaseDate)
        : DateTime.Now;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Medical Store</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          rel="stylesheet" />

    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700&display=swap"
          rel="stylesheet" />

    <style>

            * {
                font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
                box-sizing: border-box;
            }

            body {
                background: #f4f7fc;
                padding: 20px;
                min-height: 100vh;
            }

            .purchase-container {
                max-width: 1250px;
                margin: 0 auto;
            }

            /* HEADER */

            .page-header {
                background: #fff;
                border-radius: 20px;
                padding: 18px 24px;
                margin-bottom: 24px;
                box-shadow: 0 4px 20px rgba(0,0,0,.04);
                display: flex;
                flex-wrap: wrap;
                align-items: center;
                gap: 16px;
            }

            .header-icon {
                width: 48px;
                height: 48px;
                background: #e8f5e9;
                border-radius: 14px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 24px;
                color: #2e7d32;
            }

            .header-title h5 {
                font-weight: 700;
                margin: 0;
                color: #0b2a3e;
                font-size: 1.2rem;
            }

            .header-title small {
                color: #6c7e96;
            }

            .btn-new {
                margin-left: auto;
                background: linear-gradient(135deg,#1b5e20,#2e7d32);
                border: none;
                padding: 9px 22px;
                border-radius: 40px;
                font-weight: 600;
                color: #fff;
                text-decoration: none;
                display: inline-flex;
                align-items: center;
                gap: 8px;
                transition: .25s;
            }

                .btn-new:hover {
                    color: #fff;
                    transform: translateY(-2px);
                    box-shadow: 0 8px 25px rgba(46,125,50,.3);
                }

            /* STATS */

            .stats-row {
                display: flex;
                flex-wrap: wrap;
                gap: 16px;
                margin-bottom: 20px;
            }

            .stat-card {
                background: #fff;
                border-radius: 16px;
                padding: 16px 22px;
                flex: 1 1 200px;
                box-shadow: 0 2px 12px rgba(0,0,0,.04);
                display: flex;
                align-items: center;
                gap: 14px;
                border: 1px solid #eef2f6;
            }

            .stat-icon {
                width: 44px;
                height: 44px;
                border-radius: 12px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 20px;
            }

            .blue {
                background: #e8f4fd;
                color: #0d6efd;
            }

            .green {
                background: #e6f7ed;
                color: #2e7d32;
            }

            .orange {
                background: #fef3e8;
                color: #e97c07;
            }

            .stat-number {
                font-weight: 700;
                font-size: 1.25rem;
                color: #0b2a3e;
            }

            .stat-label {
                display: block;
                font-size: .75rem;
                font-weight: 500;
                text-transform: uppercase;
                letter-spacing: .4px;
                color: #6c7e96;
            }

            /* TOOLBAR */

            .toolbar {
                background: #fff;
                border-radius: 16px;
                padding: 12px 20px;
                margin-bottom: 20px;
                display: flex;
                align-items: center;
                gap: 12px;
                border: 1px solid #eef2f6;
                box-shadow: 0 2px 12px rgba(0,0,0,.04);
            }

            .search-wrap {
                flex: 1;
                position: relative;
            }

                .search-wrap i {
                    position: absolute;
                    left: 15px;
                    top: 50%;
                    transform: translateY(-50%);
                    color: #9db0c0;
                }

                .search-wrap input {
                    width: 100%;
                    padding: 9px 40px;
                    border: 1.5px solid #e2e8f0;
                    border-radius: 40px;
                    background: #f8fafc;
                    outline: none;
                }

                    .search-wrap input:focus {
                        border-color: #2e7d32;
                        background: #fff;
                        box-shadow: 0 0 0 4px rgba(46,125,50,.08);
                    }

            .result-badge {
                background: #f0f4f9;
                color: #5a738a;
                padding: 5px 16px;
                border-radius: 40px;
                white-space: nowrap;
            }

            /* TABLE */

            .table-card {
                background: #fff;
                border-radius: 20px;
                overflow: hidden;
                border: 1px solid #eef2f6;
                box-shadow: 0 4px 20px rgba(0,0,0,.04);
            }

            .purchase-table {
                margin: 0;
                font-size: .9rem;
            }

                .purchase-table thead {
                    background: #f8fafc;
                }

                .purchase-table th {
                    padding: 14px 18px;
                    border: 0;
                    color: #5a738a;
                    font-size: .75rem;
                    text-transform: uppercase;
                    letter-spacing: .5px;
                }

                .purchase-table td {
                    padding: 14px 18px;
                    vertical-align: middle;
                    border-bottom: 1px solid #f0f3f7;
                }

                .purchase-table tbody tr:hover {
                    background: #fafcff;
                }

            /* BADGES */

            .purchase-id {
                background: #e8f5e9;
                color: #2e7d32;
                border: 1px solid #c8e6c9;
                padding: 5px 12px;
                border-radius: 40px;
                font-weight: 600;
            }

            .supplier-name {
                font-weight: 600;
                color: #243b53;
            }

            .invoice-number {
                color: #607d8b;
            }

            .amount {
                color: #2e7d32;
                font-weight: 700;
            }

            /* ACTIONS */

            .action-group {
                display: flex;
                justify-content: center;
                gap: 5px;
            }

            .btn-icon {
                width: 34px;
                height: 34px;
                border-radius: 10px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                text-decoration: none;
                color: #71869a;
                transition: .2s;
            }

                .btn-icon:hover {
                    transform: scale(1.05);
                }

                .btn-icon.view:hover {
                    background: #e8f4fd;
                    color: #0d6efd;
                }

                .btn-icon.edit:hover {
                    background: #fef3e8;
                    color: #e97c07;
                }

                .btn-icon.delete:hover {
                    background: #fde8e8;
                    color: #d93025;
                }

            /* EMPTY */

            .empty-state {
                padding: 60px 20px;
                text-align: center;
            }

            .empty-icon {
                font-size: 50px;
                color: #d0dce8;
                margin-bottom: 12px;
            }

            .empty-state h6 {
                color: #1a3a5a;
                font-weight: 600;
            }

            .empty-state p {
                color: #7a93ab;
            }

            /* FOOTER */

            .table-footer {
                background: #fafcfe;
                padding: 14px 20px;
                border-top: 1px solid #eef2f6;
                display: flex;
                justify-content: space-between;
                color: #5a738a;
                font-size: .85rem;
            }

            /* RESPONSIVE */

            @@media(max-width:768px) {

                body {
                    padding: 12px;
                }

                .page-header {
                    padding: 14px 16px;
                }

                .btn-new {
                    margin-left: 0;
                    width: 100%;
                    justify-content: center;
                }

                .toolbar {
                    flex-direction: column;
                    align-items: stretch;
                }

                .purchase-table thead {
                    display: none;
                }

                .purchase-table tbody tr {
                    display: block;
                    padding: 15px;
                    border-bottom: 1px solid #eef2f6;
                }

                .purchase-table td {
                    display: flex;
                    justify-content: space-between;
                    padding: 5px 0;
                    border: 0;
                }

                    .purchase-table td::before {
                        content: attr(data-label);
                        color: #5a738a;
                        font-size: .7rem;
                        font-weight: 600;
                        text-transform: uppercase;
                    }

                    .purchase-table td:last-child {
                        justify-content: center;
                        border-top: 1px solid #f0f3f7;
                        margin-top: 8px;
                        padding-top: 10px;
                    }

                        .purchase-table td:last-child::before {
                            display: none;
                        }

                .table-footer {
                    flex-direction: column;
                    text-align: center;
                    gap: 5px;
                }
            }

    </style>
</head>

<body>

    <div class="purchase-container">

        <!-- HEADER -->

        <div class="page-header">

            <div class="header-icon">
                <i class="bi bi-cart-check"></i>
            </div>

            <div class="header-title">

                <h5>
                    Purchases

                    <span class="badge bg-success ms-2">
                        @totalPurchases total
                    </span>
                </h5>

                <small>All purchase transactions</small>

            </div>

            <a asp-controller="Purchase"
               asp-action="Create"
               class="btn-new">

                <i class="bi bi-plus-circle"></i>

                New Purchase

            </a>

        </div>


        <!-- STATS -->

        <div class="stats-row">

            <div class="stat-card">

                <div class="stat-icon blue">
                    <i class="bi bi-cart-check"></i>
                </div>

                <div>
                    <span class="stat-number">
                        @totalPurchases
                    </span>

                    <span class="stat-label">
                        Total Purchases
                    </span>
                </div>

            </div>


            <div class="stat-card">

                <div class="stat-icon green">
                    <i class="bi bi-currency-rupee"></i>
                </div>

                <div>

                    <span class="stat-number">
                        ₹@totalAmount.ToString("N2")
                    </span>

                    <span class="stat-label">
                        Net Purchase Amount
                    </span>

                </div>

            </div>


            <div class="stat-card">

                <div class="stat-icon orange">
                    <i class="bi bi-calendar-event"></i>
                </div>

                <div>

                    <span class="stat-number">
                        @(totalPurchases > 0
                            ? latestPurchase.ToString("dd MMM yyyy")
                            : "—")
                    </span>

                    <span class="stat-label">
                        Latest Purchase
                    </span>

                </div>

            </div>

        </div>


        <!-- SEARCH -->

        <div class="toolbar">

            <div class="search-wrap">

                <i class="bi bi-search"></i>

                <input type="text"
                       id="purchaseSearch"
                       placeholder="Search purchase, supplier, invoice..."
                       autocomplete="off" />

            </div>

            <span class="result-badge"
                  id="resultCount">

                @totalPurchases results

            </span>

        </div>


        <!-- TABLE -->

        <div class="table-card">

            <div class="table-responsive">

                <table class="table purchase-table">

                    <thead>

                        <tr>

                            <th>Purchase ID</th>

                            <th>Date</th>

                            <th>Supplier</th>

                            <th>Invoice No</th>

                            <th class="text-end">Grand Total</th>

                            <th class="text-end">Discount</th>

                            <th class="text-end">Net Total</th>

                            <th class="text-center">
                                Actions
                            </th>

                        </tr>

                    </thead>

                    <tbody id="purchaseTableBody">

                        @if (!purchases.Any())
                        {
                            <tr>

                                <td colspan="8">

                                    <div class="empty-state">

                                        <i class="bi bi-cart-x empty-icon"></i>

                                        <h6>
                                            No purchase records found
                                        </h6>

                                        <p>
                                            Start by creating your first purchase.
                                        </p>

                                        <a asp-controller="Purchase"
                                           asp-action="Create"
                                           class="btn btn-success btn-sm">

                                            <i class="bi bi-plus-circle me-1"></i>

                                            New Purchase

                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }
                        else
                        {
                            foreach (var item in purchases)
                            {
                                <tr class="purchase-row"
                                    data-search="
                                    @item.PurId
                                    @item.SupplierName
                                    @item.InvoiceNo
                                    @item.PurchaseDate.ToString("dd-MM-yyyy")
                                    ">

                                    <td data-label="Purchase ID">

                                        <span class="purchase-id">

                                            PUR-@item.PurId.ToString("D4")

                                        </span>

                                    </td>

                                    <td data-label="Date">

                                        @item.PurchaseDate.ToString("dd-MM-yyyy")

                                    </td>

                                    <td data-label="Supplier">

                                        <span class="supplier-name">

                                            @(item.SupplierName ?? "N/A")

                                        </span>

                                    </td>

                                    <td data-label="Invoice No">

                                        <span class="invoice-number">

                                            @(string.IsNullOrWhiteSpace(item.InvoiceNo)
                                                ? "—"
                                                : item.InvoiceNo)

                                        </span>

                                    </td>

                                    <td data-label="Grand Total"
                                        class="text-end">

                                        ₹@item.GrandTotal.ToString("N2")

                                    </td>

                                    <td data-label="Discount"
                                        class="text-end">

                                        ₹@item.Discount.ToString("N2")

                                    </td>

                                    <td data-label="Net Total"
                                        class="text-end amount">

                                        ₹@item.NetTotal.ToString("N2")

                                    </td>

                                    <td data-label="Actions">

                                        <div class="action-group">

                                            <a asp-controller="Purchase"
                                               asp-action="Details"
                                               asp-route-id="@item.PurId"
                                               class="btn-icon view"
                                               title="View">

                                                <i class="bi bi-eye"></i>

                                            </a>

                                            <a asp-controller="Purchase"
                                               asp-action="Edit"
                                               asp-route-id="@item.PurId"
                                               class="btn-icon edit"
                                               title="Edit">

                                                <i class="bi bi-pencil-square"></i>

                                            </a>

                                            <a asp-controller="Purchase"
                                               asp-action="Delete"
                                               asp-route-id="@item.PurId"
                                               class="btn-icon delete"
                                               title="Delete">

                                                <i class="bi bi-trash"></i>

                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>


            <div class="table-footer">

                <span>

                    <i class="bi bi-list-ul me-1"></i>

                    Showing

                    <strong id="visibleCount">
                        @totalPurchases
                    </strong>

                    purchases

                </span>

                <span>

                    <i class="bi bi-shield-check me-1"></i>

                    Secure Medical Store Management

                </span>

            </div>

        </div>

    </div>


    <script>

            (function() {

                const searchInput =
                    document.getElementById("purchaseSearch");

                const resultCount =
                    document.getElementById("resultCount");

                const rows =
                    document.querySelectorAll(".purchase-row");

                const visibleCount =
                    document.getElementById("visibleCount");


                searchInput.addEventListener("input", function() {

                    const search =
                        this.value.trim().toLowerCase();

                    let count = 0;


                    rows.forEach(function(row) {

                        const text =
                            row.getAttribute("data-search")
                                .toLowerCase();

                        if (text.includes(search)) {

                            row.style.display = "";

                            count++;

                        }
                        else {

                            row.style.display = "none";

                        }

                    });


                    visibleCount.textContent = count;

                    resultCount.textContent =
                        count +
                        " result" +
                        (count !== 1 ? "s" : "");

                });

            })();

    </script>

</body>
</html>