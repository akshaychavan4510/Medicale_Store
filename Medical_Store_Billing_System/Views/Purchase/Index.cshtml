@model IEnumerable<MedicalStore.Business.ViewModels.ReceiptVM>

@{
    ViewData["Title"] = "Receipts";
    Layout = null;
    var allReceiptsData = ViewBag.AllReceipts as IEnumerable<MedicalStore.Business.ViewModels.ReceiptVM> ?? Model;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Medical Store</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet" />

    <style>
            * {
                font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            }

            body {
                background: #f4f7fc;
                padding: 20px;
                min-height: 100vh;
            }

            .receipt-container {
                max-width: 1200px;
                margin: 0 auto;
            }

            /* ── Header ── */
            .page-header {
                background: #fff;
                border-radius: 20px;
                padding: 18px 24px;
                margin-bottom: 24px;
                box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
                display: flex;
                flex-wrap: wrap;
                align-items: center;
                gap: 16px;
            }

                .page-header .header-icon {
                    width: 48px;
                    height: 48px;
                    background: #e8f5e9;
                    border-radius: 14px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 24px;
                    color: #2e7d32;
                    flex-shrink: 0;
                }

                .page-header .header-title h5 {
                    font-weight: 700;
                    margin: 0;
                    color: #0b2a3e;
                    font-size: 1.2rem;
                }

                .page-header .header-title small {
                    color: #6c7e96;
                    font-size: 0.85rem;
                }

                .page-header .btn-new {
                    margin-left: auto;
                    background: linear-gradient(135deg, #1b5e20, #2e7d32);
                    border: none;
                    padding: 8px 22px;
                    border-radius: 40px;
                    font-weight: 600;
                    font-size: 0.9rem;
                    color: #fff;
                    box-shadow: 0 4px 14px rgba(46, 125, 50, 0.3);
                    transition: all 0.25s ease;
                    display: inline-flex;
                    align-items: center;
                    gap: 8px;
                    white-space: nowrap;
                    text-decoration: none;
                }

                    .page-header .btn-new:hover {
                        transform: translateY(-2px);
                        box-shadow: 0 8px 28px rgba(46, 125, 50, 0.4);
                        color: #fff;
                    }

            /* ── Stats Row ── */
            .stats-row {
                display: flex;
                flex-wrap: wrap;
                gap: 16px;
                margin-bottom: 20px;
            }

                .stats-row .stat-card {
                    background: #fff;
                    border-radius: 16px;
                    padding: 16px 22px;
                    flex: 1 1 180px;
                    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.04);
                    display: flex;
                    align-items: center;
                    gap: 14px;
                    border: 1px solid #eef2f6;
                    transition: border-color 0.2s;
                }

                    .stats-row .stat-card:hover {
                        border-color: #d0dce8;
                    }

            .stat-card .stat-icon {
                width: 44px;
                height: 44px;
                border-radius: 12px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 20px;
                flex-shrink: 0;
            }

            .stat-icon.blue {
                background: #e8f4fd;
                color: #0d6efd;
            }

            .stat-icon.green {
                background: #e6f7ed;
                color: #2e7d32;
            }

            .stat-icon.orange {
                background: #fef3e8;
                color: #e97c07;
            }

            .stat-card .stat-content {
                display: flex;
                flex-direction: column;
            }

                .stat-card .stat-content .stat-number {
                    font-weight: 700;
                    font-size: 1.25rem;
                    line-height: 1.2;
                    color: #0b2a3e;
                }

                .stat-card .stat-content .stat-label {
                    font-size: 0.75rem;
                    font-weight: 500;
                    text-transform: uppercase;
                    letter-spacing: 0.4px;
                    color: #6c7e96;
                }

            /* ── Toolbar ── */
            .toolbar {
                background: #fff;
                border-radius: 16px;
                padding: 12px 20px;
                margin-bottom: 20px;
                box-shadow: 0 2px 12px rgba(0, 0, 0, 0.04);
                display: flex;
                flex-wrap: wrap;
                align-items: center;
                gap: 12px;
                border: 1px solid #eef2f6;
            }

                .toolbar .search-wrap {
                    flex: 1 1 250px;
                    position: relative;
                    min-width: 150px;
                }

                    .toolbar .search-wrap .bi-search {
                        position: absolute;
                        left: 14px;
                        top: 50%;
                        transform: translateY(-50%);
                        color: #a0b8cc;
                        font-size: 0.9rem;
                        pointer-events: none;
                    }

                    .toolbar .search-wrap input {
                        width: 100%;
                        padding: 8px 40px 8px 40px;
                        border: 1.5px solid #e2e8f0;
                        border-radius: 40px;
                        font-size: 0.9rem;
                        background: #f8fafc;
                        transition: all 0.25s ease;
                        outline: none;
                    }

                        .toolbar .search-wrap input:focus {
                            border-color: #2e7d32;
                            background: #fff;
                            box-shadow: 0 0 0 4px rgba(46, 125, 50, 0.08);
                        }

                        .toolbar .search-wrap input::placeholder {
                            color: #a5b9cd;
                        }

            .clear-search {
                position: absolute;
                right: 12px;
                top: 50%;
                transform: translateY(-50%);
                border: none;
                background: transparent;
                color: #9aa8b5;
                cursor: pointer;
                display: none;
                font-size: 16px;
                padding: 2px 4px;
                transition: color 0.2s;
                border-radius: 50%;
                line-height: 1;
            }

                .clear-search:hover {
                    color: #dc3545;
                }

                .clear-search.show {
                    display: block;
                }

            .toolbar .result-badge {
                font-size: 0.85rem;
                color: #5a738a;
                background: #f0f4f9;
                padding: 4px 16px;
                border-radius: 40px;
                font-weight: 500;
                white-space: nowrap;
            }

            /* ── Card / Table ── */
            .table-card {
                background: #fff;
                border-radius: 20px;
                box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
                overflow: hidden;
                border: 1px solid #eef2f6;
                transition: box-shadow 0.3s ease;
            }

                .table-card:hover {
                    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.07);
                }

            .table-receipt {
                margin: 0;
                font-size: 0.9rem;
            }

                .table-receipt thead {
                    background: #f8fafc;
                    border-bottom: 1.5px solid #eef2f6;
                }

                    .table-receipt thead th {
                        font-weight: 600;
                        font-size: 0.75rem;
                        text-transform: uppercase;
                        letter-spacing: 0.5px;
                        color: #5a738a;
                        padding: 14px 18px;
                        border: 0;
                    }

                .table-receipt tbody td {
                    padding: 14px 18px;
                    vertical-align: middle;
                    border-bottom: 1px solid #f0f3f7;
                    background: #fff;
                }

                .table-receipt tbody tr:last-child td {
                    border-bottom: 0;
                }

                .table-receipt tbody tr {
                    transition: background 0.15s ease;
                }

                    .table-receipt tbody tr:hover {
                        background: #fafcff;
                    }

            .badge-id {
                background: #e8f5e9;
                color: #2e7d32;
                font-weight: 600;
                font-size: 0.8rem;
                padding: 4px 12px;
                border-radius: 40px;
                border: 1px solid #c8e6c9;
            }

            .total-amount {
                font-weight: 700;
                color: #2e7d32;
            }

            .action-group {
                display: flex;
                gap: 4px;
                justify-content: center;
            }

                .action-group .btn-icon {
                    width: 34px;
                    height: 34px;
                    padding: 0;
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    border-radius: 10px;
                    font-size: 0.9rem;
                    border: 0;
                    transition: all 0.2s ease;
                    background: transparent;
                    color: #7a93ab;
                    text-decoration: none;
                }

                    .action-group .btn-icon:hover {
                        background: #f0f4f9;
                        color: #0b2a3e;
                        transform: scale(1.05);
                    }

                    .action-group .btn-icon.view:hover {
                        background: #e8f4fd;
                        color: #0d6efd;
                    }

                    .action-group .btn-icon.edit:hover {
                        background: #fef3e8;
                        color: #e97c07;
                    }

                    .action-group .btn-icon.delete:hover {
                        background: #fde8e8;
                        color: #d93025;
                    }

            /* ── Pagination ── */
            .pagination-container {
                padding: 14px 20px;
                background: #fafcfe;
                border-top: 1px solid #eef2f6;
            }

            .pagination .page-link {
                color: #1a4a6b;
                border-radius: 8px;
                margin: 0 3px;
                border: 1px solid #e9edf2;
                padding: 8px 14px;
                font-size: 0.85rem;
            }

                .pagination .page-link:hover {
                    background: #f0f4f9;
                    border-color: #2e7d32;
                    color: #2e7d32;
                }

            .pagination .page-item.active .page-link {
                background: #2e7d32;
                border-color: #2e7d32;
                color: #fff;
            }

            .pagination .page-item.disabled .page-link {
                color: #a0b8cc;
                cursor: not-allowed;
            }

            /* ── Footer ── */
            .table-footer {
                background: #fafcfe;
                padding: 14px 20px;
                border-top: 1px solid #eef2f6;
                font-size: 0.85rem;
                color: #5a738a;
                display: flex;
                flex-wrap: wrap;
                align-items: center;
                justify-content: space-between;
                gap: 8px;
            }

                .table-footer .total-badge {
                    background: #eef2f6;
                    padding: 4px 16px;
                    border-radius: 40px;
                    font-weight: 500;
                    font-size: 0.8rem;
                    color: #3a5a7a;
                }

            /* ── Empty State ── */
            .empty-state {
                padding: 48px 20px;
                text-align: center;
            }

                .empty-state .empty-icon {
                    font-size: 48px;
                    color: #d0dce8;
                    display: block;
                    margin-bottom: 12px;
                }

                .empty-state h6 {
                    font-weight: 600;
                    color: #1a3a5a;
                    font-size: 1.05rem;
                    margin-bottom: 4px;
                }

                .empty-state p {
                    color: #7a93ab;
                    font-size: 0.9rem;
                    margin-bottom: 16px;
                }

            /* ── Alerts ── */
            .alert-custom {
                border-radius: 14px;
                border: 0;
                padding: 12px 18px;
                font-size: 0.9rem;
            }

            /* ── Responsive ── */
            @@media (max-width: 768px) {
                body {
                    padding: 12px;
                }

                .page-header {
                    padding: 14px 16px;
                    border-radius: 16px;
                }

                    .page-header .header-icon {
                        width: 40px;
                        height: 40px;
                        font-size: 20px;
                    }

                    .page-header .header-title h5 {
                        font-size: 1rem;
                    }

                    .page-header .btn-new {
                        padding: 6px 16px;
                        font-size: 0.8rem;
                        margin-left: 0;
                        width: 100%;
                        justify-content: center;
                    }

                .stats-row {
                    gap: 10px;
                }

                    .stats-row .stat-card {
                        flex: 1 1 120px;
                        padding: 12px 16px;
                    }

                .stat-card .stat-content .stat-number {
                    font-size: 1rem;
                }

                .toolbar {
                    padding: 10px 14px;
                    flex-direction: column;
                    align-items: stretch;
                    gap: 8px;
                }

                    .toolbar .search-wrap {
                        flex: 1 1 auto;
                        min-width: 0;
                    }

                    .toolbar .result-badge {
                        text-align: center;
                    }

                .table-receipt thead {
                    display: none;
                }

                .table-receipt tbody tr {
                    display: block;
                    padding: 16px 16px 12px;
                    border-bottom: 1px solid #eef2f6;
                    background: #fff;
                }

                    .table-receipt tbody tr:last-child {
                        border-bottom: 0;
                    }

                .table-receipt tbody td {
                    display: flex;
                    align-items: center;
                    justify-content: space-between;
                    padding: 4px 0;
                    border: 0;
                    background: transparent;
                    font-size: 0.85rem;
                }

                    .table-receipt tbody td::before {
                        content: attr(data-label);
                        font-weight: 500;
                        color: #5a738a;
                        font-size: 0.7rem;
                        text-transform: uppercase;
                        letter-spacing: 0.3px;
                    }

                    .table-receipt tbody td:first-child {
                        padding-top: 0;
                    }

                    .table-receipt tbody td:last-child {
                        padding-bottom: 0;
                        border-top: 1px solid #f0f3f7;
                        margin-top: 8px;
                        padding-top: 10px;
                        justify-content: center;
                    }

                        .table-receipt tbody td:last-child::before {
                            display: none;
                        }

                    .table-receipt tbody td .badge-id {
                        font-size: 0.7rem;
                        padding: 2px 10px;
                    }

                .action-group .btn-icon {
                    width: 38px;
                    height: 38px;
                    font-size: 1rem;
                }

                .pagination-container {
                    padding: 12px 14px;
                }

                .pagination .page-link {
                    padding: 6px 10px;
                    font-size: 0.8rem;
                }

                .table-footer {
                    flex-direction: column;
                    text-align: center;
                    gap: 4px;
                }

                .empty-state {
                    padding: 32px 16px;
                }

                    .empty-state .empty-icon {
                        font-size: 36px;
                    }
            }

            @@media (max-width: 400px) {
                .stats-row .stat-card {
                    flex: 1 1 100%;
                }
            }

            /* fade-in */
            .fade-in {
                animation: fadeIn 0.3s ease forwards;
                opacity: 0;
            }

            @@keyframes fadeIn {
                to {
                    opacity: 1;
                }
            }

            .fade-in:nth-child(1) {
                animation-delay: 0.02s;
            }

            .fade-in:nth-child(2) {
                animation-delay: 0.04s;
            }

            .fade-in:nth-child(3) {
                animation-delay: 0.06s;
            }

            .fade-in:nth-child(4) {
                animation-delay: 0.08s;
            }

            .fade-in:nth-child(5) {
                animation-delay: 0.10s;
            }

            .fade-in:nth-child(6) {
                animation-delay: 0.12s;
            }

            .fade-in:nth-child(7) {
                animation-delay: 0.14s;
            }

            .fade-in:nth-child(8) {
                animation-delay: 0.16s;
            }

            .fade-in:nth-child(9) {
                animation-delay: 0.18s;
            }

            .fade-in:nth-child(10) {
                animation-delay: 0.20s;
            }
    </style>
</head>

<body>

    <div class="receipt-container">

        <!-- ─── PAGE HEADER ─── -->
        <div class="page-header">
            <div class="header-icon">
                <i class="bi bi-receipt"></i>
            </div>
            <div class="header-title">
                <h5>
                    Receipts
                    <span class="badge bg-success ms-2" style="font-size:0.7rem;">
                        <i class="bi bi-database me-1"></i>@ViewBag.TotalRecords total
                    </span>
                </h5>
                <small>All receipt transactions</small>
            </div>
            <a asp-action="Create" class="btn btn-new">
                <i class="bi bi-plus-circle"></i> New Receipt
            </a>
        </div>

        <!-- ─── ALERTS ─── -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-custom alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle me-1"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-custom alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-circle me-1"></i> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- ─── STATS ROW ─── -->
        @{
            var totalReceipts = Model.Count();
            var totalAmount = ViewBag.TotalAmount ?? 0;
            var lastDate = Model.Any() ? Model.Max(r => r.ReceiptDate) : DateTime.Now;
        }
        <div class="stats-row">
            <div class="stat-card">
                <div class="stat-icon blue"><i class="bi bi-receipt-cutoff"></i></div>
                <div class="stat-content">
                    <span class="stat-number">@ViewBag.TotalRecords</span>
                    <span class="stat-label">Total Receipts</span>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon green"><i class="bi bi-currency-rupee"></i></div>
                <div class="stat-content">
                    <span class="stat-number">₹@totalAmount.ToString("N0")</span>
                    <span class="stat-label">Total Amount</span>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon orange"><i class="bi bi-calendar-range"></i></div>
                <div class="stat-content">
                    <span class="stat-number">@(ViewBag.TotalRecords > 0 ? lastDate.ToString("dd MMM") : "—")</span>
                    <span class="stat-label">Latest Receipt</span>
                </div>
            </div>
        </div>

        <!-- ─── TOOLBAR ─── -->
        <div class="toolbar">
            <div class="search-wrap">
                <i class="bi bi-search"></i>
                <input type="text" id="receiptSearch"
                       placeholder="Search by ID, Customer, Date..."
                       autocomplete="off"
                       value="@ViewBag.CurrentSearch" />
                <button type="button" id="clearSearch" class="clear-search" title="Clear Search">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <span class="result-badge" id="resultCount">@ViewBag.TotalRecords results</span>
        </div>

        <!-- ─── TABLE ─── -->
        <div class="table-card">
            <div class="table-responsive">
                <table class="table table-receipt" id="receiptTable">
                    <thead>
                        <tr>
                            <th class="ps-3">Receipt ID</th>
                            <th>Date</th>
                            <th>Customer</th>
                            <th class="text-end">Amount (₹)</th>
                            <th class="text-center" style="width:160px">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="receiptTableBody">
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="5">
                                    <div class="empty-state">
                                        @if (!string.IsNullOrEmpty(ViewBag.CurrentSearch))
                                        {
                                            <i class="bi bi-search empty-icon"></i>
                                            <h6>No matching receipts</h6>
                                            <p>No receipts found matching "<strong>@ViewBag.CurrentSearch</strong>". Try adjusting your search.</p>
                                            <a asp-action="Index" class="btn btn-sm btn-outline-success">
                                                <i class="bi bi-arrow-left me-1"></i> Clear Search
                                            </a>
                                        }
                                        else
                                        {
                                            <i class="bi bi-inbox empty-icon"></i>
                                            <h6>No receipt records found</h6>
                                            <p>Start by creating your first receipt.</p>
                                            <a asp-action="Create" class="btn btn-success btn-sm">
                                                <i class="bi bi-plus-circle me-1"></i> New Receipt
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model)
                            {
                                <tr class="fade-in"
                                    data-search="@item.ReceiptId @item.CustomerName @item.ReceiptDate.ToString("dd-MM-yyyy") @item.Amount">
                                    <td data-label="Receipt ID">
                                        <span class="badge-id">RCP-@item.ReceiptId.ToString("D4")</span>
                                    </td>
                                    <td data-label="Date">
                                        @item.ReceiptDate.ToString("dd-MM-yyyy")
                                    </td>
                                    <td data-label="Customer">
                                        @item.CustomerName
                                    </td>
                                    <td data-label="Amount" class="text-end total-amount">
                                        ₹@item.Amount.ToString("N2")
                                    </td>
                                    <td data-label="Actions" class="text-center">
                                        <div class="action-group">
                                            <a asp-action="Details" asp-route-id="@item.ReceiptId"
                                               class="btn-icon view" title="View Details">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.ReceiptId"
                                               class="btn-icon edit" title="Edit Receipt">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.ReceiptId"
                                               class="btn-icon delete" title="Delete Receipt">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <!-- ─── PAGINATION ─── -->
            @if (ViewBag.TotalPages > 1)
            {
                <div class="pagination-container" id="paginationContainer">
                    <nav>
                        <ul class="pagination justify-content-center mb-0">
                            <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link" asp-action="Index"
                                   asp-route-page="@(ViewBag.CurrentPage - 1)"
                                   asp-route-searchTerm="@ViewBag.CurrentSearch">
                                    <i class="bi bi-chevron-left"></i> Previous
                                </a>
                            </li>

                            @for (int i = 1; i <= ViewBag.TotalPages; i++)
                            {
                                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                    <a class="page-link" asp-action="Index"
                                       asp-route-page="@i"
                                       asp-route-searchTerm="@ViewBag.CurrentSearch">@i</a>
                                </li>
                            }

                            <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                                <a class="page-link" asp-action="Index"
                                   asp-route-page="@(ViewBag.CurrentPage + 1)"
                                   asp-route-searchTerm="@ViewBag.CurrentSearch">
                                    Next <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }

            <div class="table-footer">
                <span>
                    <i class="bi bi-list-ul me-1"></i>
                    Showing <strong id="visibleCount">@Model.Count()</strong> of <strong id="totalCount">@ViewBag.TotalRecords</strong> receipts
                </span>
                <span class="total-badge">
                    <i class="bi bi-clock-history me-1"></i> Page @ViewBag.CurrentPage of @ViewBag.TotalPages
                </span>
            </div>
        </div>

        <div class="text-center text-muted small mt-3 opacity-50" style="font-size:0.7rem;">
            <i class="bi bi-shield-check me-1"></i> Secure · Medical Store Management
        </div>
    </div>

    <!-- ─── SCRIPTS ─── -->
    <script>
            (function() {
                'use strict';

                // Store ALL receipts for searching across all pages
                const allReceipts = @Html.Raw(Json.Serialize(allReceiptsData));
                const searchInput = document.getElementById('receiptSearch');
                const clearButton = document.getElementById('clearSearch');
                const tbody = document.getElementById('receiptTableBody');
                const visibleCount = document.getElementById('visibleCount');
                const totalCount = document.getElementById('totalCount');
                const resultCount = document.getElementById('resultCount');
                const paginationContainer = document.getElementById('paginationContainer');
                const currentPage = @ViewBag.CurrentPage;

                // ── Escape HTML to prevent XSS ──
                function escapeHtml(text) {
                    if (!text) return '';
                    const div = document.createElement('div');
                    div.textContent = text;
                    return div.innerHTML;
                }

                // ── Toggle clear button visibility ──
                function toggleClearButton() {
                    if (searchInput.value.trim().length > 0) {
                        clearButton.classList.add('show');
                    } else {
                        clearButton.classList.remove('show');
                    }
                }

                // ── Format date ──
                function formatDate(dateString) {
                    if (!dateString) return '';
                    const date = new Date(dateString);
                    const day = String(date.getDate()).padStart(2, '0');
                    const month = String(date.getMonth() + 1).padStart(2, '0');
                    const year = date.getFullYear();
                    return `${day}-${month}-${year}`;
                }

                // ── Render filtered receipts (client-side search across ALL records) ──
                function renderFilteredReceipts(searchTerm) {
                    const trimmedTerm = searchTerm.trim();

                    // If search is empty, reload the page to show server-side pagination
                    if (trimmedTerm === "") {
                        window.location.href = '@Url.Action("Index", new { page = -1 })'.replace('-1', currentPage);
                        return;
                    }

                    const lowerSearch = trimmedTerm.toLowerCase();

                    // Filter receipts from ALL data
                    const filtered = allReceipts.filter(r =>
                        (r.receiptId && r.receiptId.toString().includes(lowerSearch)) ||
                        (r.customerName && r.customerName.toLowerCase().includes(lowerSearch)) ||
                        (r.receiptDate && formatDate(r.receiptDate).includes(lowerSearch)) ||
                        (r.amount && r.amount.toString().includes(lowerSearch))
                    );

                    // Update counts
                    const total = allReceipts.length;
                    const shown = filtered.length;

                    if (visibleCount) visibleCount.textContent = shown;
                    if (totalCount) totalCount.textContent = total;
                    if (resultCount) {
                        resultCount.textContent = shown + ' result' + (shown !== 1 ? 's' : '');
                    }

                    // Hide pagination when searching
                    if (paginationContainer) {
                        paginationContainer.style.display = 'none';
                    }

                    // Show clear button
                    toggleClearButton();

                    // Show "no results" message
                    if (filtered.length === 0) {
                        tbody.innerHTML = `
                            <tr>
                                <td colspan="5">
                                    <div class="empty-state">
                                        <i class="bi bi-search empty-icon"></i>
                                        <h6>No matching receipts</h6>
                                        <p>No receipts found matching "<strong>${escapeHtml(trimmedTerm)}</strong>" across all pages.</p>
                                        <button type="button" id="clearSearchFromMsg" class="btn btn-sm btn-outline-success">
                                            <i class="bi bi-arrow-left me-1"></i> Clear Search
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        `;
                        const clearBtnMsg = document.getElementById('clearSearchFromMsg');
                        if (clearBtnMsg) {
                            clearBtnMsg.addEventListener('click', function() {
                                clearButton.click();
                            });
                        }
                        return;
                    }

                    // Build results HTML
                    let html = '';
                    filtered.forEach(function(r) {
                        const formattedDate = formatDate(r.receiptDate);
                        html += `
                            <tr class="fade-in">
                                <td data-label="Receipt ID">
                                    <span class="badge-id">RCP-${String(r.receiptId).padStart(4, '0')}</span>
                                </td>
                                <td data-label="Date">
                                    ${formattedDate}
                                </td>
                                <td data-label="Customer">
                                    ${escapeHtml(r.customerName)}
                                </td>
                                <td data-label="Amount" class="text-end total-amount">
                                    ₹${parseFloat(r.amount).toFixed(2)}
                                </td>
                                <td data-label="Actions" class="text-center">
                                    <div class="action-group">
                                        <a href="/Receipt/Details/${r.receiptId}" class="btn-icon view" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a href="/Receipt/Edit/${r.receiptId}" class="btn-icon edit" title="Edit Receipt">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <a href="/Receipt/Delete/${r.receiptId}" class="btn-icon delete" title="Delete Receipt">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        `;
                    });

                    tbody.innerHTML = html;
                }

                // ── Debounce search ──
                let debounceTimer;
                searchInput.addEventListener('input', function() {
                    clearTimeout(debounceTimer);
                    debounceTimer = setTimeout(function() {
                        renderFilteredReceipts(searchInput.value);
                    }, 300);
                });

                // ── Clear button click ──
                clearButton.addEventListener('click', function() {
                    searchInput.value = '';
                    clearButton.classList.remove('show');
                    // Redirect to index without search term
                    window.location.href = '@Url.Action("Index", new { page = -1 })'.replace('-1', currentPage);
                });

                // ── Enter key to search ──
                searchInput.addEventListener('keydown', function(e) {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        renderFilteredReceipts(searchInput.value);
                    }
                    if (e.key === 'Escape') {
                        clearButton.click();
                    }
                });

                // ── Initial state ──
                toggleClearButton();

                // If there's a search term from server, trigger client-side filter
                const currentSearchTerm = '@ViewBag.CurrentSearch';
                if (currentSearchTerm && currentSearchTerm.trim() !== '') {
                    searchInput.value = currentSearchTerm;
                    setTimeout(function() {
                        renderFilteredReceipts(currentSearchTerm);
                    }, 100);
                }

            })();
    </script>

</body>
</html>