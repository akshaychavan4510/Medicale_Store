@model MedicalStore.Business.ViewModels.PurchaseMasterVM
@using System.Text.Json

@{
    ViewData["Title"] = "New Purchase Entry";
    Layout = null;

    int nextPurId = ViewBag.NextPurId != null ? (int)ViewBag.NextPurId : 1;
    string nextPurchaseCode = $"PUR-{nextPurId:D4}";
    string nextInvoice = $"INV-{nextPurId:D4}";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <style>
        /* ── Reset & Base ── */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: linear-gradient(145deg, #f0f5fc 0%, #e3eaf5 100%);
            min-height: 100vh;
            padding: 1.5rem;
            margin: 0;
        }

        /* ── Main Container ── */
        .page-wrapper {
            max-width: 1440px;
            margin: 0 auto;
            animation: fadeSlideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }

        @@keyframes fadeSlideUp {
            0% { opacity: 0; transform: translateY(30px) scale(0.97); }
            100% { opacity: 1; transform: translateY(0) scale(1); }
        }

        /* ── Cards & Shadows ── */
        .card-modern {
            background: #ffffff;
            border: none;
            border-radius: 24px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.06), 0 8px 28px rgba(0, 0, 0, 0.03), 0 0 0 1px rgba(0, 0, 0, 0.02);
            transition: box-shadow 0.3s ease, transform 0.2s ease;
        }
        .card-modern:hover {
            box-shadow: 0 32px 80px rgba(0, 0, 0, 0.08), 0 12px 36px rgba(0, 0, 0, 0.04), 0 0 0 1px rgba(0, 0, 0, 0.02);
            transform: translateY(-2px);
        }

        .card-header-custom {
            background: transparent;
            border-bottom: 1px solid #f0f3f9;
            padding: 1rem 1.25rem;
            font-weight: 600;
            font-size: 0.95rem;
            color: #1f3a5f;
            letter-spacing: -0.01em;
        }

        .card-body-custom {
            padding: 1.25rem;
        }

        /* ── Form Controls ── */
        .form-control, .form-select {
            border: 1.5px solid #e2e8f0;
            border-radius: 14px;
            padding: 0.6rem 1rem;
            font-size: 0.9rem;
            font-weight: 500;
            color: #0b1a33;
            background: #fafcff;
            transition: all 0.2s ease;
            box-shadow: inset 0 1px 3px rgba(0,0,0,0.02);
        }
        .form-control:focus, .form-select:focus {
            border-color: #3d7eb9;
            background: #ffffff;
            box-shadow: 0 0 0 4px rgba(61,126,185,0.12), inset 0 1px 3px rgba(0,0,0,0.02);
            outline: none;
        }
        .form-control[readonly], .form-control.bg-light {
            background: #f4f7fc;
            color: #2d405b;
        }
        .input-group-text {
            border: 1.5px solid #e2e8f0;
            border-radius: 14px 0 0 14px;
            background: #f0f3f9;
            color: #5a6e8a;
            font-weight: 500;
        }
        .input-group .form-control {
            border-radius: 0 14px 14px 0;
            border-left: none;
        }
        .input-group:focus-within .input-group-text {
            border-color: #3d7eb9;
            background: #eef3fc;
        }
        .input-group:focus-within .form-control {
            border-color: #3d7eb9;
        }

        /* ── Labels ── */
        .form-label-custom {
            font-weight: 600;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            color: #4a5d7a;
            margin-bottom: 0.25rem;
        }
        .form-label-custom .required-star {
            color: #c62828;
            margin-left: 0.15rem;
        }

        /* ── Table (Responsive) ── */
        .table-wrapper {
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
            margin: 0 -0.5rem;
        }
        .table-purchase {
            min-width: 800px;
            margin-bottom: 0;
            font-size: 0.9rem;
        }
        .table-purchase thead th {
            background: #f8faff;
            border-bottom: 2px solid #e2e8f0;
            font-weight: 600;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            color: #4a5d7a;
            padding: 0.6rem 0.5rem;
            white-space: nowrap;
        }
        .table-purchase td {
            padding: 0.4rem 0.5rem;
            vertical-align: middle;
        }
        .table-purchase .form-control-sm {
            border-radius: 10px;
            padding: 0.35rem 0.6rem;
            font-size: 0.85rem;
        }
        .table-purchase .form-select-sm {
            border-radius: 10px;
            padding: 0.35rem 0.6rem;
            font-size: 0.85rem;
        }

        /* ── Empty state ── */
        .empty-state {
            color: #9aabbe;
            padding: 2.5rem 0;
        }
        .empty-state i {
            font-size: 3rem;
            display: block;
            margin-bottom: 0.5rem;
            opacity: 0.6;
        }

        /* ── Buttons ── */
        .btn-primary-custom {
            background: #3d7eb9;
            border: none;
            border-radius: 60px;
            padding: 0.6rem 1.8rem;
            font-weight: 600;
            font-size: 0.9rem;
            color: #fff;
            transition: all 0.25s ease;
            box-shadow: 0 6px 18px rgba(61,126,185,0.30);
        }
        .btn-primary-custom:hover {
            background: #3269a0;
            transform: translateY(-2px);
            box-shadow: 0 10px 28px rgba(61,126,185,0.35);
            color: #fff;
        }
        .btn-primary-custom:active {
            transform: translateY(0px);
            box-shadow: 0 4px 12px rgba(61,126,185,0.25);
        }

        .btn-outline-custom {
            border: 1.5px solid #dce3ef;
            border-radius: 60px;
            padding: 0.6rem 1.8rem;
            font-weight: 600;
            font-size: 0.9rem;
            color: #4a5d7a;
            transition: all 0.2s ease;
            background: transparent;
        }
        .btn-outline-custom:hover {
            background: #f4f7fd;
            border-color: #b6c8e0;
            color: #1f3a5f;
            text-decoration: none;
        }

        .btn-add {
            border-radius: 60px;
            padding: 0.4rem 1.2rem;
            font-weight: 600;
            font-size: 0.8rem;
            background: #e8f4fd;
            color: #1f5a8a;
            border: 1px solid #cde0f0;
            transition: all 0.2s ease;
        }
        .btn-add:hover {
            background: #d0e4f7;
            border-color: #9bb8d9;
            color: #0f3d66;
        }

        .btn-remove {
            color: #b0bccd;
            transition: color 0.2s ease;
        }
        .btn-remove:hover {
            color: #c62828;
        }

        /* ── Responsive tweaks ── */
        @@media (max-width: 768px) {
            body { padding: 1rem; }
            .card-body-custom { padding: 1rem; }
            .page-wrapper { max-width: 100%; }
            .table-purchase { min-width: 700px; }
            .table-purchase thead th { font-size: 0.65rem; padding: 0.4rem 0.3rem; }
            .table-purchase td { padding: 0.3rem 0.3rem; }
            .form-control-sm, .form-select-sm { font-size: 0.8rem; padding: 0.3rem 0.5rem; }
            .btn-primary-custom, .btn-outline-custom { width: 100%; justify-content: center; }
            .d-flex.gap-2 { flex-direction: column; gap: 0.5rem; }
            .btn-add { width: 100%; }
        }

        @@media (max-width: 576px) {
            .row.g-3 > [class*="col-"] { padding-left: 0; padding-right: 0; }
            .row.g-3 { --bs-gutter-x: 0.5rem; }
            .form-label-custom { font-size: 0.7rem; }
            .input-group-text { font-size: 0.8rem; padding: 0.4rem 0.6rem; }
        }

        /* ── Reduced Motion ── */
        @@media (prefers-reduced-motion: reduce) {
            * { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
        }

        /* ── Misc ── */
        .text-accent {
            color: #3d7eb9;
        }
        .bg-soft-primary {
            background: #e8f4fd;
        }
        .shadow-sm-hover:hover {
            box-shadow: 0 10px 30px rgba(0,0,0,0.06);
        }
        .border-radius-12 {
            border-radius: 12px;
        }
        .fw-500 {
            font-weight: 500;
        }
    </style>
</head>

<body>

<div class="page-wrapper">

    <!-- Header -->
    <div class="d-flex flex-wrap align-items-center gap-2 mb-4">
        <div class="bg-soft-primary p-2 rounded-3">
            <i class="bi bi-box-seam fs-3 text-accent"></i>
        </div>
        <div class="flex-grow-1">
            <h5 class="mb-0 fw-bold">New Purchase Entry</h5>
            <small class="text-muted">Record medicines received from supplier</small>
        </div>
        <a asp-action="Index" class="btn btn-outline-custom btn-sm ms-auto">
            <i class="bi bi-arrow-left me-1"></i>Back to List
        </a>
    </div>

    <!-- Form -->
    <form asp-action="Create" method="post" id="purchaseForm">
        @Html.AntiForgeryToken()

        <!-- Validation Summary -->
        <div class="alert alert-danger py-2 small d-none" id="validationSummary"></div>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

        <!-- Header Card -->
        <div class="card-modern mb-4">
            <div class="card-body-custom">
                <div class="row g-3">

                    <!-- Purchase ID -->
                    <div class="col-sm-6 col-md-2">
                        <label class="form-label-custom">Purchase ID</label>
                        <div class="input-group">
                            <span class="input-group-text bg-primary text-white border-primary">
                                <i class="bi bi-hash"></i>
                            </span>
                            <input type="text" class="form-control bg-light fw-bold text-primary"
                                   value="@nextPurchaseCode" readonly />
                        </div>
                        <small class="text-muted">Auto Generated</small>
                    </div>

                    <!-- Invoice No -->
                    <div class="col-sm-6 col-md-2">
                        <label class="form-label-custom">Invoice No</label>
                        <input asp-for="InvoiceNo" class="form-control" value="@nextInvoice" readonly />
                        <span asp-validation-for="InvoiceNo" class="text-danger small"></span>
                        <small class="text-muted">Auto Generated</small>
                    </div>

                    <!-- Purchase Date -->
                    <div class="col-sm-6 col-md-2">
                        <label asp-for="PurchaseDate" class="form-label-custom"></label>
                        <input asp-for="PurchaseDate" type="date" class="form-control"
                               value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="PurchaseDate" class="text-danger small"></span>
                    </div>

                    <!-- Supplier -->
                    <div class="col-sm-6 col-md-3">
                        <label asp-for="SuppId" class="form-label-custom">Supplier <span class="required-star">*</span></label>
                        <select asp-for="SuppId" asp-items="ViewBag.Suppliers" class="form-select">
                            <option value="">-- Select Supplier --</option>
                        </select>
                        <span asp-validation-for="SuppId" class="text-danger small"></span>
                    </div>

                    <!-- Grand Total -->
                    <div class="col-sm-6 col-md-3">
                        <label class="form-label-custom">Grand Total (₹)</label>
                        <input type="text" id="grandTotalDisplay" class="form-control fw-bold text-success fs-5"
                               readonly value="0.00" />
                        <input type="hidden" asp-for="GrandTotal" id="grandTotalHidden" />
                    </div>

                </div>
            </div>
        </div>

        <!-- Medicine Lines Card -->
        <div class="card-modern mb-4">
            <div class="card-header-custom d-flex flex-wrap align-items-center gap-2">
                <span class="fw-semibold"><i class="bi bi-capsule me-1"></i>Medicine Lines</span>
                <button type="button" class="btn btn-add ms-auto" id="addRowBtn">
                    <i class="bi bi-plus-circle me-1"></i>Add Medicine
                </button>
            </div>
            <div class="card-body-custom p-0">
                <div class="table-wrapper">
                    <table class="table table-purchase">
                        <thead>
                            <tr>
                                <th class="ps-3" style="min-width:200px;">Medicine</th>
                                <th style="min-width:90px;">Rate (₹)</th>
                                <th style="min-width:70px;">Qty</th>
                                <th style="min-width:80px;">GST %</th>
                                <th style="min-width:90px;">Amount (₹)</th>
                                <th style="min-width:90px;">GST (₹)</th>
                                <th style="min-width:90px;">Total (₹)</th>
                                <th style="width:50px;"></th>
                            </tr>
                        </thead>
                        <tbody id="detailsBody"></tbody>
                    </table>
                </div>
                <div id="emptyMsg" class="text-center empty-state">
                    <i class="bi bi-inbox"></i>
                    No medicines added yet. Click <strong>Add Medicine</strong> to begin.
                </div>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="d-flex flex-wrap gap-2">
            <button type="submit" class="btn btn-primary-custom px-4">
                <i class="bi bi-check-lg me-1"></i>Save Purchase
            </button>
            <a asp-action="Index" class="btn btn-outline-custom">Cancel</a>
        </div>

    </form>

</div>


<script>
    document.addEventListener('DOMContentLoaded', function () {

        // Serialized medicine list from ViewBag
        var medicines = @Html.Raw(
            JsonSerializer.Serialize(
                (ViewBag.Medicines as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
                    ?? new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>())
                .Select(m => new { value = m.Value, text = m.Text })
            )
        );

        // If no medicines are available, show a warning in console and keep the dropdown empty
        if (!medicines || medicines.length === 0) {
            console.warn('No medicines found in ViewBag.Medicines.');
        }

        var DEFAULT_GST = 5;
        var rowIndex = 0;

        // Build the options string for the <select> element
        var medOptions = medicines.map(function (m) {
            return '<option value="' + m.value + '">' + m.text + '</option>';
        }).join('');

        function buildRow(idx) {
            return '<tr data-row="' + idx + '">'
                + '<td class="ps-3">'
                +   '<select name="PurchaseDetails[' + idx + '].MedId" class="form-select form-select-sm" required>'
                +     '<option value="">-- Select Medicine --</option>'
                +     medOptions
                +   '</select>'
                + '</td>'
                + '<td><input type="number" name="PurchaseDetails[' + idx + '].Rate"'
                +   ' class="form-control form-control-sm rate-input" step="0.01" min="0.01" placeholder="0.00" required /></td>'
                + '<td><input type="number" name="PurchaseDetails[' + idx + '].Qty"'
                +   ' class="form-control form-control-sm qty-input" min="1" value="1" required /></td>'
                + '<td><input type="number" name="PurchaseDetails[' + idx + '].GstPct"'
                +   ' class="form-control form-control-sm gstpct-input" step="0.01" min="0" value="' + DEFAULT_GST + '" /></td>'
                + '<td><input type="number" name="PurchaseDetails[' + idx + '].Amt"'
                +   ' class="form-control form-control-sm bg-light amt-display" readonly /></td>'
                + '<td><input type="number" name="PurchaseDetails[' + idx + '].GstAmt"'
                +   ' class="form-control form-control-sm bg-light gst-display" readonly /></td>'
                + '<td><input type="number" name="PurchaseDetails[' + idx + '].Total"'
                +   ' class="form-control form-control-sm bg-light fw-semibold total-display" readonly /></td>'
                + '<td class="text-center">'
                +   '<button type="button" class="btn btn-sm btn-remove" title="Remove">'
                +     '<i class="bi bi-trash"></i>'
                +   '</button>'
                + '</td>'
                + '</tr>';
        }

        function calcRow(row) {
            var rate   = parseFloat(row.querySelector('.rate-input').value)   || 0;
            var qty    = parseFloat(row.querySelector('.qty-input').value)    || 0;
            var gstPct = parseFloat(row.querySelector('.gstpct-input').value) || 0;
            var amt    = Math.round(rate * qty * 100) / 100;
            var gstAmt = Math.round(amt * gstPct / 100 * 100) / 100;
            var tot    = Math.round((amt + gstAmt) * 100) / 100;
            row.querySelector('.amt-display').value   = amt.toFixed(2);
            row.querySelector('.gst-display').value   = gstAmt.toFixed(2);
            row.querySelector('.total-display').value = tot.toFixed(2);
            return tot;
        }

        function updateGrandTotal() {
            var grand = 0;
            document.querySelectorAll('#detailsBody tr').forEach(function (r) {
                var el = r.querySelector('.total-display');
                grand += el ? (parseFloat(el.value) || 0) : 0;
            });
            grand = Math.round(grand * 100) / 100;
            document.getElementById('grandTotalDisplay').value = grand.toFixed(2);
            document.getElementById('grandTotalHidden').value  = grand.toFixed(2);
            var count = document.querySelectorAll('#detailsBody tr').length;
            document.getElementById('emptyMsg').style.display = count ? 'none' : '';
        }

        function reIndex() {
            document.querySelectorAll('#detailsBody tr').forEach(function (row, i) {
                row.dataset.row = i;
                row.querySelectorAll('[name]').forEach(function (el) {
                    el.name = el.name.replace(/\[\d+\]/, '[' + i + ']');
                });
            });
            rowIndex = document.querySelectorAll('#detailsBody tr').length;
        }

        // ── Event: Add row ──
        document.getElementById('addRowBtn').addEventListener('click', function () {
            document.getElementById('detailsBody')
                    .insertAdjacentHTML('beforeend', buildRow(rowIndex++));
            updateGrandTotal();
        });

        // ── Event: Recalculate on input ──
        document.getElementById('detailsBody').addEventListener('input', function (e) {
            var row = e.target.closest('tr');
            if (row) { calcRow(row); updateGrandTotal(); }
        });

        // ── Event: Remove row ──
        document.getElementById('detailsBody').addEventListener('click', function (e) {
            if (e.target.closest('.btn-remove')) {
                e.target.closest('tr').remove();
                reIndex();
                updateGrandTotal();
            }
        });

        // ── Event: Validate before submit ──
        document.getElementById('purchaseForm').addEventListener('submit', function (e) {
            if (document.querySelectorAll('#detailsBody tr').length === 0) {
                e.preventDefault();
                var s = document.getElementById('validationSummary');
                s.textContent = 'Please add at least one medicine line before saving.';
                s.classList.remove('d-none');
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }
        });

        // ── Initialise ──
        updateGrandTotal();

    });
</script>

</body>
</html>