@* Payment/Details *@
@model MedicalStore.Business.ViewModels.PaymentVM

@{
    ViewData["Title"] = "Payment Details";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.5">
    <title>Payment Details</title>
    <!-- Bootstrap 5 + Icons + Google Font -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@@14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet">
    <style>
            /* ----- global reset & base ----- */
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                background: linear-gradient(145deg, #f0f5fe 0%, #e8eff9 100%);
                font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 1.5rem;
                margin: 0;
            }

            /* ----- main card with deep shadow & soft radius ----- */
            .details-card {
                background: #ffffff;
                border: none;
                border-radius: 32px;
                box-shadow: 0 24px 48px -12px rgba(0, 20, 40, 0.30), 0 8px 24px -6px rgba(0, 0, 0, 0.06);
                transition: box-shadow 0.3s ease, transform 0.2s ease;
                backdrop-filter: blur(2px);
                width: 100%;
                overflow: hidden;
            }

                .details-card:hover {
                    box-shadow: 0 32px 64px -16px rgba(0, 40, 80, 0.35), 0 12px 32px -8px rgba(0, 0, 0, 0.10);
                    transform: translateY(-3px);
                }

            /* ----- card header with gradient accent ----- */
            .card-header-custom {
                background: linear-gradient(135deg, #ffffff 0%, #f8faff 100%);
                border-bottom: 2px solid rgba(31, 95, 207, 0.08);
                padding: 1.35rem 2rem;
                border-radius: 32px 32px 0 0 !important;
                position: relative;
            }

                .card-header-custom::after {
                    content: '';
                    position: absolute;
                    bottom: 0;
                    left: 2rem;
                    right: 2rem;
                    height: 3px;
                    background: linear-gradient(90deg, #1f5fcf, #6a9ef0);
                    border-radius: 3px;
                }

                .card-header-custom h5 {
                    font-weight: 700;
                    font-size: 1.3rem;
                    letter-spacing: -0.02em;
                    color: #0b2a4a;
                    display: flex;
                    align-items: center;
                    gap: 0.6rem;
                    margin: 0;
                }

                    .card-header-custom h5 i {
                        color: #1f5fcf;
                        font-size: 1.6rem;
                        filter: drop-shadow(0 2px 6px rgba(31, 95, 207, 0.25));
                    }

            .payment-id-badge {
                background: #eef6ff;
                padding: 0.2rem 0.9rem;
                border-radius: 60px;
                font-size: 0.75rem;
                font-weight: 600;
                color: #1f5fcf;
                border: 1px solid #d0e2f7;
                margin-left: auto;
            }

            /* ----- card body with better spacing ----- */
            .card-body-custom {
                padding: 2rem 2rem 1.5rem;
            }

            /* ----- details list modern styling ----- */
            .details-grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 1rem 0.5rem;
            }

            .detail-item {
                display: flex;
                flex-direction: column;
                padding: 0.6rem 0.8rem;
                border-radius: 16px;
                background: #fafcff;
                transition: background 0.2s ease;
                border: 1px solid transparent;
            }

                .detail-item:hover {
                    background: #f0f5fe;
                    border-color: #e2e9f3;
                }

                .detail-item.full-width {
                    grid-column: 1 / -1;
                }

            .detail-label {
                font-size: 0.72rem;
                text-transform: uppercase;
                letter-spacing: 0.04em;
                font-weight: 600;
                color: #7a8fa6;
                margin-bottom: 0.15rem;
            }

            .detail-value {
                font-size: 0.95rem;
                font-weight: 500;
                color: #0b2a4a;
                word-break: break-word;
            }

                .detail-value.amount {
                    font-size: 1.2rem;
                    font-weight: 700;
                    color: #1f5fcf;
                    background: #eef6ff;
                    padding: 0.1rem 0.6rem;
                    border-radius: 40px;
                    display: inline-block;
                }

                .detail-value .badge-mode {
                    background: #e8edf5;
                    color: #1f3a5f;
                    padding: 0.15rem 0.8rem;
                    border-radius: 40px;
                    font-size: 0.8rem;
                    font-weight: 500;
                }

            /* ----- card footer with action buttons ----- */
            .card-footer-custom {
                background: #ffffff;
                border-top: 1px solid rgba(0, 0, 0, 0.03);
                padding: 1.2rem 2rem 1.8rem;
                border-radius: 0 0 32px 32px !important;
                display: flex;
                flex-wrap: wrap;
                gap: 0.8rem;
                align-items: center;
            }

            /* ----- buttons with elevated feel ----- */
            .btn {
                border-radius: 60px;
                padding: 0.6rem 1.6rem;
                font-weight: 600;
                font-size: 0.9rem;
                transition: all 0.2s ease;
                letter-spacing: -0.01em;
                border: none;
                display: inline-flex;
                align-items: center;
                gap: 0.4rem;
            }

            .btn-warning-custom {
                background: #f59e0b;
                color: #ffffff;
                box-shadow: 0 8px 20px -6px rgba(245, 158, 11, 0.40);
            }

                .btn-warning-custom:hover {
                    background: #d97706;
                    transform: scale(1.03);
                    box-shadow: 0 12px 28px -8px rgba(245, 158, 11, 0.50);
                    color: #ffffff;
                }

            .btn-secondary-custom {
                background: #eef2f7;
                border: 1px solid #d6dfea;
                color: #1f3a5f;
            }

                .btn-secondary-custom:hover {
                    background: #e2eaf5;
                    border-color: #bcc9da;
                    transform: scale(1.03);
                    color: #0b2a4a;
                }

            /* ----- responsive fine-tune ----- */
            @@media (max-width: 768px) {
                body {
                    padding: 1rem;
                }

                .details-grid {
                    grid-template-columns: 1fr;
                    gap: 0.5rem;
                }

                .detail-item {
                    padding: 0.5rem 0.7rem;
                }

                .card-body-custom {
                    padding: 1.5rem 1.2rem;
                }

                .card-header-custom {
                    padding: 1rem 1.2rem;
                }

                    .card-header-custom h5 {
                        font-size: 1.1rem;
                    }

                .card-footer-custom {
                    padding: 1rem 1.2rem 1.5rem;
                    flex-direction: column;
                    align-items: stretch;
                }

                .btn {
                    justify-content: center;
                }

                .payment-id-badge {
                    font-size: 0.65rem;
                    padding: 0.15rem 0.6rem;
                }

                .detail-value.amount {
                    font-size: 1rem;
                }
            }

            @@media (min-width: 769px) and (max-width: 991px) {
                .details-card {
                    max-width: 95%;
                }
            }

            /* ----- utility animations ----- */
            .detail-item {
                animation: fadeInUp 0.3s ease forwards;
                opacity: 0;
            }

                .detail-item:nth-child(1) {
                    animation-delay: 0.05s;
                }

                .detail-item:nth-child(2) {
                    animation-delay: 0.10s;
                }

                .detail-item:nth-child(3) {
                    animation-delay: 0.15s;
                }

                .detail-item:nth-child(4) {
                    animation-delay: 0.20s;
                }

                .detail-item:nth-child(5) {
                    animation-delay: 0.25s;
                }

                .detail-item:nth-child(6) {
                    animation-delay: 0.30s;
                }

                .detail-item:nth-child(7) {
                    animation-delay: 0.35s;
                }

                .detail-item:nth-child(8) {
                    animation-delay: 0.40s;
                }

                .detail-item:nth-child(9) {
                    animation-delay: 0.45s;
                }

                .detail-item:nth-child(10) {
                    animation-delay: 0.50s;
                }

            @@keyframes fadeInUp {
                from {
                    opacity: 0;
                    transform: translateY(8px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            /* status indicator */
            .status-dot {
                display: inline-block;
                width: 8px;
                height: 8px;
                border-radius: 50%;
                margin-right: 0.4rem;
            }

                .status-dot.success {
                    background: #10b981;
                }

                .status-dot.warning {
                    background: #f59e0b;
                }

                .status-dot.info {
                    background: #3b82f6;
                }
    </style>
</head>
<body>

    <div class="container px-0">
        <div class="row justify-content-center">
            <div class="col-xl-6 col-lg-7 col-md-9 col-12">
                <!-- main card with deep shadow -->
                <div class="details-card">
                    <!-- card header -->
                    <div class="card-header-custom">
                        <h5>
                            <i class="bi bi-cash-coin"></i>
                            <span>Payment Details</span>
                            
                        </h5>
                    </div>

                    <!-- card body -->
                    <div class="card-body-custom">
                        <div class="details-grid">
                            <!-- Payment ID - Now visible -->
                            <div class="detail-item">
                                <span class="detail-label"><i class="bi bi-hash me-1"></i>Payment ID</span>
                                <span class="detail-value">@Model.PaymentId</span>
                            </div>

                            <!-- Date -->
                            <div class="detail-item">
                                <span class="detail-label"><i class="bi bi-calendar3 me-1"></i>Date</span>
                                <span class="detail-value">@Model.PaymentDate.ToString("dd MMM yyyy")</span>
                            </div>

                            <!-- Supplier -->
                            <div class="detail-item">
                                <span class="detail-label"><i class="bi bi-building me-1"></i>Supplier</span>
                                <span class="detail-value">@Model.SupplierName</span>
                            </div>

                            <!-- Amount -->
                            <div class="detail-item full-width">
                                <span class="detail-label"><i class="bi bi-coin me-1"></i>Amount</span>
                                <span class="detail-value amount">₹@Model.Amount.ToString("N2")</span>
                            </div>

                            <!-- Payment Mode -->
                            <div class="detail-item">
                                <span class="detail-label"><i class="bi bi-credit-card me-1"></i>Payment Mode</span>
                                <span class="detail-value">
                                    @if (!string.IsNullOrEmpty(Model.PayMode))
                                    {
                                        <span class="badge-mode">@Model.PayMode</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </span>
                            </div>

                            <!-- Reference No -->
                            <div class="detail-item">
                                <span class="detail-label"><i class="bi bi-hash me-1"></i>Reference No.</span>
                                <span class="detail-value">@(Model.RefNo ?? "—")</span>
                            </div>

                            <!-- Note -->
                            <div class="detail-item full-width">
                                <span class="detail-label"><i class="bi bi-pencil me-1"></i>Note</span>
                                <span class="detail-value">@(Model.Note ?? "—")</span>
                            </div>

                            <!-- Created By -->
                            <div class="detail-item">
                                <span class="detail-label"><i class="bi bi-person me-1"></i>Created By</span>
                                <span class="detail-value">@(Model.CreatedBy ?? "—")</span>
                            </div>

                            <!-- Created On -->
                            <div class="detail-item">
                                <span class="detail-label"><i class="bi bi-clock me-1"></i>Created On</span>
                                <span class="detail-value">@Model.CreatedDate.ToString("dd MMM yyyy, hh:mm tt")</span>
                            </div>
                        </div>
                    </div>

                    <!-- card footer with actions -->
                    <div class="card-footer-custom">

                        <a asp-action="Index" class="btn btn-secondary-custom">
                            <i class="bi bi-arrow-left"></i> Back to List
                        </a>

                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

</body>
</html>