@* Views/Supplier/Delete.cshtml *@
@model MedicalStore.Business.ViewModels.SupplierVM

@{
    ViewData["Title"] = "Delete Supplier";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

    <style>
            /* ── Reset & Base ── */
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
                background: linear-gradient(145deg, #f6f9fc 0%, #e9eef4 100%);
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 1.5rem;
                margin: 0;
            }

            /* ── Form Container ── */
            .form-wrapper {
                width: 100%;
                max-width: 560px;
                margin: 0 auto;
                animation: fadeSlideUp 0.5s cubic-bezier(0.16, 1, 0.3, 1);
            }

            @@keyframes fadeSlideUp {
                0% {
                    opacity: 0;
                    transform: translateY(30px) scale(0.97);
                }

                100% {
                    opacity: 1;
                    transform: translateY(0) scale(1);
                }
            }

            /* ── Card ── */
            .card-custom {
                background: #ffffff;
                border: none;
                border-radius: 28px;
                box-shadow: 0 20px 60px rgba(0, 0, 0, 0.08), 0 8px 28px rgba(0, 0, 0, 0.04), 0 0 0 1px rgba(198, 40, 40, 0.06);
                transition: box-shadow 0.3s ease, transform 0.2s ease;
                overflow: hidden;
            }

                .card-custom:hover {
                    box-shadow: 0 32px 80px rgba(198, 40, 40, 0.10), 0 12px 36px rgba(0, 0, 0, 0.06), 0 0 0 1px rgba(198, 40, 40, 0.10);
                    transform: translateY(-2px);
                }

            /* ── Card Header (Danger) ── */
            .card-header-custom {
                background: linear-gradient(135deg, #c62828 0%, #b71c1c 100%);
                padding: 1.25rem 1.75rem;
                font-weight: 700;
                font-size: 1.15rem;
                letter-spacing: -0.01em;
                color: #ffffff;
                display: flex;
                align-items: center;
                gap: 0.6rem;
                border-bottom: none;
            }

                .card-header-custom i {
                    font-size: 1.4rem;
                }

                .card-header-custom .header-icon {
                    background: rgba(255, 255, 255, 0.15);
                    border-radius: 12px;
                    padding: 0.4rem 0.6rem;
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                }

            /* ── Card Body ── */
            .card-body-custom {
                padding: 1.75rem 1.75rem 2rem;
            }

            /* ── Warning Alert ── */
            .alert-custom {
                border-radius: 16px;
                border: 1px solid #fde0d5;
                background: #fff6f0;
                color: #a33a2a;
                padding: 0.9rem 1.1rem;
                font-size: 0.88rem;
                font-weight: 500;
                margin-bottom: 1.5rem;
                display: flex;
                align-items: flex-start;
                gap: 0.6rem;
            }

                .alert-custom i {
                    font-size: 1.3rem;
                    color: #c62828;
                    margin-top: 0.05rem;
                    flex-shrink: 0;
                }

                .alert-custom strong {
                    color: #b33a2a;
                }

            /* ── Detail List ── */
            .detail-list {
                margin-bottom: 1.5rem;
                background: #fafcff;
                border-radius: 16px;
                padding: 0.75rem 1rem;
                border: 1px solid #f0f3f9;
            }

                .detail-list .row {
                    padding: 0.5rem 0;
                    border-bottom: 1px solid #f0f3f9;
                    margin: 0;
                }

                    .detail-list .row:last-child {
                        border-bottom: none;
                    }

                .detail-list dt {
                    font-weight: 600;
                    font-size: 0.8rem;
                    text-transform: uppercase;
                    letter-spacing: 0.04em;
                    color: #5a6e8a;
                    padding-right: 0.5rem;
                }

                .detail-list dd {
                    font-weight: 600;
                    font-size: 0.95rem;
                    color: #0b1a33;
                    margin-bottom: 0;
                    word-break: break-word;
                }

                .detail-list .supp-name-highlight {
                    color: #c62828;
                    font-weight: 700;
                    font-size: 1.05rem;
                }

                .detail-list .balance-value {
                    font-weight: 700;
                }

                    .detail-list .balance-value.positive {
                        color: #2a9d8f;
                    }

                    .detail-list .balance-value.negative {
                        color: #c62828;
                    }

            .badge-outstanding {
                background: #fde8e8;
                color: #b33a3a;
                font-weight: 600;
                font-size: 0.65rem;
                padding: 0.2rem 0.6rem;
                border-radius: 40px;
                border: 1px solid #f5d0d0;
                margin-left: 0.3rem;
            }

            /* ── Buttons ── */
            .btn-group-custom {
                display: flex;
                flex-wrap: wrap;
                gap: 0.75rem;
                margin-top: 0.25rem;
            }

            .btn-delete {
                background: #c62828;
                border: none;
                border-radius: 60px;
                padding: 0.65rem 2rem;
                font-weight: 600;
                font-size: 0.9rem;
                color: #fff;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 0.5rem;
                transition: all 0.25s ease;
                box-shadow: 0 6px 18px rgba(198, 40, 40, 0.30);
                flex: 1 1 auto;
                min-width: 130px;
            }

                .btn-delete:hover {
                    background: #b71c1c;
                    transform: translateY(-2px);
                    box-shadow: 0 10px 28px rgba(198, 40, 40, 0.35);
                    color: #fff;
                }

                .btn-delete:active {
                    transform: translateY(0px);
                    box-shadow: 0 4px 12px rgba(198, 40, 40, 0.25);
                }

            .btn-cancel {
                background: transparent;
                border: 1.5px solid #dce3ef;
                border-radius: 60px;
                padding: 0.65rem 1.8rem;
                font-weight: 600;
                font-size: 0.9rem;
                color: #4a5d7a;
                transition: all 0.2s ease;
                flex: 1 1 auto;
                min-width: 100px;
                text-decoration: none;
                text-align: center;
                display: inline-flex;
                align-items: center;
                justify-content: center;
            }

                .btn-cancel:hover {
                    background: #f4f7fd;
                    border-color: #b6c8e0;
                    color: #1f3a5f;
                    text-decoration: none;
                }

            /* ── Hidden Input ── */
            input[type="hidden"] {
                display: none;
            }

            /* ── Responsive ── */
            @@media (max-width: 576px) {
                body {
                    padding: 1rem;
                    align-items: flex-start;
                    padding-top: 2rem;
                }

                .card-header-custom {
                    padding: 1rem 1.25rem;
                    font-size: 1rem;
                }

                    .card-header-custom i {
                        font-size: 1.2rem;
                    }

                .card-body-custom {
                    padding: 1.25rem 1.25rem 1.5rem;
                }

                .alert-custom {
                    font-size: 0.82rem;
                    padding: 0.7rem 0.9rem;
                }

                    .alert-custom i {
                        font-size: 1.1rem;
                    }

                .detail-list {
                    padding: 0.6rem 0.8rem;
                }

                    .detail-list dt {
                        font-size: 0.7rem;
                    }

                    .detail-list dd {
                        font-size: 0.88rem;
                    }

                    .detail-list .supp-name-highlight {
                        font-size: 0.95rem;
                    }

                .btn-delete,
                .btn-cancel {
                    font-size: 0.85rem;
                    padding: 0.55rem 1.2rem;
                    min-width: 80px;
                }

                .btn-group-custom {
                    flex-direction: column;
                    gap: 0.6rem;
                }

                    .btn-group-custom .btn-delete,
                    .btn-group-custom .btn-cancel {
                        width: 100%;
                        flex: 1 1 auto;
                    }
            }

            @@media (max-width: 400px) {
                .card-custom {
                    border-radius: 20px;
                }

                .card-header-custom {
                    padding: 0.85rem 1rem;
                }

                .card-body-custom {
                    padding: 1rem 1rem 1.25rem;
                }

                .detail-list {
                    padding: 0.4rem 0.6rem;
                }

                    .detail-list dt {
                        font-size: 0.65rem;
                    }

                    .detail-list dd {
                        font-size: 0.82rem;
                    }
            }

            /* ── Reduced Motion ── */
            @@media (prefers-reduced-motion: reduce) {
                *,
                *::before,
                *::after {
                    animation-duration: 0.01ms !important;
                    animation-iteration-count: 1 !important;
                    transition-duration: 0.01ms !important;
                }
            }
    </style>
</head>

<body>

    <div class="form-wrapper">

        <div class="card-custom">

            <!-- Card Header (Danger) -->
            <div class="card-header-custom">
                <span class="header-icon">
                    <i class="bi bi-trash"></i>
                </span>
                Delete Supplier
            </div>

            <!-- Card Body -->
            <div class="card-body-custom">

                <!-- Supplier Details -->
                <div class="detail-list">
                    <div class="row">
                        <dt class="col-5">Supplier ID</dt>
                        <dd class="col-7">#@Model.SuppId</dd>
                    </div>
                    <div class="row">
                        <dt class="col-5">Supplier Name</dt>
                        <dd class="col-7 supp-name-highlight">@Model.SuppName</dd>
                    </div>
                    <div class="row">
                        <dt class="col-5">Phone</dt>
                        <dd class="col-7">@(Model.SuppPhone ?? "-")</dd>
                    </div>
                    <div class="row">
                        <dt class="col-5">Email</dt>
                        <dd class="col-7">@(Model.SuppEmail ?? "-")</dd>
                    </div>
                    <div class="row">
                        <dt class="col-5">GST No.</dt>
                        <dd class="col-7">@(Model.GstNo ?? "-")</dd>
                    </div>
                    <div class="row">
                        <dt class="col-5">Balance</dt>
                        <dd class="col-7">
                            <span class="balance-value @(Model.SuppBal > 0 ? "negative" : "positive")">
                                ₹@Model.SuppBal.ToString("N2")
                            </span>
                            @if (Model.SuppBal > 0)
                            {
                                <span class="badge-outstanding">Outstanding</span>
                            }
                        </dd>
                    </div>
                </div>

                <!-- Delete Form -->
                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="SuppId" />

                    <div class="btn-group-custom">
                        <button type="submit" class="btn-delete">
                            <i class="bi bi-trash"></i>
                            Yes, Delete
                        </button>
                        <!-- ✅ FIXED: Cancel now goes to Index instead of Details -->
                        <a asp-action="Index" class="btn-cancel">
                            Cancel
                        </a>
                    </div>
                </form>

            </div>
            <!-- /card-body -->

        </div>
        <!-- /card-custom -->

    </div>
    <!-- /form-wrapper -->

</body>
</html>