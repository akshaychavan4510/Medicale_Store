@* Views/Supplier/Edit.cshtml *@
@model MedicalStore.Business.ViewModels.SupplierVM

@{
    ViewData["Title"] = "Edit Supplier";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

    <style>
            /* ── Reset & Base ── */
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
                background: linear-gradient(145deg, #f6f9fc 0%, #e9eef4 100%);
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 1.5rem;
                margin: 0;
            }

            /* ── Form Container ── */
            .form-wrapper {
                width: 100%;
                max-width: 640px;
                margin: 0 auto;
                animation: fadeSlideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1);
            }

            @@keyframes fadeSlideUp {
                0% {
                    opacity: 0;
                    transform: translateY(30px) scale(0.97);
                }

                100% {
                    opacity: 1;
                    transform: translateY(0) scale(1);
                }
            }

            /* ── Card ── */
            .card-custom {
                background: #ffffff;
                border: none;
                border-radius: 28px;
                box-shadow: 0 20px 60px rgba(0, 0, 0, 0.08), 0 8px 28px rgba(0, 0, 0, 0.04), 0 0 0 1px rgba(0, 0, 0, 0.02);
                transition: box-shadow 0.3s ease, transform 0.2s ease;
                overflow: hidden;
            }

                .card-custom:hover {
                    box-shadow: 0 32px 80px rgba(0, 0, 0, 0.12), 0 12px 36px rgba(0, 0, 0, 0.06), 0 0 0 1px rgba(0, 0, 0, 0.02);
                    transform: translateY(-2px);
                }

            /* ── Card Header ── */
            .card-header-custom {
                background: #ffffff;
                border-bottom: 1px solid #f0f3f9;
                padding: 1.25rem 1.75rem;
                font-weight: 700;
                font-size: 1.15rem;
                letter-spacing: -0.01em;
                color: #0b1a33;
                display: flex;
                align-items: center;
                gap: 0.6rem;
            }

                .card-header-custom i {
                    font-size: 1.4rem;
                    color: #3d7eb9;
                }

            /* ── Card Body ── */
            .card-body-custom {
                padding: 1.75rem 1.75rem 2rem;
            }

            /* ── Form Labels ── */
            .form-label-custom {
                font-weight: 600;
                font-size: 0.82rem;
                text-transform: uppercase;
                letter-spacing: 0.04em;
                color: #2d405b;
                margin-bottom: 0.4rem;
            }

                .form-label-custom .required-star {
                    color: #c62828;
                    font-weight: 700;
                    margin-left: 0.15rem;
                }

            /* ── Form Controls ── */
            .form-control-custom,
            .form-select-custom {
                border: 1.5px solid #e2e8f0;
                border-radius: 14px;
                padding: 0.7rem 1rem;
                font-size: 0.95rem;
                font-weight: 500;
                color: #0b1a33;
                background: #fafcff;
                transition: all 0.2s ease;
                box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.02);
                width: 100%;
            }

                .form-control-custom:focus,
                .form-select-custom:focus {
                    border-color: #3d7eb9;
                    background: #ffffff;
                    box-shadow: 0 0 0 4px rgba(61, 126, 185, 0.12), inset 0 1px 3px rgba(0, 0, 0, 0.02);
                    outline: none;
                }

                .form-control-custom::placeholder {
                    color: #b0bed0;
                    font-weight: 400;
                    font-size: 0.9rem;
                }

                /* ── Readonly Field ── */
                .form-control-custom[readonly] {
                    background: #f4f7fc;
                    color: #4a5d7a;
                    cursor: not-allowed;
                    opacity: 0.85;
                }

                    .form-control-custom[readonly]:focus {
                        border-color: #dce3ef;
                        box-shadow: none;
                    }

            /* ── Textarea ── */
            textarea.form-control-custom {
                resize: vertical;
                min-height: 60px;
            }

            /* ── Input Group ── */
            .input-group-custom .input-group-text {
                background: #f0f3f9;
                border: 1.5px solid #e2e8f0;
                border-radius: 14px 0 0 14px;
                color: #5a6e8a;
                font-size: 0.95rem;
                padding: 0.7rem 1rem;
                transition: all 0.2s ease;
            }

            .input-group-custom .form-control-custom {
                border-radius: 0 14px 14px 0;
                border-left: none;
            }

                .input-group-custom .form-control-custom:focus {
                    border-left: none;
                }

            .input-group-custom:focus-within .input-group-text {
                border-color: #3d7eb9;
                background: #eef3fc;
            }

            .input-group-custom:focus-within .form-control-custom {
                border-color: #3d7eb9;
            }

            /* ── Validation Messages ── */
            .text-danger {
                font-size: 0.78rem;
                font-weight: 500;
                margin-top: 0.3rem;
                display: block;
            }

            .alert-custom {
                border-radius: 14px;
                border: none;
                background: #fef2f0;
                color: #b34a4a;
                padding: 0.7rem 1rem;
                font-size: 0.85rem;
                font-weight: 500;
                margin-bottom: 1.25rem;
            }

            /* ── Form Help Text ── */
            .form-text-custom {
                font-size: 0.75rem;
                color: #6b7a93;
                margin-top: 0.3rem;
            }

                .form-text-custom i {
                    margin-right: 0.25rem;
                }

            /* ── Buttons ── */
            .btn-group-custom {
                display: flex;
                flex-wrap: wrap;
                gap: 0.75rem;
                margin-top: 0.5rem;
            }

            .btn-update {
                background: #3d7eb9;
                border: none;
                border-radius: 60px;
                padding: 0.65rem 2rem;
                font-weight: 600;
                font-size: 0.9rem;
                color: #fff;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 0.5rem;
                transition: all 0.25s ease;
                box-shadow: 0 6px 18px rgba(61, 126, 185, 0.30);
                flex: 1 1 auto;
                min-width: 150px;
            }

                .btn-update:hover {
                    background: #3269a0;
                    transform: translateY(-2px);
                    box-shadow: 0 10px 28px rgba(61, 126, 185, 0.35);
                    color: #fff;
                }

                .btn-update:active {
                    transform: translateY(0px);
                    box-shadow: 0 4px 12px rgba(61, 126, 185, 0.25);
                }

            .btn-cancel {
                background: transparent;
                border: 1.5px solid #dce3ef;
                border-radius: 60px;
                padding: 0.65rem 1.8rem;
                font-weight: 600;
                font-size: 0.9rem;
                color: #4a5d7a;
                transition: all 0.2s ease;
                flex: 1 1 auto;
                min-width: 100px;
                text-decoration: none;
                text-align: center;
                display: inline-flex;
                align-items: center;
                justify-content: center;
            }

                .btn-cancel:hover {
                    background: #f4f7fd;
                    border-color: #b6c8e0;
                    color: #1f3a5f;
                    text-decoration: none;
                }

            /* ── Hidden Input ── */
            input[type="hidden"] {
                display: none;
            }

            /* ── Responsive ── */
            @@media (max-width: 576px) {
                body {
                    padding: 1rem;
                    align-items: flex-start;
                    padding-top: 2rem;
                }

                .card-header-custom {
                    padding: 1rem 1.25rem;
                    font-size: 1rem;
                }

                    .card-header-custom i {
                        font-size: 1.2rem;
                    }

                .card-body-custom {
                    padding: 1.25rem 1.25rem 1.5rem;
                }

                .form-control-custom,
                .form-select-custom {
                    padding: 0.6rem 0.9rem;
                    font-size: 0.9rem;
                    border-radius: 12px;
                }

                .input-group-custom .input-group-text {
                    padding: 0.6rem 0.9rem;
                    font-size: 0.85rem;
                    border-radius: 12px 0 0 12px;
                }

                .input-group-custom .form-control-custom {
                    border-radius: 0 12px 12px 0;
                }

                .btn-update,
                .btn-cancel {
                    font-size: 0.85rem;
                    padding: 0.55rem 1.2rem;
                    min-width: 80px;
                }

                .btn-group-custom {
                    flex-direction: column;
                    gap: 0.6rem;
                }

                    .btn-group-custom .btn-update,
                    .btn-group-custom .btn-cancel {
                        width: 100%;
                        flex: 1 1 auto;
                    }

                .row.g-3 > [class*="col-"] {
                    padding-left: 0;
                    padding-right: 0;
                }

                .row.g-3 {
                    --bs-gutter-x: 0.75rem;
                }
            }

            @@media (max-width: 400px) {
                .card-custom {
                    border-radius: 20px;
                }

                .card-header-custom {
                    padding: 0.85rem 1rem;
                }

                .card-body-custom {
                    padding: 1rem 1rem 1.25rem;
                }

                .form-text-custom {
                    font-size: 0.7rem;
                }
            }

            /* ── Reduced Motion ── */
            @@media (prefers-reduced-motion: reduce) {
                *,
                *::before,
                *::after {
                    animation-duration: 0.01ms !important;
                    animation-iteration-count: 1 !important;
                    transition-duration: 0.01ms !important;
                }
            }
    </style>
</head>

<body>

    <div class="form-wrapper">

        <div class="card-custom">

            <!-- Card Header -->
            <div class="card-header-custom">
                <i class="bi bi-pencil"></i>
                Edit Supplier
            </div>

            <!-- Card Body -->
            <div class="card-body-custom">

                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()

                    <!-- Hidden ID -->
                    <input type="hidden" asp-for="SuppId" />

                    <!-- Validation Summary -->
                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-custom py-2 small">
                    </div>

                    <div class="row g-3">

                        <!-- Supplier Name -->
                        <div class="col-12">
                            <label asp-for="SuppName" class="form-label-custom form-label">
                                Supplier Name <span class="required-star">*</span>
                            </label>
                            <input asp-for="SuppName"
                                   class="form-control form-control-custom"
                                   placeholder="Supplier / Company Name"
                                   autofocus />
                            <span asp-validation-for="SuppName" class="text-danger"></span>
                        </div>

                        <!-- Phone -->
                        <div class="col-md-6">
                            <label asp-for="SuppPhone" class="form-label-custom form-label">Phone</label>
                            <div class="input-group input-group-custom">
                                <span class="input-group-text">
                                    <i class="bi bi-telephone"></i>
                                </span>
                                <input asp-for="SuppPhone"
                                       class="form-control form-control-custom"
                                       placeholder="Contact number" />
                            </div>
                            <span asp-validation-for="SuppPhone" class="text-danger"></span>
                        </div>

                        <!-- Email -->
                        <div class="col-md-6">
                            <label asp-for="SuppEmail" class="form-label-custom form-label">Email</label>
                            <div class="input-group input-group-custom">
                                <span class="input-group-text">
                                    <i class="bi bi-envelope"></i>
                                </span>
                                <input asp-for="SuppEmail"
                                       class="form-control form-control-custom"
                                       placeholder="email@supplier.com" />
                            </div>
                            <span asp-validation-for="SuppEmail" class="text-danger"></span>
                        </div>

                        <!-- Address -->
                        <div class="col-12">
                            <label asp-for="SuppAddress" class="form-label-custom form-label">Address</label>
                            <textarea asp-for="SuppAddress"
                                      class="form-control form-control-custom"
                                      rows="2"
                                      placeholder="Full address"></textarea>
                            <span asp-validation-for="SuppAddress" class="text-danger"></span>
                        </div>

                        <!-- GST No. -->
                        <div class="col-12">
                            <label asp-for="GstNo" class="form-label-custom form-label">GST No.</label>
                            <input asp-for="GstNo"
                                   class="form-control form-control-custom"
                                   placeholder="e.g. 27AABCU9603R1ZN" />
                            <span asp-validation-for="GstNo" class="text-danger"></span>
                        </div>

                        <!-- Outstanding Balance (Read-only) -->
                        <div class="col-12">
                            <label asp-for="SuppBal" class="form-label-custom form-label">Outstanding Balance (₹)</label>
                            <div class="input-group input-group-custom">
                                <span class="input-group-text">₹</span>
                                <input asp-for="SuppBal"
                                       class="form-control form-control-custom"
                                       readonly />
                            </div>
                            <div class="form-text-custom">
                                <i class="bi bi-info-circle"></i>
                                Balance is system-managed via purchases &amp; payments.
                            </div>
                            <span asp-validation-for="SuppBal" class="text-danger"></span>
                        </div>

                    </div>
                    <!-- /row -->
                    <!-- Buttons -->
                    <div class="btn-group-custom">
                        <button type="submit" class="btn-update">
                            <i class="bi bi-check-lg"></i>
                            Update Supplier
                        </button>
                        <!-- ✅ FIXED: Cancel now goes to Index instead of Details -->
                        <a asp-action="Index" class="btn-cancel">
                            Cancel
                        </a>
                    </div>

                </form>

            </div>
            <!-- /card-body -->

        </div>
        <!-- /card-custom -->

    </div>
    <!-- /form-wrapper -->
    <!-- Validation Scripts -->
    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
    }

</body>
</html>