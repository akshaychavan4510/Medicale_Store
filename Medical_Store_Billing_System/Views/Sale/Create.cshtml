@model MedicalStore.Business.ViewModels.SaleMasterVM
@{
    ViewData["Title"] = "New Sale";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <style>
        /* ── Reset & Base ── */
        * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        }

        body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background: linear-gradient(145deg, #f0f5fc 0%, #e3eaf5 100%);
        min-height: 100vh;
        padding: 1.5rem;
        margin: 0;
        }

        /* ── Main Container ── */
        .page-wrapper {
        max-width: 1280px;
        margin: 0 auto;
        animation: fadeSlideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }

        @@keyframes fadeSlideUp {
        0% {
        opacity: 0;
        transform: translateY(30px) scale(0.97);
        }

        100% {
        opacity: 1;
        transform: translateY(0) scale(1);
        }
        }

        /* ── Cards & Shadows ── */
        .card-modern {
        background: #ffffff;
        border: none;
        border-radius: 24px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.06), 0 8px 28px rgba(0, 0, 0, 0.03), 0 0 0 1px rgba(0, 0, 0, 0.02);
        transition: box-shadow 0.3s ease, transform 0.2s ease;
        overflow: hidden;
        }

        .card-modern:hover {
        box-shadow: 0 32px 80px rgba(0, 0, 0, 0.08), 0 12px 36px rgba(0, 0, 0, 0.04), 0 0 0 1px rgba(0, 0, 0, 0.02);
        transform: translateY(-2px);
        }

        .card-header-custom {
        background: transparent;
        border-bottom: 1px solid #f0f3f9;
        padding: 1rem 1.5rem;
        font-weight: 600;
        font-size: 1rem;
        color: #1f3a5f;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        }

        .card-body-custom {
        padding: 1.5rem;
        }

        /* ── Form Controls ── */
        .form-control, .form-select {
        border: 1.5px solid #e2e8f0;
        border-radius: 14px;
        padding: 0.6rem 1rem;
        font-size: 0.9rem;
        font-weight: 500;
        color: #0b1a33;
        background: #fafcff;
        transition: all 0.2s ease;
        box-shadow: inset 0 1px 3px rgba(0,0,0,0.02);
        }

        .form-control:focus, .form-select:focus {
        border-color: #2e7d32;
        background: #ffffff;
        box-shadow: 0 0 0 4px rgba(46, 125, 50, 0.12), inset 0 1px 3px rgba(0,0,0,0.02);
        outline: none;
        }

        .form-control[readonly], .form-control.bg-light {
        background: #f4f7fc;
        color: #2d405b;
        }

        .form-label-custom {
        font-weight: 600;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: #4a5d7a;
        margin-bottom: 0.25rem;
        }

        .form-label-custom .required-star {
        color: #c62828;
        margin-left: 0.15rem;
        }

        /* ── Table ── */
        .table-wrapper {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        margin: 0 -0.5rem;
        }

        #detailsTable {
        min-width: 700px;
        font-size: 0.9rem;
        border-collapse: separate;
        border-spacing: 0 4px;
        margin-bottom: 0;
        }

        #detailsTable thead th {
        background: #f8faff;
        border: none;
        font-weight: 600;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: #4a5d7a;
        padding: 0.6rem 0.5rem;
        white-space: nowrap;
        border-bottom: 2px solid #e2e8f0;
        }

        #detailsTable tbody tr {
        background: #ffffff;
        transition: background 0.15s;
        box-shadow: 0 1px 4px rgba(0,0,0,0.02);
        }

        #detailsTable tbody tr:hover {
        background: #f8fbff;
        }

        #detailsTable tbody td {
        padding: 0.4rem 0.5rem;
        vertical-align: middle;
        border: none;
        border-bottom: 1px solid #f0f3f9;
        }

        #detailsTable tbody tr:last-child td {
        border-bottom: none;
        }

        #detailsTable tfoot td {
        padding: 0.6rem 0.5rem;
        border: none;
        border-top: 2px solid #e2e8f0;
        font-weight: 600;
        }

        .table-purchase .form-control-sm {
        border-radius: 10px;
        padding: 0.35rem 0.6rem;
        font-size: 0.85rem;
        }

        .table-purchase .form-select-sm {
        border-radius: 10px;
        padding: 0.35rem 0.6rem;
        font-size: 0.85rem;
        }

        /* ── Buttons ── */
        .btn-success-custom {
        background: #2e7d32;
        border: none;
        border-radius: 60px;
        padding: 0.6rem 1.8rem;
        font-weight: 600;
        font-size: 0.9rem;
        color: #fff;
        transition: all 0.25s ease;
        box-shadow: 0 6px 18px rgba(46, 125, 50, 0.30);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        }

        .btn-success-custom:hover {
        background: #1b5e20;
        transform: translateY(-2px);
        box-shadow: 0 10px 28px rgba(46, 125, 50, 0.35);
        color: #fff;
        }

        .btn-success-custom:active {
        transform: translateY(0px);
        box-shadow: 0 4px 12px rgba(46, 125, 50, 0.25);
        }

        .btn-outline-custom {
        border: 1.5px solid #dce3ef;
        border-radius: 60px;
        padding: 0.6rem 1.8rem;
        font-weight: 600;
        font-size: 0.9rem;
        color: #4a5d7a;
        transition: all 0.2s ease;
        background: transparent;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        }

        .btn-outline-custom:hover {
        background: #f4f7fd;
        border-color: #b6c8e0;
        color: #1f3a5f;
        text-decoration: none;
        }

        .btn-add {
        border-radius: 60px;
        padding: 0.4rem 1.2rem;
        font-weight: 600;
        font-size: 0.8rem;
        background: #e8f5e9;
        color: #1b5e20;
        border: 1px solid #c8e6c9;
        transition: all 0.2s ease;
        }

        .btn-add:hover {
        background: #c8e6c9;
        border-color: #81c784;
        color: #0a3d0e;
        }

        .btn-remove {
        color: #b0bccd;
        transition: color 0.2s ease;
        border: none;
        background: transparent;
        }

        .btn-remove:hover {
        color: #c62828;
        }

        /* ── Header icon ── */
        .header-icon {
        background: #e8f5e9;
        padding: 0.6rem;
        border-radius: 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        }

        .header-icon i {
        font-size: 1.6rem;
        color: #2e7d32;
        }

        /* ── Responsive ── */
        @@media (max-width: 768px) {
        body {
        padding: 1rem;
        }

        .card-body-custom {
        padding: 1rem;
        }

        .page-wrapper {
        max-width: 100%;
        }

        #detailsTable {
        min-width: 600px;
        font-size: 0.8rem;
        }

        #detailsTable thead th {
        font-size: 0.65rem;
        padding: 0.4rem 0.3rem;
        }

        #detailsTable tbody td {
        padding: 0.3rem 0.3rem;
        }

        .form-control-sm, .form-select-sm {
        font-size: 0.8rem;
        padding: 0.3rem 0.5rem;
        }

        .btn-success-custom, .btn-outline-custom {
        width: 100%;
        justify-content: center;
        }

        .d-flex.gap-2 {
        flex-direction: column;
        gap: 0.5rem;
        }

        .btn-add {
        width: 100%;
        }
        }

        @@media (max-width: 576px) {
        .row.g-3 > [class*="col-"] {
        padding-left: 0;
        padding-right: 0;
        }

        .row.g-3 {
        --bs-gutter-x: 0.5rem;
        }

        .form-label-custom {
        font-size: 0.7rem;
        }
        }

        /* ── Reduced Motion ── */
        @@media (prefers-reduced-motion: reduce) {
        * {
        animation-duration: 0.01ms !important;
        transition-duration: 0.01ms !important;
        }
        }

        /* ── Misc ── */
        .text-accent {
        color: #2e7d32;
        }

        .bg-soft-success {
        background: #e8f5e9;
        }

        .fw-500 {
        font-weight: 500;
        }

        .gap-2 {
        gap: 0.5rem;
        }

        .stock-display {
        font-size: 0.7rem;
        color: #6b7a93;
        display: block;
        margin-top: 0.15rem;
        }
    </style>
</head>

<body>

    <div class="page-wrapper">

        <!-- ── Header ── -->
        <div class="d-flex flex-wrap align-items-center gap-3 mb-4">
            <div class="header-icon">
                <i class="bi bi-cart-check"></i>
            </div>
            <div class="flex-grow-1">
                <h5 class="mb-0 fw-bold">New Sale Entry</h5>
                <small class="text-muted">Record a new sales transaction</small>
            </div>
            <a asp-action="Index" class="btn btn-outline-custom btn-sm ms-auto">
                <i class="bi bi-arrow-left me-1"></i>Back to List
            </a>
        </div>

        <!-- ── Main Card ── -->
        <div class="card-modern">
            <div class="card-header-custom">
                <i class="bi bi-pencil-square text-success"></i>
                Sale Details
            </div>
            <div class="card-body-custom">

                <form asp-action="Create" method="post" id="saleForm">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                    <!-- ── Master Fields ── -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label asp-for="SaleDate" class="form-label-custom">Sale Date</label>
                            <input asp-for="SaleDate" type="date" class="form-control"
                                   value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                            <span asp-validation-for="SaleDate" class="text-danger small"></span>
                        </div>
                        <div class="col-md-5">
                            <label asp-for="CustId" class="form-label-custom">Customer <span class="required-star">*</span></label>
                            <select asp-for="CustId" asp-items="ViewBag.Customers" class="form-select">
                                <option value="">-- Select Customer --</option>
                            </select>
                            <span asp-validation-for="CustId" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- ── Detail Lines Table ── -->
                    <div class="table-wrapper mb-3">
                        <table class="table" id="detailsTable">
                            <thead>
                                <tr>
                                    <th style="min-width:200px;">Medicine</th>
                                    <th style="min-width:90px;">Rate (₹)</th>
                                    <th style="min-width:70px;">Qty</th>
                                    <th style="min-width:90px;">Amount</th>
                                    <th style="min-width:90px;">GST (5%)</th>
                                    <th style="min-width:90px;">Total</th>
                                    <th style="width:50px;"></th>
                                </tr>
                            </thead>
                            <tbody id="detailsBody">
                                <!-- rows injected by JS -->
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="5" class="text-end fw-semibold">Grand Total</td>
                                    <td class="fw-bold text-success fs-5">
                                        ₹<span id="grandTotalDisplay">0.00</span>
                                    </td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <!-- Hidden grand total sent to server -->
                    <input type="hidden" name="GrandTotal" id="grandTotalHidden" value="0" />

                    <!-- ── Buttons ── -->
                    <div class="d-flex flex-wrap gap-2">
                        <button type="button" class="btn btn-add" id="addRowBtn">
                            <i class="bi bi-plus-circle me-1"></i>Add Medicine
                        </button>
                        <button type="submit" class="btn btn-success-custom px-4">
                            <i class="bi bi-check-lg me-1"></i>Save Sale
                        </button>
                        <a asp-action="Index" class="btn btn-outline-custom">Cancel</a>
                    </div>

                </form>

            </div>
        </div>

    </div>

    <!-- ── Row Template ── -->
    <template id="rowTemplate">
        <tr>
            <td>
                <select name="SaleDetails[__IDX__].MedId"
                        class="form-select form-select-sm med-select" required>
                    <option value="">-- Select Medicine --</option>
                    @foreach (var m in (ViewBag.Medicines as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
                                       ?? new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>()))
                    {
                        <option value="@m.Value">@m.Text</option>
                    }
                </select>
                <span class="stock-display"></span>
            </td>
            <td>
                <input type="number"
                       name="SaleDetails[__IDX__].Rate"
                       class="form-control form-control-sm rate-input"
                       step="0.01" min="0" value="0" readonly />
            </td>
            <td>
                <input type="number"
                       name="SaleDetails[__IDX__].Qty"
                       class="form-control form-control-sm qty-input"
                       min="1" step="1" value="1" required />
            </td>
            <td>
                <input type="number"
                       name="SaleDetails[__IDX__].Amt"
                       class="form-control form-control-sm amt-input"
                       step="0.01" value="0" readonly />
            </td>
            <td>
                <input type="number"
                       name="SaleDetails[__IDX__].GstAmt"
                       class="form-control form-control-sm gst-input"
                       step="0.01" value="0" readonly />
                <input type="hidden"
                       name="SaleDetails[__IDX__].GstPct"
                       class="gstpct-input"
                       value="5" />
            </td>
            <td>
                <input type="number"
                       name="SaleDetails[__IDX__].Total"
                       class="form-control form-control-sm total-input"
                       step="0.01" value="0" readonly />
            </td>
            <td>
                <button type="button" class="btn btn-sm btn-remove" title="Remove">
                    <i class="bi bi-x-lg"></i>
                </button>
            </td>
        </tr>
    </template>

    <!-- ── Script ── -->
    <script>
        (function () {
        "use strict";

        const GST_PCT = 5;
        let rowIndex = 0;

        function round2(n) { return Math.round(n * 100) / 100; }

        function recalcRow(row) {
        const rate = parseFloat(row.querySelector(".rate-input").value) || 0;
        const qty = parseFloat(row.querySelector(".qty-input").value) || 0;

        const amt = round2(rate * qty);
        const gstAmt = round2(amt * GST_PCT / 100);
        const total = round2(amt + gstAmt);

        row.querySelector(".amt-input").value = amt.toFixed(2);
        row.querySelector(".gst-input").value = gstAmt.toFixed(2);
        row.querySelector(".total-input").value = total.toFixed(2);

        const gstPctInput = row.querySelector(".gstpct-input");
        if (gstPctInput) gstPctInput.value = GST_PCT;

        recalcGrandTotal();
        }

        function recalcGrandTotal() {
        let grand = 0;
        document.querySelectorAll("#detailsBody .total-input").forEach(function (el) {
        grand += parseFloat(el.value) || 0;
        });
        grand = round2(grand);
        document.getElementById("grandTotalDisplay").textContent = grand.toFixed(2);
        document.getElementById("grandTotalHidden").value = grand.toFixed(2);
        }

        function reindexRows() {
        document.querySelectorAll("#detailsBody tr").forEach(function (row, i) {
        row.querySelectorAll("[name]").forEach(function (el) {
        el.name = el.name.replace(/SaleDetails\[\d+\]/, "SaleDetails[" + i + "]");
        });
        });
        rowIndex = document.querySelectorAll("#detailsBody tr").length;
        }

        function buildRow(idx) {
        const template = document.getElementById("rowTemplate");
        const html = template.innerHTML.replace(/__IDX__/g, idx);
        const wrapper = document.createElement("tbody");
        wrapper.innerHTML = html;
        const row = wrapper.firstElementChild;

        // ── medicine select change ──
        row.querySelector(".med-select").addEventListener("change", async function () {
        const medId = this.value;
        if (!medId) {
        row.querySelector(".rate-input").value = "";
        const stockEl = row.querySelector(".stock-display");
        if (stockEl) stockEl.textContent = "";
        recalcRow(row);
        return;
        }

        try {
        const resp = await fetch("/Sale/GetMedicineInfo?id=" + medId);
        if (!resp.ok) throw new Error("Not found");
        const data = await resp.json();

        row.querySelector(".rate-input").value = parseFloat(data.rate).toFixed(2);
        row.dataset.stock = data.stock;

        const stockEl = row.querySelector(".stock-display");
        if (stockEl) stockEl.textContent = "Stock: " + data.stock;

        } catch (e) {
        alert("Could not fetch medicine info. Please try again.");
        }

        recalcRow(row);
        });

        // ── qty / rate change ──
        row.querySelector(".qty-input").addEventListener("input", function () { recalcRow(row); });
        row.querySelector(".rate-input").addEventListener("input", function () { recalcRow(row); });

        // ── remove row (FIXED: using .btn-remove, not .remove-row) ──
        row.querySelector(".btn-remove").addEventListener("click", function () {
        row.remove();
        reindexRows();
        recalcGrandTotal();
        });

        return row;
        }

        // ── Add row ──
        document.getElementById("addRowBtn").addEventListener("click", function () {
        const row = buildRow(rowIndex++);
        document.getElementById("detailsBody").appendChild(row);
        });

        // ── Form submit validation ──
        document.getElementById("saleForm").addEventListener("submit", function (e) {
        const rows = document.querySelectorAll("#detailsBody tr");

        if (rows.length === 0) {
        e.preventDefault();
        alert("Please add at least one medicine row before saving.");
        return;
        }

        let valid = true;
        rows.forEach(function (row) {
        const medSel = row.querySelector(".med-select");
        const qtyInput = row.querySelector(".qty-input");
        const stock = parseFloat(row.dataset.stock || "99999");
        const qty = parseFloat(qtyInput.value) || 0;

        if (!medSel.value) {
        alert("Please select a medicine in every row.");
        valid = false;
        return;
        }
        if (qty <= 0) {
        alert("Quantity must be greater than zero.");
        valid = false;
        return;
        }
        if (qty > stock) {
        alert("Quantity (" + qty + ") exceeds available stock (" + stock + ") for " +
        medSel.options[medSel.selectedIndex].text + ".");
        valid = false;
        return;
        }
        });

        if (!valid) { e.preventDefault(); return; }

        recalcGrandTotal();
        });

        })();
    </script>

</body>
</html>